{%- comment -%}
  TBG custom code
  Global styles for snippets/product-card-battlegear.liquid, now rendered
  site-wide through snippets/product-card.liquid. Values mirror the
  products-age-toggle section's saved card settings; that section's own
  `.section-<id>` rules are more specific, so its settings still win there.
{%- endcomment -%}
{% style %}
  .bg-card{
    --gsc-bg-card-accent: #d4ff32;
    --gsc-bg-card-muted: #8b949e;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #1f232a;
  }

  .bg-card__media-wrap{
    position: relative;
    overflow: hidden;
  }

  .bg-card__media-link{
    display: block;
  }

  .bg-card__media{
    position: relative;
    aspect-ratio: 1 / 1;
    /* TBG custom code - enlarge + nudge image on every product card */
    scale: 1.3;
    transform: translateY(10px);
  }

  .bg-card__image{
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .bg-card--zoom .bg-card__image{
    transition: transform 0.4s ease;
  }

  .bg-card--zoom:hover .bg-card__image{
    transform: scale(1.06);
  }

  .bg-card--sold-out .bg-card__media{
    opacity: 0.5;
  }

  .bg-card__badges{
    position: absolute;
    top: 4px;
    left: 4px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }

  .bg-card__badge{
    padding: 4px 10px;
    color: #000;
    background: var(--gsc-bg-card-accent);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .bg-card__badge--label{
    border: 1px solid transparent;
    color: transparent;
    background: transparent;
  }

  .bg-card__badge--sale{
    color: #000;
    background: var(--gsc-bg-card-accent);
  }

  .bg-card__badge--sold-out{
    color: #fff;
    background: var(--gsc-bg-card-muted);
  }

  .bg-card__content{
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 14px;
    color: #ffffff;
    text-decoration: none;
  }

  .bg-card__pill{
    display: flex;
    align-items: stretch;
    width: fit-content;
    max-width: 100%;
  }

  .bg-card__pill-main,
  .bg-card__pill-gen{
    padding: 0 7px;
    border: 1px solid #dcdcdc;
    font-size: 10px; /* TBG custom code - site-wide pill size (desktop) */
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1.3;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .bg-card__pill-main{
    color: #404040;
    background: #dcdcdc;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bg-card__pill-gen{
    color: #dcdcdc;
    background: transparent;
  }

  .bg-card__title{
    margin: 0;
    color: inherit;
    /* TBG custom code - default title font: body font (Rajdhani) */
    font-family: var(--gsc-body-font-family);
    font-size: 20px; /* TBG custom code - site-wide type size (desktop) */
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .bg-card__color{
    color: var(--gsc-bg-card-muted);
    font-size: 18px; /* TBG custom code - site-wide colour/style size (desktop) */
    letter-spacing: 0.02em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .bg-card__price{
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 16px; /* TBG custom code - site-wide price size (desktop) */
    font-weight: 700;
  }

  .bg-card__price-current{
    color: #ffffff;
  }

  .bg-card__price--on-sale .bg-card__price-current{
    color: var(--gsc-bg-card-accent);
  }

  .bg-card__price-compare{
    color: var(--gsc-bg-card-muted);
    font-weight: 400;
    text-decoration: line-through;
  }

  @media (max-width: 767px){
    .bg-card__title{
      font-size: 24px; /* TBG custom code - mobile type size */
    }
    .bg-card__pill-main,
    .bg-card__pill-gen{
      padding: 1px 4px;
      font-size: 12px; /* TBG custom code - mobile pill size */
      letter-spacing: 0;
    }
    .bg-card__pill-main{
      white-space: normal;
      overflow: visible;
      text-overflow: clip;
    }
    .bg-card__pill-gen{
      flex-shrink: 0;
    }
    /* TBG custom code - mobile colour/style + price sizes */
    .bg-card__color{
      font-size: 22px;
    }
    .bg-card__price{
      font-size: 18px;
    }
  }
{% endstyle %}
