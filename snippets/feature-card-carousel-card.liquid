{%- comment -%}
  TBG custom Code
  Renders a single "Feature card carousel" card.

  The image fills the card. A single panel is anchored to the bottom of the
  card, on top of the image. Collapsed, the panel is exactly as tall as its
  own header row, so only the icon/title/toggle show. Expanded, it grows
  upward to the full card height, covering the image and revealing the body
  copy and the metric.

  Accepts:
  - block {Object} - section block holding the card settings
  - card_index {Number} - 1-based card index, used for the toggle wiring
  - section_id {String} - id of the owning section
  - card_title_size {String} - heading size class for the panel header title
  - panel_text_size {String} - body size class for the expanded panel text
  - metric_size {String} - heading size class for the metric value
  - metric_label_size {String} - body size class for the metric label
{%- endcomment -%}

{%- liquid
  assign loading = 'lazy'
  if card_index <= 3
    assign loading = 'eager'
  endif
 
  assign has_panel = false
  if block.settings.panel_text != blank or block.settings.metric_value != blank
    assign has_panel = true
  endif

  assign icon_alt = block.settings.card_title | strip_html | escape
-%}

<div
  class='fcc__card{% if has_panel %} fcc__card--expandable{% endif %}'
  data-fcc-card
  data-index='{{ card_index }}'
  {{ block.shopify_attributes }}
>
  {%- comment -%}TBG custom Code — full-bleed media, stays put while the panel grows over it{%- endcomment -%}
  <div class='fcc__media'>
    {%- if block.settings.image != blank -%}
      {{
        block.settings.image
        | image_url: width: 1200
        | image_tag:
          loading: loading,
          widths: '240, 360, 480, 720, 960, 1200',
          sizes: '(min-width: 768px) 25vw, 70vw',
          class: 'fcc__image',
          alt: block.settings.image_alt
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg fcc__image' }}
    {%- endif -%}
  </div>

  {%- comment -%}
    TBG custom Code — bottom-anchored overlay panel. Its collapsed height is
    driven by the header row it measures itself against, so the header sits
    flush with the bottom of the card until it is opened.
  {%- endcomment -%}
  <div
    class='fcc__panel'
    id='fcc-panel-{{ section_id }}-{{ card_index }}'
    data-fcc-panel
  >
    <div class='fcc__panel-head' data-fcc-head>
      {%- if block.settings.icon_image != blank -%}
        <span class='fcc__icon'>
          {{
            block.settings.icon_image
            | image_url: width: 240
            | image_tag: loading: loading, widths: '48, 96, 144, 240', alt: icon_alt
          }}
        </span>
      {%- elsif block.settings.icon != 'none' -%}
        <span class='fcc__icon'>
          {% render 'icon', icon_name: block.settings.icon %}
        </span>
      {%- endif -%}

      {%- if block.settings.card_title != blank -%}
        <div class='fcc__title {{ card_title_size }}'>
          {{ block.settings.card_title }}
        </div>
      {%- endif -%}

      {%- if has_panel -%}
        <button
          type='button'
          class='fcc__toggle'
          data-fcc-toggle
          aria-expanded='false'
          aria-controls='fcc-panel-{{ section_id }}-{{ card_index }}'
        >
          <span class='visually-hidden'>{{ block.settings.card_title | strip_html | escape }}</span>
          <span class='fcc__toggle-mark' aria-hidden='true'></span>
        </button>
      {%- endif -%}
    </div>

    {%- if has_panel -%}
      <div class='fcc__panel-body'>
        {%- if block.settings.panel_text != blank -%}
          <div class='fcc__panel-text rte {{ panel_text_size }} body-font-weight-from-global-settings'>
            {{ block.settings.panel_text }}
          </div>
        {%- endif -%}

        {%- if block.settings.metric_value != blank or block.settings.metric_label != blank -%}
          {%- comment -%}TBG custom Code — metric pinned to the bottom of the open panel{%- endcomment -%}
          <div class='fcc__metric'>
            {%- if block.settings.metric_value != blank -%}
              <div class='fcc__metric-value {{ metric_size }}'>{{ block.settings.metric_value }}</div>
            {%- endif -%}

            {%- if block.settings.metric_label != blank -%}
              <div class='fcc__metric-label {{ metric_label_size }}'>{{ block.settings.metric_label }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>
