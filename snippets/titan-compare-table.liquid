    aria-hidden="true"
    focusable="false"
  >
    <path d="M2.35,8.88L.06,5.6c-.14-.19-.02-.49.18-.49h3.12l1.58,2.26L10.47,0h3.12c.21,0,.32.3.18.49l-7.01,9.49h0,0s-1.34,1.93-1.34,1.93c-.25.36-.71.36-.97,0l-1.34-1.92h0s0,0,0,0l-.77-1.1Z"></path>
  </svg>
{% endcapture %}

{% capture cross_icon %}
  <img
    width="20"
    height="20"
    src="{{ cross_icon_src }}"
    alt="No"
    loading="lazy"
  >
{% endcapture %}

