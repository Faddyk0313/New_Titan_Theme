<script>
  (() => {
    const wrapper = document.currentScript.previousElementSibling;
    const strip = wrapper.querySelector('.compare-table__competitors');
    const dots = wrapper.querySelector('.{{ scope }}-dots');
    if (!strip || !dots) return;

    let pages = 0;

    const step = () => {
      const first = strip.querySelector('.competitor');
      return first ? first.getBoundingClientRect().width : strip.clientWidth;
    };

    const build = () => {
      // One dot per single-column scroll position: the start plus every column
      // that is hidden past the right edge.
      const hidden = strip.scrollWidth - strip.clientWidth;
      const count = hidden > 1 ? Math.round(hidden / step()) + 1 : 1;
      if (count === pages) return;
      pages = count;
      dots.innerHTML = '';
      for (let i = 0; i < count; i++) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.setAttribute('role', 'tab');
        dot.setAttribute('aria-label', 'Go to column group ' + (i + 1));
        dot.addEventListener('click', () => {
          strip.scrollTo({ left: i * step(), behavior: 'smooth' });
        });
        dots.appendChild(dot);
      }
      sync();
    };

    const sync = () => {
      const index = Math.min(pages - 1, Math.round(strip.scrollLeft / step()));
      dots.querySelectorAll('button').forEach((dot, i) => {
        dot.setAttribute('aria-current', i === index ? 'true' : 'false');
      });
    };

    strip.addEventListener('scroll', sync, { passive: true });
    new ResizeObserver(build).observe(strip);
    build();
  })();
</script>
