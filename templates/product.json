":"#d7fd52","container_size":"page-width","round_level":"default","color_scheme_variant":"default","color_scheme":"","show_background":false,"add_desktop_side_paddings":true,"add_mobile_side_paddings":true,"section_spacing_top":"m","section_spacing_bottom":"s","disable_lazy_loading":false}},"product_recommendations_CatPKf":{"type":"product-recommendations","name":"t:sections.product_recommendations.name","settings":{"product_recommendations_type":"auto","featured_collection":"","featured_products":[],"desktop_layout":"carousel","mobile_layout":"carousel","cards_to_show":10,"desktop_columns":4,"mobile_columns":"2","space_between_cards":"m","space_between_cards_mobile":"m","title":"You may also like","heading_size":"h3","alignment":"left","img_ratio":"default","img_ratio_resize":"fill","product_card_align":"left","autoplay_mode":"disabled","autoplay_interval":3,"show_navigation_on_hover":true,"container_size":"page-width","round_level":"default","color_scheme_variant":"own","color_scheme":"3","show_background":false,"add_desktop_side_paddings":false,"add_mobile_side_paddings":false,"section_spacing_top":"none","section_spacing_bottom":"none"}},"faq_kkBGXK":{"type":"faq","blocks":{"question_UXEh9J":{"type":"question","settings":{"title":"What's the Difference Between 3.0 and 2.0 BattleGear?","heading_size":"caption2","icon_type":"none","icon":"settings","icon_size":24,"text":"<p>Titan BattleGear 3.0 features the new Titanotex™ Aero, our third generation of cut-resistant material. Titanotex™ Aero is 75% lighter than gen 2 Titanotex™, and stretches 25% more, to make sliding the baselayer over your head easier than ever. Lastly, the wrist protection is now a level A9, and provides an extra inch of coverage up the forearm.<\/p>","page":"","body_size":"body3","media_type":"image","image_width":100}},"question_CAe4Xq":{"type":"question","settings":{"title":"What Makes Titan Battlegear The Safest?","heading_size":"caption2","icon_type":"none","icon":"settings","icon_size":24,"text":"<p>Titan Battlegear's hockey neck guard utilizes advanced American-made cut-resistant materials and a unique collar design to maximize coverage of critical zones.<\/p>","page":"","body_size":"body3","media_type":"image","image_width":100}},"question_84TAHg":{"type":"question","settings":{"title":"Other Brands Use Kevlar®, Why is Titan’s Titanotex™ Cut Resistance is Better?","heading_size":"caption2","icon_type":"none","icon":"settings","icon_size":24,"text":"<p>Most <strong>Kevlar® fabrics offer an ANSI cut resistance level A2<\/strong>, and in very rare occasions level A3 (on a scale of A1 to A9).<\/p><p><strong>Titan's hockey neck guard shirt utilizes proprietary, American made fabrics, delivering the highest cut-resistance: level A9<\/strong>, which makes it 200 stronger than steel, and almost 5 times more cut resistant than Kevlar® products.<\/p>","page":"","body_size":"body3","media_type":"image","image_width":100}},"question_rP8Arw":{"type":"question","settings":{"title":"Are there certifications for the USA Hockey mandated laceration protection?","heading_size":"caption2","icon_type":"none","icon":"settings","icon_size":24,"text":"<p>New USA Hockey rules state that for a neck guard to qualify for all players 18 and under in the United States, they must have an HECC certification.<\/p><p>Currently the only brand available at major retailers with an HECC Certification is Titan BattleGear.<\/p>","page":"","body_size":"body3","media_type":"image","image_width":100}},"question_M7WeN4":{"type":"question","settings":{"title":"How Safe Is The Shirt After Many Washes?","heading_size":"caption2","icon_type":"none","icon":"settings","icon_size":24,"text":"<p>We tested cleaning with cycles across TEN Durawash twin-tub industrial machines. This is equivalent to 50 washes in a domestic washing machine.<br\/><br\/><strong>The cut resistance level, following this washing process increased by 4%.<\/strong> Test reports from INTERTEK are available upon request.<\/p>","page":"","body_size":"body3","media_type":"image","image_width":100}},"question_KenAyE":{"type":"question","settings":{"title":"Where Are Titan's Products Produced?","heading_size":"caption2","icon_type":"none","icon":"settings","icon_size":24,"text":"<p><strong>The United States of America!<\/strong> Titan was born in Florida and produced in St. Paul, MN, and has additional factories in North Carolina, New Jersey, and New York.<br\/><br\/><strong>The mass market and other independent brands produce in China<\/strong>, with questionable labor practices and superficial cut resistance certifications.<\/p>","page":"","body_size":"body3","media_type":"image","image_width":100}},"question_Mjmxr8":{"type":"question","settings":{"title":"Can I Customize Titan's Hockey Neck Guard Shirt With My Team Logo\/Colors?","heading_size":"caption2","icon_type":"none","icon":"settings","icon_size":24,"text":"<p><strong>Yes<\/strong>, Titan's <a href=\"https:\/\/www.titanbattlegear.com\/pages\/semi-custom-registration-form\" target=\"_blank\" title=\"CUSTOM BATTLEGEAR & TEAM DISCOUNT REQUEST\">Custom BattleGear <\/a>program offers custom gear for teams, as well as personalization by player, including name, number, and even their country flag to represent their nationality!<\/p>","page":"","body_size":"body3","media_type":"image","image_width":100}}},"block_order":["question_UXEh9J","question_CAe4Xq","question_84TAHg","question_rP8Arw","question_M7WeN4","question_KenAyE","question_Mjmxr8"],"name":"t:sections.faq.name","settings":{"section_layout":"bottom-tabs","color_tabs":"content_tabs_separately","expand_first_tab":false,"title":"Frequently asked questions","heading_size":"h3","text":"","body_size":"body3","content_alignment":"center","btn_text":"","btn_url":"","btn_style":"primary","container_size":"large","round_level":"default","color_scheme_variant":"default","color_scheme":"","show_background":false,"add_desktop_side_paddings":true,"add_mobile_side_paddings":true,"section_spacing