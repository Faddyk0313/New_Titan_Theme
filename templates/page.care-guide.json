{"sections":{"page":{"type":"page","disabled":true,"settings":{"show_heading":true,"container_size":"xsmall","round_level":"default","color_scheme_variant":"default","color_scheme":"default","show_background":false,"add_desktop_side_paddings":true,"add_mobile_side_paddings":true,"section_spacing_top":"l","section_spacing_bottom":"l"}},"image_banner_jUWqNJ":{"type":"image-banner","name":"t:sections.image_banner.name","settings":{"desktop_ratio":0.1,"mobile_ratio":1.1,"desktop_media_type":"image","desktop_image":"shopify:\/\/shop_images\/careguide_banner_2026_dektop.jpg","desktop_enable_overlay":false,"desktop_overlay_opacity":25,"mobile_media_type":"image","mobile_image":"shopify:\/\/shop_images\/careguide_banner_2026_mobile.png","mobile_enable_overlay":false,"mobile_overlay_opacity":38,"caption":"","title":"<h1>CARE GUIDE<\/h1>","enable_oblique_font":false,"heading_size":"h1","text":"<p>KEEP YOUR GEAR PERFORMING AT ITS BEST<\/p>","body_size":"body3","desktop_content_position":"align-items:center;justify-content:flex-start;","desktop_content_align":"left","content_max_width":680,"mobile_content_position":"align-items:flex-end;justify-content:center;","mobile_content_align":"center","content_paddings_size":"3xl","desktop_content_background":"shadow","desktop_outline_border_thickness":1,"desktop_background_opacity":51,"desktop_background_blur":7,"desktop_shadow_background_color":"#000000f5","mobile_content_background":"none","mobile_outline_border_thickness":1,"mobile_background_opacity":20,"mobile_background_blur":12,"mobile_shadow_background_color":"#00000030","btn_text":"","btn_url":"","btn_style":"primary","extra_btn_text":"","extra_btn_url":"","extra_btn_style":"secondary","container_size":"page-width","round_level":"default","color_scheme_variant":"own","color_scheme":"8","custom_text_color":"#ffffff","custom_background_color":"#000000","custom_foreground_color":"#323232","custom_first_button_text_color":"#ffffff","custom_first_button_bg_color":"#323232","custom_first_button_border_color":"#323232","custom_second_button_text_color":"#ffffff","custom_second_button_bg_color":"#323232","custom_second_button_border_color":"#323232","custom_link_color":"#ffffff","show_background":false,"add_desktop_side_paddings":false,"add_mobile_side_paddings":false,"section_spacing_top":"none","section_spacing_bottom":"none","disable_lazy_loading":false}},"care_guide_e7gNcj":{"type":"care-guide","blocks":{"care_group_MqLGEJ":{"type":"care_group","settings":{"show_header":true,"title":"Washing","title_size":"","header_icon":"care-star","header_icon_image":"shopify:\/\/shop_images\/wash_0436325d-e834-46bd-a43a-a29c22a848db.svg","header_icon_size":0,"item_icon":"care-bullet","item_icon_size":0,"item_text_indent":0,"card_background":"#222730","card_text_color":"#ffffff","header_background":"#000000","header_text_color":"#ffffff","item_1_title":"Machine wash cold - gentle cycle, mild detergent","item_1_text":"<p>Cold water, mild detergent. Think spa day, not power wash. Your BattleGear has been through enough already.<\/p>","item_2_title":"Low tumble dry - no heat","item_2_text":"<p>Your baselayer is built for the ice, not the sauna. Low and slow wins every time - heat degrades the A9 cut protection.<\/p>","item_3_title":"Keep away from velcro and abrasive materials","item_3_text":"<p>Velcro and rough surfaces snag performance fabric. Keep your gear clear of them.<\/p>","item_4_title":"Wash separately from heavy garments","item_4_text":"<p>Jeans, jackets, and zippers like to pick fights with performance fabrics. Keep them out of the mix and let your BattleGear have the machine to itself.<\/p>","item_5_title":"","item_5_text":"","item_6_title":"","item_6_text":""}},"care_group_y9bHmw":{"type":"care_group","settings":{"show_header":true,"title":"Warranty killers","title_size":"","header_icon":"none","header_icon_image":"shopify:\/\/shop_images\/no-warranty.svg","header_icon_size":0,"item_icon":"care-cross","item_icon_size":0,"item_text_indent":18,"card_background":"#222730","card_text_color":"#ffffff","header_background":"#000000","header_text_color":"#ffffff","item_1_title":"Bleach","item_1_text":"<p>Absolutely not, ever, under any circumstances.<\/p>","item_2_title":"Dry cleaning","item_2_text":"<p>Your gear is not a suit.<\/p>","item_3_title":"Heated drying or hot water","item_3_text":"<p>Kills cut protection.<\/p>","item_4_title":"","item_4_text":"","item_5_title":"","item_5_text":"","item_6_title":"","item_6_text":""}},"care_group_XLEEbk":{"type":"care_group","settings":{"show_header":true,"title":"After use","title_size":"","header_icon":"none","header_icon_image":"shopify:\/\/shop_images\/hanger_3cd235dc-0f8e-4a2f-8e02-320a2f821ae0.svg","header_icon_size":0,"item_icon":"care-bullet","item_icon_size":0,"item_text_indent":18,"card_background":"#222730","card_text_color":"#ffffff","header_background":"#000000","header_text_color":"#ffffff","item_1_title":"Hang to dry immediately","item_1_text":"<p>Off the ice and onto a hanger. Don't let it sit in a pile - wet gear stewing in its own glory is a smell you'll never forget.<\/p>","item_2_title":"Don't leave it in the hockey bag","item_2_text":"<p>The hockey bag is where equipment goes to marinate. Your BattleGear has serious science protecting it - don't make it fight harder than it has to.<\/p>","item_3_title":"Micro-Texpur® antimicrobial protection","item_3_text":"<p>Built-in defense against bacteria, odor, mold, and mildew. It's doing heavy lifting - but it's not a reason to leave your gear in the bag.<\/p>","item_4_title":"","item_4_text":"","item_5_title":"","item_5_text":"","item_6_title":"","item_6_text":""}},"care_group_R4B9XV":{"type":"care_group","settings":{"show_header":true,"title":"Pro tips","title_size":"","header_icon":"none","header_icon_image":"shopify:\/\/shop_images\/pro_d9da6d6c-bc28-4010-8ce6-05c446631df3.svg","header_icon_size":0,"item_icon":"care-star","item_icon_size":18,"item_text_indent":25,"card_background":"#222730","card_text_color":"#ffffff","header_background":"#000000","header_text_color":"#ffffff","item_1_title":"Wash in a delicates mesh laundry bag","item_1_text":"<p>It keeps the TITANOTEX fabric protected and your baselayer from tangling with anything it shouldn't.<\/p>","item_2_title":"Avoid crumpling into a ball and leaving in the road","item_2_text":"<p>We probably don't need to say this - but we said it anyway.<\/p>","item_3_title":"Skip the fabric softener","item_3_text":"<p>It coats the fibers and quietly reduces performance over time. Your gear doesn't need to smell like lavender to be elite.<\/p>","item_4_title":"","item_4_text":"","item_5_title":"","item_5_text":"","item_6_title":"","item_6_text":""}},"care_group_nBhn9P":{"type":"care_group","settings":{"show_header":true,"title":"Product notice","title_size":"","header_icon":"none","header_icon_image":"shopify:\/\/shop_images\/prod-notice.svg","header_icon_size":0,"item_icon":"none","item_icon_size":0,"item_text_indent":0,"card_background":"#000000","card_text_color":"#ffffff","header_background":"#000000","header_text_color":"#ffffff","item_1_title":"Our gear is made for performance and durability, but damage caused by velcro battles, zipper attacks, or rough washing is not considered a manufacturing defect. Treat it right, and your Titan will be ready for battle every time.","item_1_text":"","item_2_title":"","item_2_text":"","item_3_title":"","item_3_text":"","item_4_title":"","item_4_text":"","item_5_title":"","item_5_text":"","item_6_title":"","item_6_text":""}}},"block_order":["care_group_MqLGEJ","care_group_y9bHmw","care_group_XLEEbk","care_group_R4B9XV","care_group_nBhn9P"],"name":"Care guide","settings":{"heading":"","heading_size":"h2","body":"","body_size":"body-font-size-2","content_alignment":"left","cards_gap":20,"card_header_padding_block":12,"card_header_padding_inline":25,"card_body_padding_block":35,"card_body_padding_inline":25,"items_gap":20,"item_icon_gap":6,"item_text_indent":18,"header_icon_size":40,"item_icon_size":13,"card_title_size_desktop":32,"card_title_size_mobile":24,"card_title_letter_spacing":1,"card_title_uppercase":true,"item_title_weight":"700","item_title_size_desktop":18,"item_title_size_mobile":12,"item_text_size_desktop":14,"item_text_size_mobile":12,"container_size":"large","round_level":"default","color_scheme_variant":"default","color_scheme":"7","show_background":false,"add_desktop_side_paddings":true,"add_mobile_side_paddings":true,"section_spacing_top":"xxl","section_spacing_bottom":"xxl"}}},"order":["page","image_banner_jUWqNJ","care_guide_e7gNcj"]}