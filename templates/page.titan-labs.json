scheme":"","show_background":false,"add_desktop_side_paddings":true,"add_mobile_side_paddings":true,"section_spacing_top":"s","section_spacing_bottom":"l"}},"hotspots_kaz8bt":{"type":"hotspots","blocks":{"pin_icon_iaLGJr":{"type":"pin_icon","disabled":true,"settings":{"icon_type":"custom","icon":"discount-outline","custom_icon_image":"shopify:\/\/shop_images\/spc.svg","icon_size":62,"desktop_horizontal_position":58,"desktop_vertical_position":34,"mobile_horizontal_position":72,"mobile_vertical_position":42,"heading":"STRETCH PROCURVE™","heading_size":"caption1","body":"<p>VELCRO-FREE COLLAR<\/p>","body_size":"body4","content_alignment":"left","link_text":"","link":""}},"pin_icon_nRB6Rx":{"type":"pin_icon","disabled":true,"settings":{"icon_type":"custom","icon":"discount-outline","custom_icon_image":"shopify:\/\/shop_images\/spc.svg","icon_size":62,"desktop_horizontal_position":52,"desktop_vertical_position":41,"mobile_horizontal_position":56,"mobile_vertical_position":47,"heading":"STRETCH PROCURVE™","heading_size":"caption1","body":"<p>VELCRO-FREE COLLAR<\/p>","body_size":"body4","content_alignment":"left","link_text":"","link":""}},"pin_icon_xeAE3N":{"type":"pin_icon","disabled":true,"settings":{"icon_type":"custom","icon":"discount-outline","custom_icon_image":"shopify:\/\/shop_images\/spc.svg","icon_size":62,"desktop_horizontal_position":57,"desktop_vertical_position":42,"mobile_horizontal_position":70,"mobile_vertical_position":49,"heading":"STRETCH PROCURVE™","heading_size":"caption1","body":"<p>VELCRO-FREE COLLAR<\/p>","body_size":"body4","content_alignment":"left","link_text":"","link":""}}},"block_order":["pin_icon_iaLGJr","pin_icon_nRB6Rx","pin_icon_xeAE3N"],"name":"t:sections.hotspots.name","settings":{"section_layout":"image-bottom","trigger_for_show_pin":"hover","subheading":"","heading":"NOT ALL NECK GUARDS ARE CREATED EQUAL","heading_size":"h2","body_richtext":"<p>Ice hockey is one of the fastest and most dangerous sports in the world, yet the gear designed to protect players lags far behind. Most mass-market brands rely on outdated materials for their hockey neck guards, producing overseas in countries like China, and using products like Kevlar® derivatives with cut-resistance ratings of A2 to A3 on the ANSI scale. For a sport where razor-sharp skate blades move at high speeds, this level of protection is dangerously inadequate. Worse, these products often sacrifice comfort and performance for marginal safety. Stiff, heavy, and lacking stretch, they compromise player mobility—an unacceptable tradeoff in a sport where every second counts.<\/p>","body_size":"body3","content_alignment":"left","content_paddings_size":"xl","desktop_image":"shopify:\/\/shop_images\/Banner_3.0_desk_center_test.webp","enable_desktop_custom_img_ratio":true,"desktop_custom_image_ratio":0.4,"mobile_image":"shopify:\/\/shop_images\/Banner_3.0_mobile_center_test.webp","enable_custom_mobile_img_ratio":true,"mobile_custom_image_ratio":1.3,"pin_inner_color":"#ffffff","pin_outer_color":"#d7fd52","container_size":"large","round_level":"default","color_scheme_variant":"own","color_scheme":"3","show_background":false,"add_desktop_side_paddings":true,"add_mobile_side_paddings":true,"section_spacing_top":"m","section_spacing_bottom":"s","disable_lazy_loading":false}},"image_scroller_pTKA4m":{"type":"image-scroller","blocks":{"slide_zFXfhL":{"type":"slide","settings":{"media_type":"image","image":"shopify:\/\/shop_images\/ROYAL_DYLAN_LOCKER_ROOM_COLLECTION_TEST__png.jpg","subheading":"","heading":"Engineering a Safer FUTURE","heading_size":"h3","body":"<p>At <strong>Titan BattleGear<\/strong>, we’ve reimagined hockey safety and performance from the ground up. Leveraging cutting-edge technologies and materials science, we’ve closed the gap, creating gear that doesn’t force players to choose between protection and performance.<br\/><br\/><strong>Advanced Cut-Resistance<\/strong><\/p><p>Our <strong>TITANOTEX™<\/strong> materials are engineered to outperform. Tested on TDM-100 machines, which measure cut resistance using precise and standardized ANSI\/ISEA methods, TITANOTEX achieves ratings up to <strong>A9<\/strong>, the highest cut-resistance level. That’s up to <strong>4x the protection<\/strong> of Kevlar-based products used by competitors.<\/p>","body_size":"body3","button_text":"","button_link":"","button_style":"primary"}},"slide_FEiFPx":{"type":"slide","settings":{"media_type":"image","image":"shopify:\/\/shop_images\/ArcGuard3.png","subheading":"","heading":"ARC~GUARD CONTOURED COLLAR COVERAGE","heading_size":"h3","body":"<p>Neck injuries are among the most serious risks in hockey, with jugular and carotid arteries especially vulnerable. Our patented <strong>ARC~GUARD™ collar<\/strong> provides maximum coverage where it matters most, shielding critical areas while maintaining player comfort.<br\/><br\/>Unlike traditional designs, the ARC~GUARD<strong>™ <\/strong>collar:<\/p><ul><li>Slopes under the chin to prevent bunching and irritation.<\/li><li>Stands taller by the ears for enhanced protection.<\/li><\/ul><p>This combination of comfort and protection ensures players are safer without distraction.<\/p>","body_size":"body3","button_text":"","button_link":"","button_style":"primary"}},"slide_d8mEHq":{"type":"slide","settings":{"media_type":"image","image":"shopify:\/\/shop_images\/palmsandpucksPDP4.png","subheading":"","heading":"Breakthrough Cut-Resistant Materials","heading_size":"h3","body":"<p>Innovation isn’t just about what’s on the surface—it’s what’s inside. Our gear integrates <strong>TITANOTEX™<\/strong> materials that:<\/p><ul><li>Maximizes cut resistance while minimizing weight & thickness<\/li><li>Maximizes Thermoregulation to keep players cool under pressure<\/li><li>Strengthens after washing, ensuring cut-protection is not only maintained, but enhanced over time<\/li><\/ul><p>The result? Gear that’s not only safer but actively enhances a player’s performance on the ice.<\/p>","body_size":"body3","button_text":"","button_link":"","button_style":"primary"}},"slide_68w4GT":{"type":"slide","settings":{"media_type":"image","image":"shopify:\/\/shop_images\/made_in_colombia.png","subheading":"","heading":"Rejecting the Status Quo","heading_size":"h3","body":"<p>Unlike the mass-market brands produced in Asia with outdated materials, Titan BattleGear is proud to design and produce locally, prioritizing quality over quantity. Our relentless focus on <strong>innovation, protection, and performance <\/strong>ensures that every product we create is built to help players play harder, safer, and longer.<\/p>","body_size":"body3","button_text":"","button_link":"shopify:\/\/collections\/cut-resistant-battlegear","button_style":"primary"}}},"block_order":["slide_zFXfhL","slide_FEiFPx","slide_d8mEHq","slide_68w4GT"],"name":"t:sections.image_scroller.name","settings":{"scroller_type":"scroll_text","image_position":"left","desktop_img_ratio":1,"mobile_img_ratio":1,"content_alignment":"left","content_paddings_size":"xl","rotate_images":false,"container_size":"large","round_level":"default","color_scheme_variant":"own","color_scheme":"3","show_background":false,"add_desktop_side_paddings":true,"add_mobile_side_paddings":false,"section_spacing_top":"none","section_spacing_bottom":"none"}},"rich_text_HgwbA4":{"type":"rich-text","blocks":{"text_axj4EN":{"type":"text","settings":{"text":"<p>Innovation and protection aren’t just our goals; they’re our mission.<br\/>Dominate the ice with confidence, knowing your safety and performance are unmatched in Titan BattleGear.<\/p>","text_2":"","text_3":"","body_size":"body3"}},"buttons_AkxQ99":{"type":"buttons","settings":{"btn_text":"SHOP BATTLEGEAR","btn_url":"","btn_style":"primary","extra_btn_text":"","extra_btn_url":"shopify:\/\/collections\/cut-resistant-battlegear","extra_btn_style":"primary"}}},"block_order":["text_axj4EN","buttons_AkxQ99"],"name":"t:sections.rich_text.name","settings":{"content_align":"center","container_size"