\/govx_digi_camo.jpg","video":"shopify:\/\/files\/videos\/Cut Resistant Machine.mp4"}}},"block_order":["image_RadJQH"],"disabled":true,"name":"t:sections.images_with_text.name","settings":{"content_layout":"right","image_layout":"grid","img_ratio":1,"rotate_images":false,"icon_type":"none","icon":"settings","subheading":"","heading":"PROTECTION ISN’T OPTIONAL. IT’S A STANDARD.","heading_size":"h3","body":"<p>At Titan BattleGear, we build the safest cut-resistant hockey baselayer and neck guards on the ice.<br\/><br\/>If you serve in uniform, respond to emergencies, teach the next generation, or support those who do, you understand what that means. Protection isn’t a feature. It’s a responsibility.<br\/><br\/>That’s why we proudly offer exclusive pricing through GovX for those who protect and lead in their communities.<\/p><p><strong>Active duty military, veterans, first responders, government employees, and educators receive 15% off Titan BattlGear plus free shipping. Always.<\/strong><\/p>","body_size":"body3","content_alignment":"left","content_paddings_size":"xl","first_button_text":"Verify with GOVX","first_button_link":"https:\/\/auth.govx.com\/shopify\/verify?shop=42ddef-3.myshopify.com&utm_source=shopify&utm_medium=govxid&utm_campaign=custom_link","first_button_style":"secondary","second_button_text":"","second_button_link":"","second_button_style":"secondary","container_size":"large","round_level":"default","color_scheme_variant":"own","color_scheme":"3","show_background":false,"add_desktop_side_paddings":false,"add_mobile_side_paddings":false,"section_spacing_top":"s","section_spacing_bottom":"none"}},"multicolumn_ri3LBg":{"type":"multicolumn","blocks":{"column_with_icon_cCbBkE":{"type":"column_with_icon","settings":{"icon_type":"none","icon":"discount-outline","icon_size":64,"title":"","text":"<p><strong>Active duty military, veterans, first responders, government employees, and educators receive 15% off Titan BattlGear plus free shipping. Always.<\/strong><\/p>","link_text":"VERIFY WITH GOVX","link_url":"https:\/\/auth.govx.com\/shopify\/verify?shop=42ddef-3.myshopify.com&utm_source=shopify&utm_medium=govxid&utm_campaign=custom_link","btn_style":"secondary"}},"column_with_icon_HwL9dc":{"type":"column_with_icon","settings":{"icon_type":"none","icon":"discount-outline","icon_size":64,"title":"","text":"<ul><li>A9 ANSI cut resistance, the highest level available<\/li><li>No Velcro<\/li><li>Wrist protection<\/li><li>USA Hockey compliant<\/li><li>100% made in the USA<\/li><\/ul>","link_text":"","link_url":"","btn_style":"link"}}},"block_order":["column_with_icon_cCbBkE","column_with_icon_HwL9dc"],"disabled":true,"name":"t:sections.multicolumn.name","settings":{"desktop_layout":"grid","mobile_layout":"grid","desktop_columns":2,"space_between_cards":"xs","space_between_cards_mobile":"xs","title":"","heading_size":"h5","text":"","body_size":"body3","content_alignment":"left","column_heading_size":"h6","column_body_size":"body3","column_alignment":"center","content_spacing":"m","show_column_background":true,"btn_text":"","btn_url":"","btn_style":"primary","autoplay_mode":"disabled","autoplay_interval":3,"show_navigation_on_hover":true,"container_size":"large","round_level":"default","color_scheme_variant":"own","color_scheme":"3","show_background":true,"add_desktop_side_paddings":true,"add_mobile_side_paddings":false,"section_spacing_top":"xs","section_spacing_bottom":"xs"}},"collection_text_BQHRPK":{"type":"collection-text","disabled":true,"name":"Collection BEST SELLERS","settings":{"collection":"test-collection","content_position":"left","cards_to_show":6,"desktop_columns":3,"space_between_cards":"s","space_between_cards_mobile":"l","icon_type":"none","icon":"settings","caption":"PLAYER FAVORITES","title":"SHOP OUR BEST SELLERS","heading_size":"h5","text":"","body_size":"body3","content_alignment":"left","link_text":"SEE ALL BATTLEGEAR","link_url":"","img_ratio":"square","img_ratio_resize":"fill","product_card_align":"left","autoplay_mode":"disabled","autoplay_interval":3,"show_navigation_on_hover":true,"container_size":"page-width","round_level":"0","color_scheme_variant":"own","color_scheme":"8","show_background":false,"add_desktop_side_paddings":true,"add_mobile_side_paddings":true,"section_spacing_top":"l","section_spacing_bottom":"l"}},"1786999550171aeee3":{"type":"_blocks","settings":{}},"faq_w4JYiA":{"type":"faq","blocks":{"question_gdeRy7":{"type":"question","settings":{"title":"What is the Titan Alliance Rewards Program?","heading_size":"caption2","icon_type":"none","icon":"settings","icon_size":24,"text":"<p>The <em>Titan Alliance<\/em> Rewards Program is Titan BattleGear's loyalty and rewards program designed to thank and reward your commitment to safety and style. By joining, you can earn points for purchases, engage with our brand, unlock exclusive perks, discounts, and access to special events.<\/p>","page":"","body_size":"body3","media_type":"image","image_width":100}},"question_KqXURz":{"type":"question","settings":{"title":"How do I join the Titan Alliance Rewards Program?","heading_size":"caption2","icon_type":"none","icon":"settings","icon_size":24,"text":"<p>Simply create an account on our website and opt into the Titan Alliance program. If you’ve already made a purchase, you can join by logging in to your account and following the steps to enroll.<\/p>","page":"","body_size":"body3","media_type":"image","image_width":100}},"question_YUKnck":{"type":"question","settings":{"title":"How do I earn points?","heading_size":"caption2","icon_type":"none","icon":"settings","icon_size":24,"text":"<p>You earn points for:<\/p><ul><li><strong>Submit Your Story:<\/strong> Earn 25 points by sharing your \"Together We Conquer\" moments.<\/li><li><strong>Place an Order:<\/strong> Earn cashback in the form of points for every $1 spent.<\/li><li><strong>Post a Product Review:<\/strong> Get 50 points for sharing your feedback.<\/li><li><strong>Complete a Referral:<\/strong> Earn 50 points for every successful referral.<\/li><li><strong>Follow on Instagram:<\/strong> Gain 50 points by following us on Instagram.<\/li><li><strong>Celebrate Loyalty Anniversary:<\/strong> Receive 50 points when you reach a loyalty milestone.<\/li><\/ul>","page":"","body_size":"body3","media_type":"image","image_width":100}},"question_kQBGjQ":{"type":"question","settings":{"title":"What can I redeem my points for?","heading_size":"caption2","icon_type":"none","icon":"settings","icon_size":24,"text":"<p>Points can be redeemed for discounts on future purchases, exclusive products, early access to new releases, and invitations to special events. Higher tiers unlock even more rewards!<\/p>","page":"","body_size":"body3","media_type":"image","image_width":100}},"question_3rh8z4":{"type":"question","settings":{"title":"What are the different membership tiers?","heading_size":"caption2","icon_type":"none","icon":"settings","icon_size":24,"text":"<p>Our program has four tiers:<\/p><ul><li><strong>Alpha<\/strong>: Our top-tier members who enjoy the most exclusive benefits.<\/li><li><strong>Bravo<\/strong>: Members who receive a mix of discounts and early access.<\/li><li><strong>Charlie<\/strong>: For loyal customers starting to build their reward potential.<\/li><li><strong>Delta<\/strong>: The entry-level tier for new members to start earning.<\/li><\/ul>","page":"","body_size":"body3","media_type":"image","image_width":100}},"question_db8fjH":{"type":"question","settings":{"title":"How do I move up to a higher tier?","heading_size":"caption2","icon_type":"none","icon":"settings","icon_size":24,"text":"<p>You can move up by accumulating points. The more you engage with the program, the more benefits you'll unlock. Each tier requires a set amount of points, and you can track your progress through your account dashboard.<\/p>","page":"","body_size":"body3","media_type":"image","image_width":100}},"question_gQQRzh":{"type":"question","settings":{"title":"Can I redeem points for cash?","heading_size":"caption2","icon_type":"none","icon":"settings","icon_size":24,"text":"<p>Points are not redeemable for cash, but they can be used for discounts on purchases and special rewards.<\/p>","page":"","body_size":"body3","media_type":"image","image_width":100}},"question_xQzd37":{"type":"question","settings":{"title":"Do my points ever expire?","heading_size":"caption2","icon_type":"none","icon":"settings","icon_size":24,"text":"<p>Yes, points will expire after 18 months of inactivity. To keep your points active, simply make a purchase or engage with us to earn more points.<\/p>","page":"","body_size":"body3","media_type":"image","image_width":100}},"question_UmQyKJ":{"type":"question","settings":{"title":"How can I check my points balance?","heading_size":"caption2","icon_type":"none","icon":"settings","icon_size":24,"text":"<p>You can check your points balance on our website by logging into your account and accessing your <a href=\"\/pages\/loyalty-program\" title=\"Loyalty Program\">account dashboard.<\/a><\/p>","page":"","body_size":"body3","media_type":"image","image_width":100}},"question_9R6BFU":{"type":"question","settings":{"title":"Can I combine rewards with other discounts or promotions?","heading_size":"caption2","icon_type":"none","icon":"settings","icon_size":24,"text":"<p>Yes, rewards can typically be combined with other discounts, but some promotions may have restrictions. Be sure to check the terms of each offer.<\/p>","page":"","body_size":"body3","media_type":"image","image_width":100}},"question_FGkYhC":{"type":"question","settings":{"title":"Is the Titan Alliance Rewards Program available in all regions?","heading_size":"caption2","icon_type":"none","icon":"settings","icon_size":24,"text":"<p>Yes, rewards can typically be combined with other discounts, but some promotions may have restrictions. Be sure to check the terms of each offer.<\/p>","page":"","body_size":"body3","media_type":"image","image_width":100}},"question_EjdXNJ":{"type":"question","settings":{"title":"How do I contact customer support about the rewards program?","heading_size":"caption2","icon_type":"none","icon":"settings","icon_size":24,"text":"<p>If you have any questions or issues related to your rewards, please contact our customer support team via email at <a href=\"mailto:info@titanbattlegear.com\"><span style=\"text-decoration:underline\">info@titanbattlegear.com<\/span><\/a>, call us +1 954-737-6777 or at our <a href=\"https:\/\/www.titanbattlegear.com\/pages\/contact\"><span style=\"text-decoration:underline\">contact form<\/span><\/a>, and we’ll be happy to assist you.<\/p>","page":"","body_size":"body3","media_type":"image","image_width":100}}},"block_order":["question_gdeRy7","question_KqXURz","question_YUKnck","question_kQBGjQ","question_3rh8z4","question_db8fjH","question_gQQRzh","question_xQzd37","question_UmQyKJ","question_9R6BFU","question_FGkYhC","question_EjdXNJ"],"name":"t:sections.faq.name","settings":{"section_layout":"bottom-tabs","color_tabs":"content_tabs_separately","expand_first_tab":false,"title":"TITAN ALLIANCE FAQS","heading_size":"h5","text":"Answers to most common questions about products, orders, shipments, and payments.","body_size":"body3","content_alignment":"center","btn_text":"","btn_url":"","btn_style":"primary","container_size":"xsmall","round_level":"default","color_scheme_variant":"default","color_scheme":"","show_background":false,"add_desktop_side_paddings":true,"add_mobile_side_paddings":true,"section_spacing_top":"xxl","section_spacing_bottom":"xxl"}}},"order":["page","image_banner_bTkYXD","loyalty_ranks_VHxHkX","images_with_text_XdTikQ","multicolumn_ri3LBg","collection_text_BQHRPK","1786999550171aeee3","faq_w4JYiA"]}