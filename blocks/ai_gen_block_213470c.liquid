{% doc %}
  @prompt
    créame una sección de formulario de contacto , debe hacer match con el estilo del tema actual en cuanto al uso de tipografía , de igual forma que tenga varias opciones para ajustar el ancho en version de escritorio . el formulario es simple y minimalista , y debe tener los siguientes campos . First Name, Last Name , Email , City, State/Region, LinkedIn Bio, Why are you a fit for this role? ( that one is a box for long text input , Phone number , and Upload resume ( ad a button for people to attach a pdf or word file . y listo , el bottom submit .... todos los campos son obligatorios . haz el formulario para que podamos modificar los colores del fondo, letra casillas , etc 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-form-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.form_padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-contact-form__heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    text-align: {{ block.settings.heading_alignment }};
  }

  .ai-contact-form__description-{{ ai_gen_id }} {
    font-family: {{ settings.body_font_family.family }}, {{ settings.body_font_family.fallback_families }};
    font-weight: {{ settings.body_font_family.weight }};
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.description_spacing }}px 0;
    text-align: {{ block.settings.heading_alignment }};
  }

  .ai-contact-form__form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.field_spacing }}px;
  }

  .ai-contact-form__row-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.field_spacing }}px;
  }

  .ai-contact-form__field-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-contact-form__label-{{ ai_gen_id }} {
    font-family: {{ settings.body_font_family.family }}, {{ settings.body_font_family.fallback_families }};
    font-weight: {{ settings.body_font_family.weight }};
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }};
  }

  .ai-contact-form__required-{{ ai_gen_id }} {
    color: {{ block.settings.required_color }};
  }

  .ai-contact-form__input-{{ ai_gen_id }},
  .ai-contact-form__textarea-{{ ai_gen_id }},
  .ai-contact-form__select-{{ ai_gen_id }} {
    font-family: {{ settings.body_font_family.family }}, {{ settings.body_font_family.fallback_families }};
    font-weight: {{ settings.body_font_family.weight }};
    font-size: {{ block.settings.input_text_size }}px;
    padding: {{ block.settings.input_padding }}px;
    border: {{ block.settings.input_border_width }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.input_text_color }};
    width: 100%;
  }

  .ai-contact-form__input-{{ ai_gen_id }}:focus,
  .ai-contact-form__textarea-{{ ai_gen_id }}:focus,
  .ai-contact-form__select-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.input_focus_color }};
    outline-offset: 2px;
  }

  .ai-contact-form__textarea-{{ ai_gen_id }} {
    min-height: 120px;
    resize: vertical;
  }

  .ai-contact-form__file-wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-contact-form__file-input-{{ ai_gen_id }} {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .ai-contact-form__file-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: {{ block.settings.input_padding }}px;
    border: {{ block.settings.input_border_width }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.input_text_color }};
    cursor: pointer;
    font-family: {{ settings.body_font_family.family }}, {{ settings.body_font_family.fallback_families }};
    font-weight: {{ settings.body_font_family.weight }};
    font-size: {{ block.settings.input_text_size }}px;
  }

  .ai-contact-form__file-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    border-color: {{ block.settings.button_background_color }};
  }

  .ai-contact-form__file-name-{{ ai_gen_id }} {
    margin-top: 8px;
    font-size: {{ block.settings.input_text_size | minus: 2 }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-contact-form__submit-{{ ai_gen_id }} {
    font-family: {{ settings.button_font_family.family }}, {{ settings.button_font_family.fallback_families }};
    font-weight: {{ settings.button_font_family.weight }};
    font-size: {{ block.settings.button_text_size }}px;
    text-transform: {{ settings.button_font_uppercase }};
    padding: {{ block.settings.button_padding }}px {{ block.settings.button_padding | times: 2 }}px;
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    cursor: pointer;
    width: 100%;
    margin-top: {{ block.settings.button_spacing }}px;
  }

  .ai-contact-form__submit-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background_color }};
  }

  .ai-contact-form__success-{{ ai_gen_id }} {
    padding: 16px;
    background-color: {{ block.settings.success_background_color }};
    color: {{ block.settings.success_text_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-bottom: {{ block.settings.field_spacing }}px;
  }

  .ai-contact-form__error-{{ ai_gen_id }} {
    padding: 16px;
    background-color: {{ block.settings.error_background_color }};
    color: {{ block.settings.error_text_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-bottom: {{ block.settings.field_spacing }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-form-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-contact-form__row-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<contact-form-{{ ai_gen_id }} class="ai-contact-form-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-contact-form__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  {% if block.settings.description != blank %}
    <div class="ai-contact-form__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
  {% endif %}

  {%- form 'contact' -%}
    {% if form.posted_successfully? %}
      <div class="ai-contact-form__success-{{ ai_gen_id }}" id="ai-contact-form-success-{{ ai_gen_id }}">
        {{ block.settings.success_message }}
      </div>
    {% endif %}

    {% if form.errors %}
      <div class="ai-contact-form__error-{{ ai_gen_id }}" id="ai-contact-form-error-{{ ai_gen_id }}">
        {{ form.errors.messages | first }}
      </div>
    {% endif %}

    <div class="ai-contact-form__form-{{ ai_gen_id }}">
      <div class="ai-contact-form__row-{{ ai_gen_id }}">
        <div class="ai-contact-form__field-{{ ai_gen_id }}">
          <label for="ai-contact-first-name-{{ ai_gen_id }}" class="ai-contact-form__label-{{ ai_gen_id }}">
            {{ block.settings.first_name_label }} <span class="ai-contact-form__required-{{ ai_gen_id }}">*</span>
          </label>
          <input
            type="text"
            id="ai-contact-first-name-{{ ai_gen_id }}"
            name="contact[first_name]"
            class="ai-contact-form__input-{{ ai_gen_id }}"
            required
            aria-required="true"
          >
        </div>

        <div class="ai-contact-form__field-{{ ai_gen_id }}">
          <label for="ai-contact-last-name-{{ ai_gen_id }}" class="ai-contact-form__label-{{ ai_gen_id }}">
            {{ block.settings.last_name_label }} <span class="ai-contact-form__required-{{ ai_gen_id }}">*</span>
          </label>
          <input
            type="text"
            id="ai-contact-last-name-{{ ai_gen_id }}"
            name="contact[last_name]"
            class="ai-contact-form__input-{{ ai_gen_id }}"
            required
            aria-required="true"
          >
        </div>
      </div>

      <div class="ai-contact-form__field-{{ ai_gen_id }}">
        <label for="ai-contact-email-{{ ai_gen_id }}" class="ai-contact-form__label-{{ ai_gen_id }}">
          {{ block.settings.email_label }} <span class="ai-contact-form__required-{{ ai_gen_id }}">*</span>
        </label>
        <input
          type="email"
          id="ai-contact-email-{{ ai_gen_id }}"
          name="contact[email]"
          class="ai-contact-form__input-{{ ai_gen_id }}"
          autocomplete="email"
          required
          aria-required="true"
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="ai-contact-form-error-{{ ai_gen_id }}"
          {% endif %}
        >
      </div>

      <div class="ai-contact-form__row-{{ ai_gen_id }}">
        <div class="ai-contact-form__field-{{ ai_gen_id }}">
          <label for="ai-contact-city-{{ ai_gen_id }}" class="ai-contact-form__label-{{ ai_gen_id }}">
            {{ block.settings.city_label }} <span class="ai-contact-form__required-{{ ai_gen_id }}">*</span>
          </label>
          <input
            type="text"
            id="ai-contact-city-{{ ai_gen_id }}"
            name="contact[city]"
            class="ai-contact-form__input-{{ ai_gen_id }}"
            required
            aria-required="true"
          >
        </div>

        <div class="ai-contact-form__field-{{ ai_gen_id }}">
          <label for="ai-contact-state-{{ ai_gen_id }}" class="ai-contact-form__label-{{ ai_gen_id }}">
            {{ block.settings.state_label }} <span class="ai-contact-form__required-{{ ai_gen_id }}">*</span>
          </label>
          <input
            type="text"
            id="ai-contact-state-{{ ai_gen_id }}"
            name="contact[state]"
            class="ai-contact-form__input-{{ ai_gen_id }}"
            required
            aria-required="true"
          >
        </div>
      </div>

      <div class="ai-contact-form__field-{{ ai_gen_id }}">
        <label for="ai-contact-phone-{{ ai_gen_id }}" class="ai-contact-form__label-{{ ai_gen_id }}">
          {{ block.settings.phone_label }} <span class="ai-contact-form__required-{{ ai_gen_id }}">*</span>
        </label>
        <input
          type="tel"
          id="ai-contact-phone-{{ ai_gen_id }}"
          name="contact[phone]"
          class="ai-contact-form__input-{{ ai_gen_id }}"
          autocomplete="tel"
          required
          aria-required="true"
        >
      </div>

      <div class="ai-contact-form__field-{{ ai_gen_id }}">
        <label for="ai-contact-linkedin-{{ ai_gen_id }}" class="ai-contact-form__label-{{ ai_gen_id }}">
          {{ block.settings.linkedin_label }} <span class="ai-contact-form__required-{{ ai_gen_id }}">*</span>
        </label>
        <input
          type="url"
          id="ai-contact-linkedin-{{ ai_gen_id }}"
          name="contact[linkedin_bio]"
          class="ai-contact-form__input-{{ ai_gen_id }}"
          required
          aria-required="true"
        >
      </div>

      <div class="ai-contact-form__field-{{ ai_gen_id }}">
        <label for="ai-contact-why-fit-{{ ai_gen_id }}" class="ai-contact-form__label-{{ ai_gen_id }}">
          {{ block.settings.why_fit_label }} <span class="ai-contact-form__required-{{ ai_gen_id }}">*</span>
        </label>
        <textarea
          id="ai-contact-why-fit-{{ ai_gen_id }}"
          name="contact[why_fit]"
          class="ai-contact-form__textarea-{{ ai_gen_id }}"
          required
          aria-required="true"
        ></textarea>
      </div>

      <div class="ai-contact-form__field-{{ ai_gen_id }}">
        <label for="ai-contact-resume-{{ ai_gen_id }}" class="ai-contact-form__label-{{ ai_gen_id }}">
          {{ block.settings.resume_label }} <span class="ai-contact-form__required-{{ ai_gen_id }}">*</span>
        </label>
        <div class="ai-contact-form__file-wrapper-{{ ai_gen_id }}">
          <input
            type="file"
            id="ai-contact-resume-{{ ai_gen_id }}"
            name="contact[resume]"
            class="ai-contact-form__file-input-{{ ai_gen_id }}"
            accept=".pdf,.doc,.docx"
            required
            aria-required="true"
          >
          <label for="ai-contact-resume-{{ ai_gen_id }}" class="ai-contact-form__file-button-{{ ai_gen_id }}">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
            {{ block.settings.upload_button_text }}
          </label>
          <div class="ai-contact-form__file-name-{{ ai_gen_id }}" data-file-name></div>
        </div>
      </div>

      <button type="submit" class="ai-contact-form__submit-{{ ai_gen_id }}">
        {{ block.settings.submit_button_text }}
      </button>
    </div>
  {%- endform -%}
</contact-form-{{ ai_gen_id }}>

<script>
  (function() {
    class ContactForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.fileInput = this.querySelector('.ai-contact-form__file-input-{{ ai_gen_id }}');
        this.fileNameDisplay = this.querySelector('[data-file-name]');
        
        if (this.fileInput && this.fileNameDisplay) {
          this.fileInput.addEventListener('change', (e) => {
            const fileName = e.target.files[0]?.name || '';
            this.fileNameDisplay.textContent = fileName ? `Selected: ${fileName}` : '';
          });
        }
      }
    }

    customElements.define('contact-form-{{ ai_gen_id }}', ContactForm{{ ai_gen_id }});
  })();
</script>

