{% doc %}
  @prompt
    créame una sección de formulario de contacto , debe hacer match con el estilo del tema actual en cuanto al uso de tipografía y opciones de ajuste de tamaños , de igual forma que tenga varias opciones para ajustar el ancho en version de escritorio . el formulario es simple y minimalista , y debe tener la opcion de agregar hasta 12 campos diferentes . uno de esos campos debe tener la opcion de elección de respuesta multiple la cual se puede escoger de una lista de hasta 4 opciones distintas . otro campo debe permitir texto largo , debe haber una casilla de verificación tipo check mark , y debe tener la posibilidad de agregar un texto tipo términos y condiciones antes del botón final de submit . la idea es que pueda activar y desactivar la inclusion de ciertos campos según lo que quiera pedir en el formulario. de igual forma me debe dejar realizar los ajustes de tamaño independiente en desktop y en mobile , en cuanto a color este debe dejar controlar el fondo de el formulario y tambien el fondo de sección de forma independiente . , LOS PRIMEROS 8 CAMPOS DEBEN ALINEARSE EN 2 COLUMNAS EN LA VERSION DE ESCRITORIO , haz que el campo de selección multiple sea el campo #8 . y haz que diga "please select" en lugar de seleccionar opcion . de igual forma haz el nombre de los otros botones en ingles , EL CAMPO #11 DEBE ser un campo de cargar archivos de video , y este puede decir Upload Highlight Video, Field #6 is a date field . debe seguir el orden de como se selecciona date en Estados Unidos es decir mes dia año , cambia el estilo del campo #6 de fecha , para que se vea mas condensado . algo asi como que se vea normal solo que tenga el selector de fecha cuando se accede a el 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-form-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.section_background_color }};
    padding: {{ block.settings.section_padding_desktop }}px 0;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-form-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_mobile }}px 0;
    }
  }

  .ai-contact-form-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.desktop_width_percent }}%;
    margin: 0 auto;
    padding: 0 20px;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-form-container-{{ ai_gen_id }} {
      max-width: {{ block.settings.mobile_width_percent }}%;
    }
  }

  .ai-contact-form-wrapper-{{ ai_gen_id }} {
    background-color: {{ block.settings.form_background_color }};
    padding: {{ block.settings.form_padding_desktop }}px;
    border-radius: {{ block.settings.form_border_radius }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-form-wrapper-{{ ai_gen_id }} {
      padding: {{ block.settings.form_padding_mobile }}px;
    }
  }

  .ai-contact-form-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size_desktop }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    text-align: {{ block.settings.text_alignment }};
  }

  @media screen and (max-width: 749px) {
    .ai-contact-form-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }
  }

  .ai-contact-form-description-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.description_size_desktop }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.description_spacing }}px 0;
    text-align: {{ block.settings.text_alignment }};
  }

  @media screen and (max-width: 749px) {
    .ai-contact-form-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size_mobile }}px;
    }
  }

  .ai-contact-form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.field_spacing }}px;
  }

  .ai-contact-form-fields-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.field_spacing }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-form-fields-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }

  .ai-contact-form-field-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-contact-form-label-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.label_size_desktop }}px;
    color: {{ block.settings.text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-contact-form-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_size_mobile }}px;
    }
  }

  .ai-contact-form-input-{{ ai_gen_id }},
  .ai-contact-form-textarea-{{ ai_gen_id }},
  .ai-contact-form-select-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.input_size_desktop }}px;
    padding: {{ block.settings.input_padding }}px;
    border: {{ block.settings.input_border_width }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.input_text_color }};
    width: 100%;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-form-input-{{ ai_gen_id }},
    .ai-contact-form-textarea-{{ ai_gen_id }},
    .ai-contact-form-select-{{ ai_gen_id }} {
      font-size: {{ block.settings.input_size_mobile }}px;
    }
  }

  .ai-contact-form-input-{{ ai_gen_id }}:focus,
  .ai-contact-form-textarea-{{ ai_gen_id }}:focus,
  .ai-contact-form-select-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.input_focus_color }};
    outline-offset: 2px;
  }

  .ai-contact-form-textarea-{{ ai_gen_id }} {
    min-height: 120px;
    resize: vertical;
  }

  .ai-contact-form-date-input-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.input_size_desktop }}px;
    padding: {{ block.settings.input_padding }}px;
    border: {{ block.settings.input_border_width }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.input_text_color }};
    width: 100%;
    cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-form-date-input-{{ ai_gen_id }} {
      font-size: {{ block.settings.input_size_mobile }}px;
    }
  }

  .ai-contact-form-date-input-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.input_focus_color }};
    outline-offset: 2px;
  }

  .ai-contact-form-date-input-{{ ai_gen_id }}::-webkit-calendar-picker-indicator {
    cursor: pointer;
    opacity: 0.6;
  }

  .ai-contact-form-date-input-{{ ai_gen_id }}::-webkit-calendar-picker-indicator:hover {
    opacity: 1;
  }

  .ai-contact-form-file-wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-contact-form-file-input-{{ ai_gen_id }} {
    position: absolute;
    opacity: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
    z-index: 2;
  }

  .ai-contact-form-file-label-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.input_size_desktop }}px;
    padding: {{ block.settings.input_padding }}px;
    border: {{ block.settings.input_border_width }}px dashed {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.input_text_color }};
    cursor: pointer;
    transition: border-color 0.3s ease, background-color 0.3s ease;
    min-height: 60px;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-form-file-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.input_size_mobile }}px;
    }
  }

  .ai-contact-form-file-label-{{ ai_gen_id }}:hover {
    border-color: {{ block.settings.input_focus_color }};
    background-color: {{ block.settings.input_background_color }};
  }

  .ai-contact-form-file-icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
    stroke: {{ block.settings.input_text_color }};
  }

  .ai-contact-form-file-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size_desktop }}px;
    color: {{ block.settings.text_color }};
    margin-top: 8px;
    font-style: italic;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-form-file-name-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_size_mobile }}px;
    }
  }

  .ai-contact-form-checkbox-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .ai-contact-form-checkbox-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    margin-top: 2px;
    cursor: pointer;
    flex-shrink: 0;
  }

  .ai-contact-form-checkbox-label-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.label_size_desktop }}px;
    color: {{ block.settings.text_color }};
    cursor: pointer;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-form-checkbox-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_size_mobile }}px;
    }
  }

  .ai-contact-form-terms-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-size: {{ block.settings.terms_size_desktop }}px;
    color: {{ block.settings.text_color }};
    margin: {{ block.settings.field_spacing }}px 0;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-form-terms-{{ ai_gen_id }} {
      font-size: {{ block.settings.terms_size_mobile }}px;
    }
  }

  .ai-contact-form-button-{{ ai_gen_id }} {
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
    font-size: {{ block.settings.button_size_desktop }}px;
    padding: {{ block.settings.button_padding }}px {{ block.settings.button_padding | times: 2 }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    transition: background-color 0.3s ease;
    width: 100%;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-form-button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_size_mobile }}px;
    }
  }

  .ai-contact-form-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-contact-form-success-{{ ai_gen_id }} {
    padding: 16px;
    background-color: {{ block.settings.success_background_color }};
    color: {{ block.settings.success_text_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-bottom: {{ block.settings.field_spacing }}px;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: {{ block.settings.input_size_desktop }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-form-success-{{ ai_gen_id }} {
      font-size: {{ block.settings.input_size_mobile }}px;
    }
  }

  .ai-contact-form-error-{{ ai_gen_id }} {
    padding: 16px;
    background-color: {{ block.settings.error_background_color }};
    color: {{ block.settings.error_text_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-bottom: {{ block.settings.field_spacing }}px;
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: {{ block.settings.input_size_desktop }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-form-error-{{ ai_gen_id }} {
      font-size: {{ block.settings.input_size_mobile }}px;
    }
  }
{% endstyle %}

<contact-form-{{ ai_gen_id }} class="ai-contact-form-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-contact-form-container-{{ ai_gen_id }}">
    <div class="ai-contact-form-wrapper-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-contact-form-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-contact-form-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}

      {%- form 'contact' -%}
        {% if form.posted_successfully? %}
          <div class="ai-contact-form-success-{{ ai_gen_id }}">
            {{ block.settings.success_message }}
          </div>
        {% endif %}

        {% if form.errors %}
          <div class="ai-contact-form-error-{{ ai_gen_id }}">
            {{ form.errors.messages | first }}
          </div>
        {% endif %}

        <div class="ai-contact-form-{{ ai_gen_id }}">
          <div class="ai-contact-form-fields-grid-{{ ai_gen_id }}">
            {% if block.settings.field_1_enabled %}
              <div class="ai-contact-form-field-{{ ai_gen_id }}">
                <label class="ai-contact-form-label-{{ ai_gen_id }}" for="contact-field-1-{{ ai_gen_id }}">
                  {{ block.settings.field_1_label }}{% if block.settings.field_1_required %}*{% endif %}
                </label>
                <input
                  type="text"
                  id="contact-field-1-{{ ai_gen_id }}"
                  name="contact[{{ block.settings.field_1_label }}]"
                  class="ai-contact-form-input-{{ ai_gen_id }}"
                  {% if block.settings.field_1_required %}required{% endif %}
                >
              </div>
            {% endif %}

            {% if block.settings.field_2_enabled %}
              <div class="ai-contact-form-field-{{ ai_gen_id }}">
                <label class="ai-contact-form-label-{{ ai_gen_id }}" for="contact-field-2-{{ ai_gen_id }}">
                  {{ block.settings.field_2_label }}{% if block.settings.field_2_required %}*{% endif %}
                </label>
                <input
                  type="text"
                  id="contact-field-2-{{ ai_gen_id }}"
                  name="contact[{{ block.settings.field_2_label }}]"
                  class="ai-contact-form-input-{{ ai_gen_id }}"
                  {% if block.settings.field_2_required %}required{% endif %}
                >
              </div>
            {% endif %}

            {% if block.settings.field_3_enabled %}
              <div class="ai-contact-form-field-{{ ai_gen_id }}">
                <label class="ai-contact-form-label-{{ ai_gen_id }}" for="contact-field-3-{{ ai_gen_id }}">
                  {{ block.settings.field_3_label }}{% if block.settings.field_3_required %}*{% endif %}
                </label>
                <input
                  type="email"
                  id="contact-field-3-{{ ai_gen_id }}"
                  name="contact[email]"
                  class="ai-contact-form-input-{{ ai_gen_id }}"
                  {% if block.settings.field_3_required %}required{% endif %}
                >
              </div>
            {% endif %}

            {% if block.settings.field_4_enabled %}
              <div class="ai-contact-form-field-{{ ai_gen_id }}">
                <label class="ai-contact-form-label-{{ ai_gen_id }}" for="contact-field-4-{{ ai_gen_id }}">
                  {{ block.settings.field_4_label }}{% if block.settings.field_4_required %}*{% endif %}
                </label>
                <input
                  type="tel"
                  id="contact-field-4-{{ ai_gen_id }}"
                  name="contact[{{ block.settings.field_4_label }}]"
                  class="ai-contact-form-input-{{ ai_gen_id }}"
                  {% if block.settings.field_4_required %}required{% endif %}
                >
              </div>
            {% endif %}

            {% if block.settings.field_5_enabled %}
              <div class="ai-contact-form-field-{{ ai_gen_id }}">
                <label class="ai-contact-form-label-{{ ai_gen_id }}" for="contact-field-5-{{ ai_gen_id }}">
                  {{ block.settings.field_5_label }}{% if block.settings.field_5_required %}*{% endif %}
                </label>
                <input
                  type="text"
                  id="contact-field-5-{{ ai_gen_id }}"
                  name="contact[{{ block.settings.field_5_label }}]"
                  class="ai-contact-form-input-{{ ai_gen_id }}"
                  {% if block.settings.field_5_required %}required{% endif %}
                >
              </div>
            {% endif %}

            {% if block.settings.field_6_enabled %}
              <div class="ai-contact-form-field-{{ ai_gen_id }}">
                <label class="ai-contact-form-label-{{ ai_gen_id }}" for="contact-field-6-{{ ai_gen_id }}">
                  {{ block.settings.field_6_label }}{% if block.settings.field_6_required %}*{% endif %}
                </label>
                <input
                  type="date"
                  id="contact-field-6-{{ ai_gen_id }}"
                  name="contact[{{ block.settings.field_6_label }}]"
                  class="ai-contact-form-date-input-{{ ai_gen_id }}"
                  {% if block.settings.field_6_required %}required{% endif %}
                >
              </div>
            {% endif %}

            {% if block.settings.field_7_enabled %}
              <div class="ai-contact-form-field-{{ ai_gen_id }}">
                <label class="ai-contact-form-label-{{ ai_gen_id }}" for="contact-field-7-{{ ai_gen_id }}">
                  {{ block.settings.field_7_label }}{% if block.settings.field_7_required %}*{% endif %}
                </label>
                <input
                  type="text"
                  id="contact-field-7-{{ ai_gen_id }}"
                  name="contact[{{ block.settings.field_7_label }}]"
                  class="ai-contact-form-input-{{ ai_gen_id }}"
                  {% if block.settings.field_7_required %}required{% endif %}
                >
              </div>
            {% endif %}

            {% if block.settings.field_8_enabled %}
              <div class="ai-contact-form-field-{{ ai_gen_id }}">
                <label class="ai-contact-form-label-{{ ai_gen_id }}" for="contact-field-8-{{ ai_gen_id }}">
                  {{ block.settings.field_8_label }}{% if block.settings.field_8_required %}*{% endif %}
                </label>
                <select
                  id="contact-field-8-{{ ai_gen_id }}"
                  name="contact[{{ block.settings.field_8_label }}]"
                  class="ai-contact-form-select-{{ ai_gen_id }}"
                  {% if block.settings.field_8_required %}required{% endif %}
                >
                  <option value="">Please select</option>
                  {% if block.settings.field_8_option_1 != blank %}
                    <option value="{{ block.settings.field_8_option_1 }}">{{ block.settings.field_8_option_1 }}</option>
                  {% endif %}
                  {% if block.settings.field_8_option_2 != blank %}
                    <option value="{{ block.settings.field_8_option_2 }}">{{ block.settings.field_8_option_2 }}</option>
                  {% endif %}
                  {% if block.settings.field_8_option_3 != blank %}
                    <option value="{{ block.settings.field_8_option_3 }}">{{ block.settings.field_8_option_3 }}</option>
                  {% endif %}
                  {% if block.settings.field_8_option_4 != blank %}
                    <option value="{{ block.settings.field_8_option_4 }}">{{ block.settings.field_8_option_4 }}</option>
                  {% endif %}
                </select>
              </div>
            {% endif %}
          </div>

          {% if block.settings.field_9_enabled %}
            <div class="ai-contact-form-field-{{ ai_gen_id }}">
              <label class="ai-contact-form-label-{{ ai_gen_id }}" for="contact-field-9-{{ ai_gen_id }}">
                {{ block.settings.field_9_label }}{% if block.settings.field_9_required %}*{% endif %}
              </label>
              <textarea
                id="contact-field-9-{{ ai_gen_id }}"
                name="contact[{{ block.settings.field_9_label }}]"
                class="ai-contact-form-textarea-{{ ai_gen_id }}"
                {% if block.settings.field_9_required %}required{% endif %}
              ></textarea>
            </div>
          {% endif %}

          {% if block.settings.field_10_enabled %}
            <div class="ai-contact-form-field-{{ ai_gen_id }}">
              <label class="ai-contact-form-label-{{ ai_gen_id }}" for="contact-field-10-{{ ai_gen_id }}">
                {{ block.settings.field_10_label }}{% if block.settings.field_10_required %}*{% endif %}
              </label>
              <input
                type="text"
                id="contact-field-10-{{ ai_gen_id }}"
                name="contact[{{ block.settings.field_10_label }}]"
                class="ai-contact-form-input-{{ ai_gen_id }}"
                {% if block.settings.field_10_required %}required{% endif %}
              >
            </div>
          {% endif %}

          {% if block.settings.field_11_enabled %}
            <div class="ai-contact-form-field-{{ ai_gen_id }}">
              <label class="ai-contact-form-label-{{ ai_gen_id }}" for="contact-field-11-{{ ai_gen_id }}">
                {{ block.settings.field_11_label }}{% if block.settings.field_11_required %}*{% endif %}
              </label>
              <div class="ai-contact-form-file-wrapper-{{ ai_gen_id }}">
                <input
                  type="file"
                  id="contact-field-11-{{ ai_gen_id }}"
                  name="contact[{{ block.settings.field_11_label }}]"
                  class="ai-contact-form-file-input-{{ ai_gen_id }}"
                  accept="video/*"
                  data-file-input
                  {% if block.settings.field_11_required %}required{% endif %}
                >
                <label for="contact-field-11-{{ ai_gen_id }}" class="ai-contact-form-file-label-{{ ai_gen_id }}">
                  <svg class="ai-contact-form-file-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="17 8 12 3 7 8"></polyline>
                    <line x1="12" y1="3" x2="12" y2="15"></line>
                  </svg>
                  <span data-file-text>Click to upload video or drag and drop</span>
                </label>
                <div class="ai-contact-form-file-name-{{ ai_gen_id }}" data-file-name></div>
              </div>
            </div>
          {% endif %}

          {% if block.settings.field_12_enabled %}
            <div class="ai-contact-form-field-{{ ai_gen_id }}">
              <div class="ai-contact-form-checkbox-wrapper-{{ ai_gen_id }}">
                <input
                  type="checkbox"
                  id="contact-field-12-{{ ai_gen_id }}"
                  name="contact[{{ block.settings.field_12_label }}]"
                  class="ai-contact-form-checkbox-{{ ai_gen_id }}"
                  value="Yes"
                  {% if block.settings.field_12_required %}required{% endif %}
                >
                <label class="ai-contact-form-checkbox-label-{{ ai_gen_id }}" for="contact-field-12-{{ ai_gen_id }}">
                  {{ block.settings.field_12_label }}{% if block.settings.field_12_required %}*{% endif %}
                </label>
              </div>
            </div>
          {% endif %}

          {% if block.settings.show_terms and block.settings.terms_text != blank %}
            <div class="ai-contact-form-terms-{{ ai_gen_id }}">
              {{ block.settings.terms_text }}
            </div>
          {% endif %}

          <button type="submit" class="ai-contact-form-button-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>
</contact-form-{{ ai_gen_id }}>

<script>
  (function() {
    class ContactForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.form = this.querySelector('form');
        this.fileInput = this.querySelector('[data-file-input]');
        this.fileText = this.querySelector('[data-file-text]');
        this.fileName = this.querySelector('[data-file-name]');

        if (this.form) {
          this.form.addEventListener('submit', this.handleSubmit.bind(this));
        }

        if (this.fileInput) {
          this.fileInput.addEventListener('change', this.handleFileChange.bind(this));
        }
      }

      handleFileChange(event) {
        const file = event.target.files[0];
        if (file) {
          this.fileText.textContent = 'Video selected';
          this.fileName.textContent = file.name;
        } else {
          this.fileText.textContent = 'Click to upload video or drag and drop';
          this.fileName.textContent = '';
        }
      }

      handleSubmit(event) {
        const requiredFields = this.form.querySelectorAll('[required]');
        let isValid = true;

        requiredFields.forEach(field => {
          if (field.type === 'file') {
            if (!field.files || field.files.length === 0) {
              isValid = false;
              field.parentElement.querySelector('label').style.borderColor = '{{ block.settings.error_text_color }}';
            } else {
              field.parentElement.querySelector('label').style.borderColor = '{{ block.settings.input_border_color }}';
            }
          } else if (!field.value.trim()) {
            isValid = false;
            field.style.borderColor = '{{ block.settings.error_text_color }}';
          } else {
            field.style.borderColor = '{{ block.settings.input_border_color }}';
          }
        });

        if (!isValid) {
          event.preventDefault();
        }
      }
    }

    customElements.define('contact-form-{{ ai_gen_id }}', ContactForm{{ ai_gen_id }});
  })();
</script>

