{% doc %}
  @prompt
    créame una sección de formulario de contacto , debe hacer match con el estilo del tema actual en cuanto al uso de tipografía , de igual forma que tenga varias opciones para ajustar el ancho en version de escritorio . el formulario es simple y minimalista , y debe tener los siguientes campos . First Name, Last Name , Email , City, State/Region, LinkedIn Bio, Why are you a fit for this role? ( that one is a box for long text input , Phone number , and Upload resume ( ad a button for people to attach a pdf or word file . y listo , el bottom submit .... todos los campos son obligatorios . haz el formulario para que podamos modificar los colores del fondo, letra casillas , etc  . debo tener la opción de ajustar el tamaño del formulario en la pagina y la distancia al borde tanto en escritorio como en mobil . y el formulario debe tener la opción de ajustar las esquinas para ponerlas en curva o en recta , HAY QUE AGREGAR LA OPCION PARA CONTROLAR EL FONDO DE LA SEECION , OSEA el fondo del form ya lo puedo controlar pero requiero controlar tambien el fondo de la sección de atrás del form 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-form-container-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.desktop_padding }}px {{ block.settings.desktop_edge_padding }}px;
    background-color: {{ block.settings.section_background_color }};
  }

  .ai-contact-form-wrapper-{{ ai_gen_id }} {
    max-width: {{ block.settings.desktop_width_percent }}%;
    margin: 0 auto;
    background-color: {{ block.settings.form_background_color }};
    padding: {{ block.settings.form_padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-contact-form-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-contact-form-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 10px 0;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-contact-form-description-{{ ai_gen_id }} {
    font-family: {{ settings.body_font_family.family }}, {{ settings.body_font_family.fallback_families }};
    font-weight: {{ settings.body_font_family.weight }};
    color: {{ block.settings.text_color }};
    margin: 0 0 20px 0;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-contact-form-row-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .ai-contact-form-field-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-contact-form-field-{{ ai_gen_id }}.full-width {
    grid-column: 1 / -1;
  }

  .ai-contact-form-label-{{ ai_gen_id }} {
    font-family: {{ settings.body_font_family.family }}, {{ settings.body_font_family.fallback_families }};
    font-weight: {{ settings.body_font_family.weight }};
    font-size: 14px;
    color: {{ block.settings.label_color }};
  }

  .ai-contact-form-label-{{ ai_gen_id }} .required {
    color: {{ block.settings.required_color }};
  }

  .ai-contact-form-input-{{ ai_gen_id }},
  .ai-contact-form-textarea-{{ ai_gen_id }},
  .ai-contact-form-select-{{ ai_gen_id }} {
    font-family: {{ settings.body_font_family.family }}, {{ settings.body_font_family.fallback_families }};
    font-weight: {{ settings.body_font_family.weight }};
    padding: 12px 16px;
    border: 1px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_background_color }};
    color: {{ block.settings.input_text_color }};
    font-size: 14px;
    width: 100%;
  }

  .ai-contact-form-input-{{ ai_gen_id }}:focus,
  .ai-contact-form-textarea-{{ ai_gen_id }}:focus,
  .ai-contact-form-select-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.input_focus_color }};
    outline-offset: 2px;
  }

  .ai-contact-form-textarea-{{ ai_gen_id }} {
    min-height: 120px;
    resize: vertical;
  }

  .ai-contact-form-file-wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-contact-form-file-input-{{ ai_gen_id }} {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .ai-contact-form-file-button-{{ ai_gen_id }} {
    font-family: {{ settings.button_font_family.family }}, {{ settings.button_font_family.fallback_families }};
    font-weight: {{ settings.button_font_family.weight }};
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background-color: {{ block.settings.file_button_background }};
    color: {{ block.settings.file_button_text }};
    border: 1px solid {{ block.settings.file_button_border }};
    border-radius: {{ block.settings.input_border_radius }}px;
    cursor: pointer;
    font-size: 14px;
    transition: background-color 0.3s ease;
  }

  .ai-contact-form-file-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.file_button_hover_background }};
  }

  .ai-contact-form-file-name-{{ ai_gen_id }} {
    font-family: {{ settings.body_font_family.family }}, {{ settings.body_font_family.fallback_families }};
    font-size: 13px;
    color: {{ block.settings.text_color }};
    margin-top: 8px;
  }

  .ai-contact-form-submit-{{ ai_gen_id }} {
    font-family: {{ settings.button_font_family.family }}, {{ settings.button_font_family.fallback_families }};
    font-weight: {{ settings.button_font_family.weight }};
    padding: 14px 32px;
    background-color: {{ block.settings.submit_button_background }};
    color: {{ block.settings.submit_button_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    font-size: 16px;
    transition: background-color 0.3s ease;
    width: 100%;
  }

  .ai-contact-form-submit-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.submit_button_hover_background }};
  }

  .ai-contact-form-message-{{ ai_gen_id }} {
    font-family: {{ settings.body_font_family.family }}, {{ settings.body_font_family.fallback_families }};
    padding: 12px 16px;
    border-radius: {{ block.settings.input_border_radius }}px;
    margin-bottom: 20px;
  }

  .ai-contact-form-message-{{ ai_gen_id }}.success {
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }

  .ai-contact-form-message-{{ ai_gen_id }}.error {
    background-color: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-form-container-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_padding }}px {{ block.settings.mobile_edge_padding }}px;
    }

    .ai-contact-form-wrapper-{{ ai_gen_id }} {
      max-width: 100%;
    }

    .ai-contact-form-row-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-contact-form-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<contact-form-{{ ai_gen_id }}
  class="ai-contact-form-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-contact-form-wrapper-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-contact-form-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% if block.settings.description != blank %}
      <div class="ai-contact-form-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
    {% endif %}

    {%- form 'contact' -%}
      {% if form.posted_successfully? %}
        <div
          class="ai-contact-form-message-{{ ai_gen_id }} success"
          id="ai-contact-form-success-{{ ai_gen_id }}"
        >
          {{ block.settings.success_message }}
        </div>
      {% endif %}

      {% if form.errors %}
        <div
          class="ai-contact-form-message-{{ ai_gen_id }} error"
          id="ai-contact-form-error-{{ ai_gen_id }}"
        >
          {{ form.errors.messages | join: ', ' }}
        </div>
      {% endif %}

      <div class="ai-contact-form-{{ ai_gen_id }}">
        <div class="ai-contact-form-row-{{ ai_gen_id }}">
          <div class="ai-contact-form-field-{{ ai_gen_id }}">
            <label class="ai-contact-form-label-{{ ai_gen_id }}" for="first-name-{{ ai_gen_id }}">
              First Name <span class="required">*</span>
            </label>
            <input
              type="text"
              id="first-name-{{ ai_gen_id }}"
              name="contact[first_name]"
              class="ai-contact-form-input-{{ ai_gen_id }}"
              required
              aria-required="true"
            >
          </div>

          <div class="ai-contact-form-field-{{ ai_gen_id }}">
            <label class="ai-contact-form-label-{{ ai_gen_id }}" for="last-name-{{ ai_gen_id }}">
              Last Name <span class="required">*</span>
            </label>
            <input
              type="text"
              id="last-name-{{ ai_gen_id }}"
              name="contact[last_name]"
              class="ai-contact-form-input-{{ ai_gen_id }}"
              required
              aria-required="true"
            >
          </div>
        </div>

        <div class="ai-contact-form-row-{{ ai_gen_id }}">
          <div class="ai-contact-form-field-{{ ai_gen_id }}">
            <label class="ai-contact-form-label-{{ ai_gen_id }}" for="email-{{ ai_gen_id }}">
              Email <span class="required">*</span>
            </label>
            <input
              type="email"
              id="email-{{ ai_gen_id }}"
              name="contact[email]"
              class="ai-contact-form-input-{{ ai_gen_id }}"
              required
              aria-required="true"
              autocomplete="email"
            >
          </div>

          <div class="ai-contact-form-field-{{ ai_gen_id }}">
            <label class="ai-contact-form-label-{{ ai_gen_id }}" for="phone-{{ ai_gen_id }}">
              Phone Number <span class="required">*</span>
            </label>
            <input
              type="tel"
              id="phone-{{ ai_gen_id }}"
              name="contact[phone]"
              class="ai-contact-form-input-{{ ai_gen_id }}"
              required
              aria-required="true"
              autocomplete="tel"
            >
          </div>
        </div>

        <div class="ai-contact-form-row-{{ ai_gen_id }}">
          <div class="ai-contact-form-field-{{ ai_gen_id }}">
            <label class="ai-contact-form-label-{{ ai_gen_id }}" for="city-{{ ai_gen_id }}">
              City <span class="required">*</span>
            </label>
            <input
              type="text"
              id="city-{{ ai_gen_id }}"
              name="contact[city]"
              class="ai-contact-form-input-{{ ai_gen_id }}"
              required
              aria-required="true"
            >
          </div>

          <div class="ai-contact-form-field-{{ ai_gen_id }}">
            <label class="ai-contact-form-label-{{ ai_gen_id }}" for="state-{{ ai_gen_id }}">
              State/Region <span class="required">*</span>
            </label>
            <input
              type="text"
              id="state-{{ ai_gen_id }}"
              name="contact[state]"
              class="ai-contact-form-input-{{ ai_gen_id }}"
              required
              aria-required="true"
            >
          </div>
        </div>

        <div class="ai-contact-form-field-{{ ai_gen_id }} full-width">
          <label class="ai-contact-form-label-{{ ai_gen_id }}" for="linkedin-{{ ai_gen_id }}">
            LinkedIn Bio <span class="required">*</span>
          </label>
          <input
            type="url"
            id="linkedin-{{ ai_gen_id }}"
            name="contact[linkedin_bio]"
            class="ai-contact-form-input-{{ ai_gen_id }}"
            required
            aria-required="true"
            placeholder="https://linkedin.com/in/yourprofile"
          >
        </div>

        <div class="ai-contact-form-field-{{ ai_gen_id }} full-width">
          <label class="ai-contact-form-label-{{ ai_gen_id }}" for="fit-{{ ai_gen_id }}">
            Why are you a fit for this role? <span class="required">*</span>
          </label>
          <textarea
            id="fit-{{ ai_gen_id }}"
            name="contact[why_fit]"
            class="ai-contact-form-textarea-{{ ai_gen_id }}"
            required
            aria-required="true"
          ></textarea>
        </div>

        <div class="ai-contact-form-field-{{ ai_gen_id }} full-width">
          <label class="ai-contact-form-label-{{ ai_gen_id }}" for="resume-{{ ai_gen_id }}">
            Upload Resume <span class="required">*</span>
          </label>
          <div class="ai-contact-form-file-wrapper-{{ ai_gen_id }}">
            <input
              type="file"
              id="resume-{{ ai_gen_id }}"
              name="contact[resume]"
              class="ai-contact-form-file-input-{{ ai_gen_id }}"
              accept=".pdf,.doc,.docx"
              required
              aria-required="true"
            >
            <label for="resume-{{ ai_gen_id }}" class="ai-contact-form-file-button-{{ ai_gen_id }}">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="17 8 12 3 7 8"></polyline>
                <line x1="12" y1="3" x2="12" y2="15"></line>
              </svg>
              Choose File
            </label>
            <div class="ai-contact-form-file-name-{{ ai_gen_id }}"></div>
          </div>
        </div>

        <button type="submit" class="ai-contact-form-submit-{{ ai_gen_id }}">
          {{ block.settings.button_label }}
        </button>
      </div>
    {%- endform -%}
  </div>
</contact-form-{{ ai_gen_id }}>

<script>
  (function() {
    class ContactForm{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.fileInput = this.querySelector('.ai-contact-form-file-input-{{ ai_gen_id }}');
        this.fileNameDisplay = this.querySelector('.ai-contact-form-file-name-{{ ai_gen_id }}');
        
        if (this.fileInput) {
          this.fileInput.addEventListener('change', this.handleFileChange.bind(this));
        }
      }

      handleFileChange(event) {
        const file = event.target.files[0];
        if (file) {
          this.fileNameDisplay.textContent = file.name;
        } else {
          this.fileNameDisplay.textContent = '';
        }
      }
    }

    customElements.define('contact-form-{{ ai_gen_id }}', ContactForm{{ ai_gen_id }});
  })();
</script>

