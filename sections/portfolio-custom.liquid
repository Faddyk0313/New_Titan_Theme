{% schema %}
{
  "name": "Portfolio custom",
  "tag": "section",
  "class": "shopify-section__portfolio-custom",
  "max_blocks": 15,
  "settings": [
    {
      "type": "range",
      "id": "columns",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Desktop columns"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_desktop",
      "label": "Enable desktop carousel",
      "default": false
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
