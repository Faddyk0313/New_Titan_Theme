{%- liquid
  assign options = section.settings

  assign color_scheme = settings.default_color_scheme
  if options.color_scheme_variant == 'own'
    assign color_scheme = options.color_scheme
  endif
  assign round_level = options.round_level
  assign show_language_selector = options.show_language_selector
  assign show_currency_selector = options.show_currency_selector
  assign show_currency_flags = options.show_currency_flags
  assign show_payment_icons = options.show_payment_icons
  assign show_policy_links = options.show_policy_links
  assign copyright_text = options.copyright_text
  assign bottom_bar = options.bottom_bar
  assign container_size = options.container_size
  assign enable_follow_on_shop = options.enable_follow_on_shop
  assign add_desktop_side_paddings = options.add_desktop_side_paddings
  assign add_mobile_side_paddings = options.add_mobile_side_paddings
  assign section_spacing_top = options.section_spacing_top
  assign section_spacing_bottom = options.section_spacing_bottom
  assign section_spacing_below_bottom_bar = options.section_spacing_below_bottom_bar
  assign remove_default_top_spacing = options.remove_default_top_spacing
  assign bottom_bar_links_gap_desktop = options.bottom_bar_links_gap_desktop
  assign bottom_bar_links_gap_mobile = options.bottom_bar_links_gap_mobile

  assign enable_content_slide_in = settings.enable_content_slide_in

  # TBG custom Code
  assign partner_image = options.partner_image
  assign partner_image_width_desktop = options.partner_image_width_desktop
  assign partner_image_width_mobile = options.partner_image_width_mobile
  assign contact_info_link = options.contact_info_link
  assign contact_info_label = options.contact_info_label
-%}

{%- liquid
  assign show_background = section.settings.show_background
  assign color_container_background = false

  if show_background == false and settings.default_color_scheme.settings.background != color_scheme.settings.background
    assign color_container_background = true
  endif
-%}

{%- capture css -%}
  {% style %}
    .section-{{ section.id }} {
      --gsc-columns: 1;
      --gsc-space-between-cards: 4.8rem;
      --gsc-section-spacing-top: var(--gsc-padding-block-{{ section_spacing_top }});
      /* TBG custom Code: root spacing-bottom now only controls space BELOW the bottom bar */
      --gsc-section-spacing-bottom: var(--gsc-padding-block-{{ section_spacing_below_bottom_bar }});
      --titan-footer-content-spacing-bottom: var(--gsc-padding-block-{{ section_spacing_bottom }});
      /* TBG custom Code */
      --titan-bottom-bar-links-gap: {{ bottom_bar_links_gap_mobile }}px;
    }

    {%- comment -%} TBG custom Code: gap between bottom bar policy links {%- endcomment -%}
    .section-{{ section.id }} .footer__bottom-bar {
      column-gap: var(--titan-bottom-bar-links-gap);
      row-gap: 10px;
    }

    @media {% render 'media-queries', screen: 'md' %} {
      {%- comment -%} TBG custom Code {%- endcomment -%}
      .section-{{ section.id }} {
        --titan-bottom-bar-links-gap: {{ bottom_bar_links_gap_desktop }}px;
      }
    }

    {%- comment -%} TBG custom Code: space between footer content and the bottom bar {%- endcomment -%}
    .section-{{ section.id }} .footer__container {
      padding-bottom: var(--titan-footer-content-spacing-bottom, 0);
    }

    {%- if remove_default_top_spacing -%}
      {%- comment -%} TBG custom Code: strip theme's built-in top padding so "Top" is authoritative {%- endcomment -%}
      .section-{{ section.id }} .footer__outer-container {
        padding-top: 0;
      }

      .section-{{ section.id }} .footer__card-grid {
        padding-top: 0;
      }
    {%- endif -%}

    {% for block in section.blocks %}
        .block-{{ block.id }}{
            --gsc-logo-width: {{ block.settings.logo_width | divided_by: 10 }}rem;
            --gsc-image-width: {{ block.settings.image_width }}%;
            --gsc-img-ratio: {{ block.settings.image_ratio | times: 100 }}%;
            {%- if block.type == 'contact' -%}
            --titan-contact-icon-size: {{ block.settings.icon_size | default: 30 }}px;
            {%- endif -%}
        }
    {% endfor %}

    /* TBG custom Code */
    .section-{{ section.id }} {
      --titan-footer-link-color: #6b6e74;
      --titan-footer-bottom-link-color: #c8ff00;
      --titan-footer-bottom-bg: #0d1117;
      --titan-partner-width-mobile: {{ partner_image_width_mobile }}px;
      --titan-partner-width-desktop: {{ partner_image_width_desktop }}px;
    }

    /* logo + partner image lockup */
    .section-{{ section.id }} .footer__brand {
      display: flex;
      flex-flow: row wrap;
      align-items: center;
      gap: 2.4rem;
      width: 100%;
    }

    .section-{{ section.id }} .footer__partner-image {
      display: block;
      width: 100%;
      max-width: var(--titan-partner-width-mobile);
      height: auto;
    }

    .section-{{ section.id }} .footer__partner {
      display: flex;
      flex-flow: column;
      align-items: flex-start;
      gap: 0.8rem;
    }

    /* muted link colour + tighter rows */
    .section-{{ section.id }} .footer__menu {
      row-gap: 0.4rem;
    }

    .section-{{ section.id }} .footer__title {
      margin: 0 0 1rem;
    }

    .section-{{ section.id }} .footer__menu-item,
    .section-{{ section.id }} .footer__menu-item .underline-text__label,
    .section-{{ section.id }} .footer__contact-text,
    .section-{{ section.id }} .footer__contact-text * {
      /* !important needed: theme's .body-color uses !important */
      color: var(--titan-footer-link-color) !important;
    }

    /* Need a hand? block — whole column capped at 165px */
    .section-{{ section.id }} .footer__contact,
    .section-{{ section.id }} .footer__contact-text,
    .section-{{ section.id }} .footer__contact-items {
      max-width: 16.5rem;
    }

    .section-{{ section.id }} .footer__contact-text {
      margin: 0 0 2rem;
    }

    .section-{{ section.id }} .footer__contact-items {
      display: flex;
      flex-flow: row nowrap;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.4rem;
      width: 100%
    }

    .section-{{ section.id }} .footer__contact-item {
      /* allow shrinking so 5 items always fit the 165px cap */
      flex: 0 1 auto;
      min-width: 0;
      display: flex;
      flex-flow: column;
      align-items: center;
      gap: 0.6rem;
      text-decoration: none;
      color: var(--titan-footer-link-color);
      transition: color 0.2s ease;
    }

    .section-{{ section.id }} .footer__contact-item:hover {
      color: currentColor;
      opacity: 0.75;
    }

    .section-{{ section.id }} .footer__contact-item-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      max-width: var(--titan-contact-icon-size, 30px);
      aspect-ratio: 1;
    }

    .section-{{ section.id }} .footer__contact-item-icon svg,
    .section-{{ section.id }} .footer__contact-item-icon img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      /* CDN icons are dark; invert so they read on the dark footer */
      filter: brightness(0) invert(1) opacity(0.55);
    }

    .section-{{ section.id }} .footer__contact-item-label {
      white-space: nowrap;
      /* caption3 pulls in the heading font/weight/uppercase — reset to body text,
         then step the size down below the rest of the column copy */
      font-family: var(--gsc-body-font-family);
      font-weight: var(--gsc-body-font-weight);
      font-style: normal;
      font-size: 1.2rem;
      line-height: 1.3;
      text-transform: none;
      letter-spacing: normal;
      word-spacing: normal;
      color: var(--titan-footer-link-color);
    }

    .section-{{ section.id }} .footer__container {
      overflow: visible;
    }

    .section-{{ section.id }} .footer__utils {
      position: relative;
      row-gap: 2rem;
    }

    /* paint the band edge-to-edge regardless of container padding */
    .section-{{ section.id }} .footer__utils::before,
    .section-{{ section.id }} .footer__utils {
      background-color: var(--titan-footer-bottom-bg) !important;
      background: var(--titan-footer-bottom-bg) !important;
    }
    .section-{{ section.id }} .footer__utils::before {
      content: '';
      position: absolute;
      z-index: -1;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 100vw;
      margin-left: -50vw;
      pointer-events: none;
    }

    /* everything in the bottom bar shares the accent colour */
    .section-{{ section.id }} .footer__utils,
    .section-{{ section.id }} .footer__utils .footer__bottom-bar-item,
    .section-{{ section.id }} .footer__utils .footer__bottom-bar-item .underline-text__label,
    .section-{{ section.id }} .footer__utils .footer__copyright,
    .section-{{ section.id }} .footer__utils .footer__socials-item,
    .section-{{ section.id }} .footer__utils .localization-dropdown-toggle,
    .section-{{ section.id }} .footer__utils .localization-dropdown-toggle__chevron {
      /* !important needed: theme's .body-color uses !important */
      color: var(--titan-footer-bottom-link-color) !important;
    }


    .section-{{ section.id }} .footer__socials {
      display: flex;
      align-items: center;
      gap: 1.8rem;
    }

    .section-{{ section.id }} .footer__socials-item {
      display: flex;
      align-items: center;
      justify-content: center;
      color: currentColor;
      transition: opacity 0.2s ease;
    }

    .section-{{ section.id }} .footer__socials-item:hover {
      opacity: 0.7;
    }

    .section-{{ section.id }} .footer__socials-item svg {
      width: 1.8rem;
      height: 1.8rem;
    }

    .section-{{ section.id }} .footer__extra {
      align-items: center;
    }

    /* ---------- mobile layout (TBG custom Code) ---------- */
    @media {% render 'media-queries', screen: 'only_mobile' %} {
      /* logo + partner image side by side, centered — nowrap so the
         partner block stays on the logo's line and both shrink instead */
      .section-{{ section.id }} .footer__brand {
        flex-flow: row nowrap;
        justify-content: center;
        align-items: center;
        gap: 1.6rem;
      }

      /* don't set a width here — .logo-img uses var(--gsc-logo-width)
         from the block's Size setting, and overriding it breaks that control */
      .section-{{ section.id }} .footer__logo {
        flex: 0 1 auto;
        min-width: 0;
        margin: 0;
      }

      .section-{{ section.id }} .footer__partner {
        flex: 0 1 auto;
        min-width: 0;
        align-items: center;
      }

      .section-{{ section.id }} .footer__partner-heading {
        text-align: center;
      }

      /* accordion rows: bigger label, subtle grey bottom rule only */
      .section-{{ section.id }} .footer__accordion_btn {
        border-top: none !important;
        border-bottom: 1px solid rgba(255, 255, 255, 0.12);
        padding-block: 1.8rem;
      }

      .section-{{ section.id }} .footer__accordion:first-of-type .footer__accordion_btn {
        padding-top: 1.8rem;
      }

      .section-{{ section.id }} .footer__accordion_btn > p {
        font-size: 2rem;
        line-height: 1.2;
      }

      /* breathing room between the tab's border and its links; padding goes on
         the inner menu, not .accordeon-plus__content-wrap, which animates max-height */
      .section-{{ section.id }} .footer__accordion .footer__menu {
        padding-top: 1.6rem;
        row-gap: 0.2rem;
      }

      /* tighter gap after the last link */
      .section-{{ section.id }} .accordeon-plus[data-aria-expanded='true'] {
        padding-bottom: 1.2rem;
      }


      /* chevron points right, rotates down when open */
      .section-{{ section.id }} .footer__accordion-chevron {
        width: 2rem;
        height: 2rem;
        margin-left: auto;
        transition: transform 250ms ease;
      }

      .section-{{ section.id }} .accordeon-plus[data-aria-expanded='true'] .footer__accordion-chevron {
        transform: rotate(90deg);
      }

      /* Need a hand? is a centered static section under the menus */
      .section-{{ section.id }} .footer__block--mobile-static:has(.footer__contact-items) {
        align-items: center;
        text-align: center;
        border-top: none;
        padding-block: 3.2rem 0;
        width: 100%;
        max-width: none;
      }

      /* the theme hides .footer__title in static blocks and shows the
         --mobile-static <p> instead; keep that, just tighten the margin */
      .section-{{ section.id }} .footer__block--mobile-static:has(.footer__contact-items) .footer__title--mobile-static {
        margin: 0 0 1.2rem;
        /* match the accordion tab headings above it */
        font-size: 2rem;
        line-height: 1.2;
      }

      /* cap the paragraph so it wraps onto two lines */
      .section-{{ section.id }} .footer__contact-text {
        max-width: 32rem;
        margin: 0 auto 2.4rem;
      }

      .section-{{ section.id }} .footer__contact-items {
        max-width: none;
        justify-content: center;
        gap: 1.6rem;
      }

      /* no room constraint on mobile — let the icon be its natural size
         instead of stretching to fill the item (needed only on desktop) */
      .section-{{ section.id }} .footer__contact-item-icon {
        width: var(--titan-contact-icon-size, 30px);
      }

      /* Bottom bar order: socials + selector on one centered row,
         then copyright, then the policy links.
         .footer__extra is dissolved with display:contents so its children
         become direct flex items of .footer__utils and can be ordered. */
      .section-{{ section.id }} .footer__utils {
        flex-flow: row wrap;
        align-items: center;
        justify-content: center;
        text-align: center;
        row-gap: 1.6rem;
        column-gap: 1.8rem;
      }

      .section-{{ section.id }} .footer__utils .footer__extra {
        display: contents;
      }

      /* socials + selector share the first row */
      .section-{{ section.id }} .footer__utils .footer__socials {
        order: 1;
        flex: 0 0 auto;
        justify-content: center;
      }

      .section-{{ section.id }} .footer__utils .footer__settings {
        order: 2;
        flex: 0 0 auto;
        justify-content: center;
      }

      /* each of these takes a full row of its own */
      .section-{{ section.id }} .footer__utils .footer__copyright {
        order: 3;
        flex: 0 0 100%;
        text-align: center;
      }

      .section-{{ section.id }} .footer__utils .footer__payment-icons {
        order: 4;
        flex: 0 0 100%;
        justify-content: center;
      }

      .section-{{ section.id }} .footer__utils .footer__bottom-bar {
        order: 5;
        flex: 0 0 100%;
        justify-content: center;
        margin: 0;
      }
    }

    @media {% render 'media-queries', screen: 'md' %} {
      /* 6 evenly spaced columns that wrap when cramped */
      .section-{{ section.id }} .footer__card-grid {
        display: flex;
        flex-flow: row wrap;
        align-items: flex-start;
        justify-content: space-between;
        gap: 3.2rem;
      }

      /* each column is exactly as wide as its own content, so short
         columns don't carry empty space; space-between spreads the slack */
      .section-{{ section.id }} .footer__card-grid > .footer__block {
        flex: 0 1 auto;
        min-width: 0;
      }

      /* keep link and heading text on one line so columns size to their longest item */
      .section-{{ section.id }} .footer__menu-item,
      .section-{{ section.id }} .footer__card-grid .footer__title {
        white-space: nowrap;
      }

      /* the Need a hand? column never exceeds 165px */
      .section-{{ section.id }} .footer__card-grid > .footer__block:has(.footer__contact-items) {
        flex: 0 0 16.5rem;
        max-width: 16.5rem;
      }

      .section-{{ section.id }} .footer__brand {
        flex-flow: column;
        align-items: flex-start;
        gap: 2.4rem;
      }

      .section-{{ section.id }} .footer__partner-image {
        max-width: var(--titan-partner-width-desktop);
      }

      .section-{{ section.id }} .footer__logo {
        margin: 0;
      }

      .section-{{ section.id }} .footer__utils {
        align-items: center;
        justify-content: space-between;
        padding-block: 2rem;
      }

      .section-{{ section.id }} .footer__extra {
        margin: 0;
        margin-left: auto;
      }

    }
  {% endstyle %}
{%- endcapture -%}

{%- render 'inline-css-minifier', css: css -%}

<div class='flex flex-col gap-10 footer {% if round_level != 'default' %}round-level-{{round_level}}{% endif %} section-{{ section.id }} section color-{{ color_scheme }} spacing-block {% if add_mobile_side_paddings %}spacing-inline-mobile{% endif %} {% if add_desktop_side_paddings %}spacing-inline-desktop{% endif %} {% if color_container_background == false %}section-background{% endif %}'>
  <div class='footer__outer-container container container--{{ container_size }} {% if color_container_background %}container-background{% endif %}'>
    <div class='footer__container container container--{{ container_size }}'>
      {%- if section.blocks.size > 0 -%}
        <div class='card-grid footer__card-grid'>
          {%- for block in section.blocks -%}
            {% liquid
              assign mobile_block_style = block.settings.mobile_block_style

              # TBG custom Code — contact block is a static section on mobile, never an accordion
              if block.type == 'contact'
                assign mobile_block_style = 'static'
              endif

              assign mobile_title = block.settings.mobile_title
              if mobile_title == blank
                assign mobile_title = block.settings.title
              endif
            %}

            {%- case block.type -%}
              {%- when 'image' -%}
                {%- assign media_type = block.settings.media_type -%}
                {%- assign image = block.settings.image -%}
                {%- assign video = block.settings.video -%}
                {%- assign link_url = block.settings.link.url -%}

                {% if mobile_block_style != 'static' %}
                  <accordeon-component
                    class='accordeon-plus footer__accordion block-{{ block.id }} {% if enable_content_slide_in %}scroll-trigger animate--slide-in{% endif %}'
                    {% if enable_content_slide_in %}
                      style='--gsc-animation-order: {{forloop.index}};'
                    {% endif %}
                    data-aria-expanded='{{ mobile_block_style }}'
                    data-section-id='{{ section.id }}'
                    data-block-id='{{ block.id }}'
                    {{ block.shopify_attributes }}
                  >
                    <accordeon-button class='footer__accordion_btn' tabindex='0'>
                      <p class='{{ block.settings.mobile_heading_size }}'>{{ mobile_title }}</p>
                      {%- comment -%} TBG custom Code {%- endcomment -%}
                      {%- render 'icon', icon_name: 'chevron', class: 'accordeon-plus__icon footer__accordion-chevron' -%}
                    </accordeon-button>

                    <div class='accordeon-plus__content-wrap' data-accordeon-content-wrap>
                      <div class='footer__image-wrap' data-accordeon-content>
                        <a
                          class='shape shape--nature'
                          {% if link_url != blank %}
                            href='{{ link_url }}'
                          {% endif %}
                          aria-label=''
                        >
                          {%- if media_type == 'video' and video != blank -%}
                            {% render 'video-with-alt',
                              video: video,
                              class: 'image footer__image',
                              autoplay: true,
                              loop: true,
                              muted: true,
                              controls: false,
                              loading: 'lazy',
                              iterate_on_click: true
                            %}
                          {%- elsif media_type == 'image' and image != blank -%}
                            <img
                              {% render 'image-attributes',
                                image: image,
                                size: 'medium',
                                class: 'image footer__image'
                              %}
                            >
                          {%- else -%}
                            {{ 'image' | placeholder_svg_tag: 'image footer__image placeholder-image' }}
                          {%- endif -%}
                        </a>
                      </div>
                    </div>
                  </accordeon-component>
                {% endif %}

                <div
                  class='footer__block block-{{ block.id }} {% if mobile_block_style != 'static' %}footer__block--mobile-hidden{% else %}footer__block--mobile-static{% endif %} {% if enable_content_slide_in %}scroll-trigger animate--slide-in{% endif %}'
                  {% if enable_content_slide_in %}
                    style='--gsc-animation-order: {{forloop.index}};'
                  {% endif %}
                  {{ block.shopify_attributes }}
                >
                  {%- if mobile_block_style == 'static' and mobile_title != blank -%}
                    <p class='footer__title--mobile-static {{ block.settings.mobile_heading_size }}'>
                      {{ mobile_title }}
                    </p>
                  {%- endif -%}

                  <div class='footer__image-wrap'>
                    <a
                      class='shape shape--nature'
                      {% if link_url != blank %}
                        href='{{ link_url }}'
                      {% endif %}
                      aria-label=''
                    >
                      {%- if media_type == 'video' and video != blank -%}
                        {% render 'video-with-alt',
                          video: video,
                          class: 'image footer__image',
                          autoplay: true,
                          loop: true,
                          muted: true,
                          controls: false,
                          loading: 'lazy',
                          iterate_on_click: true
                        %}
                      {%- elsif media_type == 'image' and image != blank -%}
                        <img
                          {% render 'image-attributes', image: image, size: 'medium', class: 'image footer__image' %}
                        >
                      {%- else -%}
                        {{ 'image' | placeholder_svg_tag: 'image footer__image placeholder-image' }}
                      {%- endif -%}
                    </a>
                  </div>
                </div>

              {%- when 'text' -%}
                {% if mobile_block_style != 'static' %}
                  <accordeon-component
                    class='accordeon-plus footer__accordion block-{{ block.id }} {% if enable_content_slide_in %}scroll-trigger animate--slide-in{% endif %}'
                    {% if enable_content_slide_in %}
                      style='--gsc-animation-order: {{forloop.index}};'
                    {% endif %}
                    data-aria-expanded='{{ mobile_block_style }}'
                    data-section-id='{{ section.id }}'
                    data-block-id='{{ block.id }}'
                    {{ block.shopify_attributes }}
                  >
                    <accordeon-button class='footer__accordion_btn' tabindex='0'>
                      <p class='{{ block.settings.mobile_heading_size }}'>{{ mobile_title }}</p>
                      {%- comment -%} TBG custom Code {%- endcomment -%}
                      {%- render 'icon', icon_name: 'chevron', class: 'accordeon-plus__icon footer__accordion-chevron' -%}
                    </accordeon-button>

                    <div class='accordeon-plus__content-wrap' data-accordeon-content-wrap>
                      <div
                        class='rte footer__text {{ block.settings.body_size }} body-color body-font-weight-from-global-settings'
                        data-accordeon-content
                      >
                        {{ block.settings.text }}
                      </div>
                    </div>
                  </accordeon-component>
                {% endif %}

                <div
                  class='footer__block block-{{ block.id }} {% if mobile_block_style != 'static' %}footer__block--mobile-hidden{% else %}footer__block--mobile-static{% endif %} {% if enable_content_slide_in %}scroll-trigger animate--slide-in{% endif %}'
                  {% if enable_content_slide_in %}
                    style='--gsc-animation-order: {{forloop.index}};'
                  {% endif %}
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.title != blank -%}
                    <div class='footer__title {{ block.settings.heading_size }}'>{{ block.settings.title }}</div>
                  {%- endif -%}

                  {%- if mobile_block_style == 'static' and mobile_title != blank -%}
                    <p class='footer__title--mobile-static {{ block.settings.mobile_heading_size }}'>
                      {{ mobile_title }}
                    </p>
                  {%- endif -%}

                  {%- if block.settings.text != blank -%}
                    <div class='rte footer__text {{ block.settings.body_size }} body-color body-font-weight-from-global-settings'>
                      {{ block.settings.text }}
                    </div>
                  {%- endif -%}
                </div>

              {%- when 'logo_with_text' -%}
                {% if mobile_block_style != 'static' %}
                  <accordeon-component
                    class='accordeon-plus footer__accordion block-{{ block.id }} {% if enable_content_slide_in %}scroll-trigger animate--slide-in{% endif %}'
                    {% if enable_content_slide_in %}
                      style='--gsc-animation-order: {{forloop.index}};'
                    {% endif %}
                    data-aria-expanded='{{ mobile_block_style }}'
                    data-section-id='{{ section.id }}'
                    data-block-id='{{ block.id }}'
                    {{ block.shopify_attributes }}
                  >
                    <accordeon-button class='footer__accordion_btn' tabindex='0'>
                      <p class='{{ block.settings.mobile_heading_size }}'>{{ mobile_title }}</p>
                      {%- comment -%} TBG custom Code {%- endcomment -%}
