                        </button>
                      {%- endfor -%}
                      <input
                        type='hidden'
                        name='country_code'
                        data-localization-input
                        value='{{ localization.country.iso_code }}'
                        id='FooterLanguageForm-CountryCodeInput-{{ form.id }}'
                      >
                    {%- endform -%}
                  </localization-selector>
                </div>
              </template>
            </float-element>
          </div>
