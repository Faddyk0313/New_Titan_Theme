            <span class='underline-text__label'>{{ contact_info_label }}</span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {% if copyright_text != blank or show_payment_icons %}
      <div class='footer__extra'>
        {%- comment -%}
          TBG custom Code — static social links, edit the hrefs below directly.
        {%- endcomment -%}
        <div class='footer__socials'>
          <a
            class='footer__socials-item'
            href='https://www.facebook.com/'
            target='_blank'
            rel='noopener'
            aria-label='Facebook'
          >
            {%- render 'icon', icon_name: 'facebook' -%}
          </a>
          <a
            class='footer__socials-item'
            href='https://x.com/'
            target='_blank'
            rel='noopener'
            aria-label='X'
          >
            {%- render 'icon', icon_name: 'twitter' -%}
          </a>
          <a
            class='footer__socials-item'
            href='https://www.instagram.com/'
            target='_blank'
            rel='noopener'
            aria-label='Instagram'
          >
            {%- render 'icon', icon_name: 'instagram' -%}
          </a>
          <a
            class='footer__socials-item'
            href='https://www.linkedin.com/'
            target='_blank'
            rel='noopener'
            aria-label='LinkedIn'
          >
            {%- render 'icon', icon_name: 'linkedin' -%}
          </a>
        </div>

        {%- if copyright_text != blank -%}
          <div class='footer__copyright body-color'>
            {{ copyright_text }}
          </div>
        {%- endif -%}

        {%- if show_payment_icons -%}
          <div class='footer__payment-icons'>
            {%- for type in shop.enabled_payment_types -%}
              {{ type | payment_type_svg_tag }}
            {%- endfor -%}
            {%- if shop.features.follow_on_shop? and enable_follow_on_shop -%}
              <div>
                {% # theme-check-disable %}
                {{ shop | login_button: action: 'follow' }}
                {% # theme-check-enable %}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {% endif %}
  </div>
</div>

{%- comment -%} TBG custom Code — Gorgias chat trigger for footer contact buttons {%- endcomment -%}
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var triggers = document.querySelectorAll('[data-tbg-chat-trigger]');

    if (!triggers.length) return;

    var FALLBACK_URL = 'https://contact.gorgias.help/forms/59qu80a2';

    triggers.forEach(function (trigger) {
      trigger.addEventListener('click', function (e) {
        e.preventDefault();

        var gorgiasReady = window.GorgiasChat
          ? window.GorgiasChat.init()
          : new Promise(function (resolve) {
              window.addEventListener(
                'gorgias-widget-loaded',
                function () {
                  resolve();
                },
                { once: true }
              );
            });

        gorgiasReady
          .then(function () {
            if (window.GorgiasChat && typeof window.GorgiasChat.open === 'function') {
              window.GorgiasChat.open();
              return;
            }

            window.location.href = FALLBACK_URL;
          })
          .catch(function () {
            window.location.href = FALLBACK_URL;
          });
      });
    });
  });
</script>
{%- comment -%} End TBG custom Code {%- endcomment -%}

