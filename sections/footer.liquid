                    </div>
                  </accordeon-component>
                {% endif %}

                <div
                  class='footer__block block-{{ block.id }} {% if mobile_block_style != 'static' %}footer__block--mobile-hidden{% else %}footer__block--mobile-static{% endif %} {% if enable_content_slide_in %}scroll-trigger animate--slide-in{% endif %}'
                  {% if enable_content_slide_in %}
                    style='--gsc-animation-order: {{forloop.index}};'
                  {% endif %}
                  {{ block.shopify_attributes }}
                >
                  {%- if mobile_block_style == 'static' and mobile_title != blank -%}
                    <p class='footer__title--mobile-static {{ block.settings.mobile_heading_size }}'>
                      {{ mobile_title }}
                    </p>
                  {%- endif -%}

                  <div class='rte product-content-tab__rte body-color'>
                    {{ block.settings.custom_liquid }}
                  </div>
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {% endif %}

      {%- if show_policy_links and shop.policies.size > 0 -%}
        <div
          class='footer__policies {% if enable_content_slide_in %}scroll-trigger animate--slide-in{% endif %}'
          {% if enable_content_slide_in %}
            style='--gsc-animation-order: {{section.blocks.size | plus: 1}};'
          {% endif %}
        >
          {%- for policy in shop.policies %}
            <a
              class='footer__policies-item underline-text body-color'
              href='{{ policy.url }}'
              aria-label='{{ policy.title | strip_html | escape }}'
            >
              <span class='underline-text__label'>{{ policy.title }}</span>
            </a>
          {%- endfor %}
        </div>
      {%- endif -%}
    </div>
  </div>
  <div
    class='container-background footer__utils {% if enable_content_slide_in and request.design_mode == false %}scroll-trigger animate--slide-in{% endif %}'
