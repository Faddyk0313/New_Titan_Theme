{%- liquid
  assign initial_visible_option_count = 6

  assign options = section.settings

  assign color_scheme = settings.default_color_scheme
  if options.color_scheme_variant == 'own'
    assign color_scheme = options.color_scheme
  endif
  assign round_level = options.round_level

  assign img_ratio = options.img_ratio
  assign img_ratio_resize = options.img_ratio_resize
  if img_ratio != 'default' and img_ratio_resize == 'fit'
    assign img_ratio = img_ratio_resize | append: '-' | append: options.img_ratio
  endif

  assign add_desktop_side_paddings = options.add_desktop_side_paddings
  assign add_mobile_side_paddings = options.add_mobile_side_paddings
  assign section_spacing_top = options.section_spacing_top
  assign section_spacing_bottom = options.section_spacing_bottom
  assign desktop_columns = options.desktop_columns
  assign mobile_columns = options.mobile_columns
  assign enable_filtering = options.enable_filtering
  assign enable_uppercase_title = options.enable_uppercase_title
  assign space_between_cards = options.space_between_cards
  assign space_between_cards_mobile = options.space_between_cards_mobile
  assign option_style = options.option_style
  assign product_per_page = options.product_per_page | times: 1.0
  assign show_product_count = options.show_product_count
  assign show_column_count_switcher = options.show_column_count_switcher
  assign enable_sorting = options.enable_sorting
  assign show_divider = options.show_divider
  assign show_result_count = options.show_result_count
  assign show_color_swatches = options.show_color_swatches
  assign filter_style = options.filter_style
  assign filters_position = options.filters_position
  assign categories_style = options.categories_style
  assign active_filter_count = 0
  assign container_size = options.container_size
  assign pagination_type = options.pagination_type

  comment
    Age group toggle. Each block is one option with its own product tag.

    State lives in the URL as a collection tag route
    (/collections/<handle>/<tag>), readable in Liquid through
    `current_tags`. Query parameters are NOT readable in Liquid, and this
    section is re-rendered server-side on every AJAX update, so the
    selection has to survive that refetch: a tag route is what does.

    A tag route is inclusive, so /collections/x/senior returns Senior-tagged
    products only. The exclusion rule (untagged products stay visible under
    every option) is applied by the grid below, which also orders the
    selected group first.
  endcomment

  assign heading = options.heading
  assign toggle_blocks = section.blocks | where: 'type', 'age_option'

  comment
    Which option is active: the tag in the current route when it belongs to
    a block, else the configured default, else the first block.
  endcomment
  assign active_age = blank
  for block in toggle_blocks
    assign block_key = block.settings.tag | downcase | strip
    for tag in current_tags
      assign tag_key = tag | downcase | strip
      if tag_key == block_key
        assign active_age = block.settings.tag | strip
        break
      endif
    endfor
    if active_age != blank
      break
    endif
  endfor

  if active_age == blank
    assign default_tag_downcase = options.default_age_tag | downcase | strip
    if default_tag_downcase != blank
      for block in toggle_blocks
        assign block_key = block.settings.tag | downcase | strip
        if block_key == default_tag_downcase
          assign active_age = block.settings.tag | strip
          break
        endif
      endfor
    endif
  endif
  if active_age == blank and toggle_blocks.size > 0
    assign active_age = toggle_blocks[0].settings.tag | strip
  endif
  assign active_age_downcase = active_age | downcase | strip

  comment
    Tags belonging to the non-selected options: what the grid excludes.
  endcomment
  assign excluded_tags = ''
  for block in toggle_blocks
    assign block_tag = block.settings.tag | strip
    assign block_tag_downcase = block_tag | downcase
    if block_tag != blank and block_tag_downcase != active_age_downcase
      assign excluded_tags = excluded_tags | append: block_tag_downcase | append: ','
    endif
  endfor
  assign excluded_tag_list = excluded_tags | split: ','

  comment
    The grid always applies the exclusion: a tag route narrows to the tagged
    products only, and the untagged ones have to be added back.
  endcomment
  assign apply_liquid_exclusion = false
  if excluded_tag_list.size > 0
    assign apply_liquid_exclusion = true
  endif

  assign product_card_align = options.product_card_align

  for filter in collection.filters
    assign active_filter_count = active_filter_count | plus: filter.active_values.size
  endfor

  for filter in collection.filters
    if filter.type == 'price_range'
      assign max_price = filter.range_max
      assign max_value = filter.max_value.value
      assign min_value = filter.min_value.value
      if max_value < max_price or min_value > 0
        assign has_price_filtering = true
        break
      endif
    endif
  endfor

  if has_price_filtering
    assign active_filter_count = active_filter_count | plus: 1
  endif

  if collection.filters.size == 0
    assign enable_filtering = false
  endif

  assign enable_content_slide_in = settings.enable_content_slide_in
-%}

{% liquid
  assign swatch_patterns = settings.primary_custom_colors_and_patterns
  assign primary_custom_colors_and_patterns = swatch_patterns | newline_to_br | split: '<br />'
%}

{%- liquid
  assign show_background = section.settings.show_background
  assign color_container_background = false

  if show_background == false and settings.default_color_scheme.settings.background != color_scheme.settings.background
    assign color_container_background = true
  endif
-%}

{% capture section_background_color %}
  {% render 'get-section-background-color', section: section %}
{% endcapture %}

{% capture css %}
    {% style %}

    .section-{{ section.id }}{
      --gsc-mobile-columns: {{ mobile_columns }};
      --gsc-desktop-columns: {{ desktop_columns }};
      --gsc-space-between-cards: var(--gsc-gap-{{ space_between_cards_mobile }});  
      --gsc-section-spacing-top: var(--gsc-padding-block-{{ section_spacing_top }});
      --gsc-section-spacing-bottom: var(--gsc-padding-block-{{ section_spacing_bottom }});
      --gsc-age-accent: {{ options.toggle_active_background }};
      --gsc-age-accent-text: {{ options.toggle_active_text }};
      --gsc-age-border: {{ options.toggle_border_color }};
    }

    .section-{{ section.id }} .shop-age__bar{
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 24px;
    }

    .section-{{ section.id }} .shop-age__heading{
      margin: 0;
      flex: 0 0 auto;
    }

    .section-{{ section.id }} .shop-age__heading-spacer{
      flex: 0 0 auto;
    }

    .section-{{ section.id }} .shop-age__toggle{
      display: flex;
      align-items: center;
      gap: {{ options.toggle_gap }}px;
      flex: 1 1 auto;
      justify-content: center;
      flex-wrap: wrap;
    }

    .section-{{ section.id }} .shop-age__sort{
      flex: 0 0 auto;
      margin-left: auto;
    }

    .section-{{ section.id }} .shop-age__option{
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: {{ options.toggle_min_width }}px;
      padding: {{ options.toggle_padding_block }}px {{ options.toggle_padding_inline }}px;
      border: 1px solid var(--gsc-age-border);
      background: transparent;
      color: currentColor;
      font-size: {{ options.toggle_font_size }}px;
      letter-spacing: 0.04em;
      line-height: 1.1;
      text-align: center;
      text-decoration: none;
      text-transform: uppercase;
      cursor: pointer;
      transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }

    .section-{{ section.id }} .shop-age__option:hover{
      border-color: var(--gsc-age-accent);
    }

    .section-{{ section.id }} .shop-age__option.is-active{
      background: var(--gsc-age-accent);
      border-color: var(--gsc-age-accent);
      color: var(--gsc-age-accent-text);
    }

    .section-{{ section.id }} .shop-age__option.is-loading{
      opacity: 0.6;
      pointer-events: none;
    }

    @media (max-width: 767px){
      .section-{{ section.id }} .shop-age__bar{
        gap: 12px;
      }

      .section-{{ section.id }} .shop-age__toggle{
        order: 3;
        width: 100%;
        flex: 1 0 100%;
        justify-content: stretch;
      }

      .section-{{ section.id }} .shop-age__option{
        flex: 1 1 0;
        min-width: 0;
      }
    }

    /* ---------------------------------------------------------------
       Filter sidebar.

       The sidebar markup comes from the shared desktop-filters /
       mobile-filters snippets, which the stock products section also
       uses, so nothing there is edited. Everything below is scoped to
       this section and keyed off classes a small script adds, tagging
       each filter group by its label.

       Base option style is set to a pill (button-outline) so every
       filter renders .pill elements; the groups that should stay
       checkboxes are converted back here.
       --------------------------------------------------------------- */

    .section-{{ section.id }} .filters,
    .shop-sidebar-{{ section.id }} .filters{
      --gsc-f-accent: {{ options.filter_accent_color }};
      --gsc-f-muted: {{ options.filter_muted_color }};
      --gsc-f-pill-gap: {{ options.filter_pill_gap }}px;
    }

    /* ---- Pill groups ----
       These render as checkbox markup (label > input + span + text).
       The tick box is hidden and the label itself becomes the pill, so the
       underlying input keeps driving the theme's own filter form. */
    .shop-sidebar-{{ section.id }} .filters__item--pills .filters__options{
      flex-flow: row wrap;
      row-gap: var(--gsc-f-pill-gap);
      column-gap: var(--gsc-f-pill-gap);
    }

    .shop-sidebar-{{ section.id }} .filters__item--pills .checkbox__span{
      display: none;
    }

    .shop-sidebar-{{ section.id }} .filters__item--pills .checkbox{
      display: inline-flex;
      align-items: center;
      gap: 0;
      margin: 0;
      padding: {{ options.filter_pill_padding_block }}px {{ options.filter_pill_padding_inline }}px;
      border: 1px solid var(--gsc-f-muted);
      color: var(--gsc-f-muted);
      background: transparent;
      font-size: {{ options.filter_pill_font_size }}px;
      letter-spacing: 0.02em;
      line-height: 1.1;
      text-transform: uppercase;
      white-space: nowrap;
      cursor: pointer;
      transition: color 0.2s ease, border-color 0.2s ease;
    }

    .shop-sidebar-{{ section.id }} .filters__item--pills .checkbox:hover{
      border-color: var(--gsc-f-accent);
      color: var(--gsc-f-accent);
    }

    /* Selected pill: green text + green border, never filled. */
    .shop-sidebar-{{ section.id }} .filters__item--pills .checkbox:has(.checkbox__input:checked){
      border-color: var(--gsc-f-accent);
      color: var(--gsc-f-accent);
    }

    .shop-sidebar-{{ section.id }} .filters__item--pills .checkbox--disabled{
      opacity: 0.35;
      cursor: not-allowed;
    }

    /* ---- Size: YOUTH / SENIOR sub-groups ---- */
    .shop-sidebar-{{ section.id }} .filters__subhead{
      display: flex;
      align-items: center;
      gap: 6px;
      width: 100%;
      margin: 4px 0 2px;
      color: var(--gsc-f-muted);
      font-size: {{ options.filter_subhead_font_size }}px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    /* Force a row break so each sub-group starts on its own line. */
    .shop-sidebar-{{ section.id }} .filters__subhead::before{
      content: '\25B8';
      font-size: 0.9em;
      line-height: 1;
    }

    .shop-sidebar-{{ section.id }} .filters__subhead + .checkbox{
      margin-left: 0;
    }

    /* ---- Checkbox groups: green tick + green text when selected ---- */
    .shop-sidebar-{{ section.id }} .filters__item--checks .checkbox__span--outline{
      border-color: var(--gsc-f-muted);
    }

    .shop-sidebar-{{ section.id }} .filters__item--checks .checkbox__input:checked + .checkbox__span{
      background: transparent;
      border-color: var(--gsc-f-accent);
    }

    .shop-sidebar-{{ section.id }} .filters__item--checks .checkbox__input:checked + .checkbox__span::before{
      border-color: var(--gsc-f-accent);
    }

    .shop-sidebar-{{ section.id }} .filters__item--checks .checkbox:has(.checkbox__input:checked){
      color: var(--gsc-f-accent);
    }

    /* ---- In stock only: Yes / No pills in place of the switch ---- */
    .shop-sidebar-{{ section.id }} .filters__instock{
      display: flex;
      gap: var(--gsc-f-pill-gap);
      padding: 8px 0 0;
    }

    .shop-sidebar-{{ section.id }} .filters__instock-option{
      padding: {{ options.filter_pill_padding_block }}px {{ options.filter_pill_padding_inline }}px;
      border: 1px solid var(--gsc-f-muted);
      color: var(--gsc-f-muted);
      background: transparent;
      font-size: {{ options.filter_pill_font_size }}px;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      cursor: pointer;
      transition: color 0.2s ease, border-color 0.2s ease;
    }

    .shop-sidebar-{{ section.id }} .filters__instock-option:hover{
      border-color: var(--gsc-f-accent);
      color: var(--gsc-f-accent);
    }

    .shop-sidebar-{{ section.id }} .filters__instock-option.is-active{
      border-color: var(--gsc-f-accent);
      color: var(--gsc-f-accent);
    }

    /* The original toggle switch is replaced by the pills above. */
    .shop-sidebar-{{ section.id }} .filters__item--instock .slider-switch{
      display: none;
    }


    @media {% render 'media-queries', screen: 'md' %} {
        .section-{{ section.id }}{
          --gsc-space-between-cards: var(--gsc-gap-{{ space_between_cards }});  
        }
    }

    {% endstyle %}
{% endcapture %}

{% render 'inline-css-minifier', css: css %}

{% if enable_filtering %}
  <sidebar-filters-sticky-mobile-button class='shop-mobile-filters-button'>
    <button
      data-sidebar-button
      class='unstyled-button shop-mobile-filters-button__btn'
      aria-label='{{ 'shop.screen_reader.label_for_filters_toggler' | t }}'
      data-sidebar-id='SidebarFiltersMobile'
    >
      {% render 'icon', icon_name: 'filter-toggle' %}
      <span class='shop-mobile-filters-button__btn-label'>
        {{ 'shop.store_front.label_for_filters_toggler' | t }}
      </span>
    </button>
  </sidebar-filters-sticky-mobile-button>
{% endif %}

<shop-component
  class='shop {% if round_level != 'default' %}round-level-{{round_level}}{% endif %} section section-{{ section.id }} color-{{ color_scheme }} spacing-block {% if add_mobile_side_paddings %}spacing-inline-mobile{% endif %} {% if add_desktop_side_paddings %}spacing-inline-desktop{% endif %} {% if color_container_background == false %}section-background{% endif %}'
  data-section-id='{{ section.id }}'
  data-column-switcher-target
>
  <div class='shop__container container container--{{ container_size }} {% if color_container_background %}container-background{% endif %}'>
    {%- if heading != blank or toggle_blocks.size > 0 -%}
      <div class='{% if color_container_background == false and add_desktop_side_paddings == false or add_mobile_side_paddings == false  %}spacing-inline-header{% endif %} shop-age__bar'>
        {%- if heading != blank -%}
          <h2 class='shop-age__heading {{ options.heading_size }}'>{{ heading }}</h2>
        {%- else -%}
          <span class='shop-age__heading-spacer'></span>
        {%- endif -%}

        {%- if toggle_blocks.size > 0 -%}
          <age-toggle
            class='shop-age__toggle'
            role='group'
            aria-label='{{ options.toggle_aria_label | escape }}'

          >
            {%- for block in toggle_blocks -%}
              {%- liquid
                assign block_tag = block.settings.tag | strip
                assign block_tag_downcase = block_tag | downcase
                assign is_active = false
                if block_tag_downcase == active_age_downcase
                  assign is_active = true
                endif

                comment
                  Build this option's URL as a collection tag route,
                  /collections/<handle>/<tag>. That is the only state Liquid
                  can read back (via `current_tags`) after the AJAX refetch
                  re-renders this section, and it needs no app setup.

                  Active filters and the sort order ride along as the query
                  string so the toggle composes with the sidebar. Paging is
                  dropped so the grid restarts at page 1.
                endcomment
                assign tag_handle = block_tag | handleize
                assign block_url = collection.url | append: '/' | append: tag_handle

                assign current_query = ''
                for f in collection.filters
                  for v in f.active_values
                    assign pair = v.param_name | append: '=' | append: v.value
                    assign current_query = current_query | append: pair | append: '&'
                  endfor
                endfor
                if collection.sort_by != blank
                  assign current_query = current_query | append: 'sort_by=' | append: collection.sort_by | append: '&'
                endif
                if current_query != ''
                  assign current_query = current_query | split: '&' | join: '&'
                  assign block_url = block_url | append: '?' | append: current_query
                endif
              -%}
              <a
                class='shop-age__option{% if is_active %} is-active{% endif %}'
                href='{{ block_url }}'
                data-age-option
                data-age-value='{{ block_tag | escape }}'
                aria-pressed='{{ is_active }}'
              >
                {{- block.settings.label | default: block_tag -}}
              </a>
            {%- endfor -%}
          </age-toggle>
        {%- endif -%}

        {%- if enable_sorting -%}
          <div class='shop-age__sort'>
            {% render 'sort-list', results: collection %}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class='{% if color_container_background == false and add_desktop_side_paddings == false or add_mobile_side_paddings == false  %}spacing-inline-header{% endif %} shop__header {% if filters_position == 'right' %} shop__header--reverse {% endif %}'>
      <div
        class='shop__header-left-panel {% if filters_position == 'right' %} shop__header-left-panel--reverse {% endif %} {% if enable_content_slide_in %}scroll-trigger animate--slide-in{% endif %}'
        {% if enable_content_slide_in %}
          style='--gsc-animation-order: 1;'
          data-remove-animation-class
        {% endif %}
      >
        {%- if enable_filtering or enable_sorting -%}
          {%- if enable_filtering -%}
            <sidebar-button class='shop__filters-btn-wrapper shop__filters-btn-wrapper--desktop'>
              <button
                data-sidebar-button
                class='unstyled-button shop__icon-btn shop__filters-btn {% if filter_style == 'open-embed' %} is-opened {% endif %}'
                aria-label='{{ 'shop.screen_reader.label_for_filters_toggler' | t }}'
                data-sidebar-id='SidebarFiltersDesktop'
              >
                {% render 'icon', icon_name: 'filter-toggle' %}
                <span class='shop__filters-btn-label'>
                  {{ 'shop.store_front.label_for_filters_toggler' | t }}
                </span>
              </button>
            </sidebar-button>

            <sidebar-button class='shop__filters-btn-wrapper shop__filters-btn-wrapper--mobile'>
              <button
                data-sidebar-button
                class='unstyled-button shop__icon-btn shop__filters-btn '
                aria-label='{{ 'shop.screen_reader.label_for_filters_toggler' | t }}'
                data-sidebar-id='SidebarFiltersMobile'
              >
                {% render 'icon', icon_name: 'filter-toggle' %}
                <span class='shop__filters-btn-label'>
                  {{ 'shop.store_front.label_for_filters_toggler' | t }}
                </span>
              </button>
            </sidebar-button>
          {%- endif -%}

          {%- comment -%}
            Sorting renders in the age bar above; only fall back to the
            original slot when that bar is not rendered.
          {%- endcomment -%}
          {%- if enable_sorting and heading == blank and toggle_blocks.size == 0 -%}
            {% render 'sort-list', results: collection %}
          {%- endif -%}
        {%- endif -%}
      </div>

      <div
        class='shop__header-right-panel {% if filters_position == 'right' %} shop__header-right-panel--reverse {% endif %} {% if enable_content_slide_in %}scroll-trigger animate--slide-in{% endif %}'
        {% if enable_content_slide_in %}
          style='--gsc-animation-order: 2;'
        {% endif %}
      >
        {%- if show_product_count -%}
          <div class='shop__product-count' id='ShopProductCount'>
            {%- liquid
              comment
                `collection.products_count` ignores the toggle, so when an
                exclusion is active count the whole collection instead. Liquid
                only exposes the current page, so fall back to the unfiltered
                count once the collection spans more than one page.
              endcomment
              assign age_total = collection.products_count
              if apply_liquid_exclusion and collection.products_count <= collection.products.size
                assign age_total = 0
                for product in collection.products
                  assign skip_total = false
                  for product_tag in product.tags
                    assign product_tag_downcase = product_tag | downcase | strip
                    if excluded_tag_list contains product_tag_downcase
                      assign skip_total = true
                      break
                    endif
                  endfor
                  unless skip_total
                    assign age_total = age_total | plus: 1
                  endunless
                endfor
              endif
            -%}
            {{ 'shop.store_front.results_count' | t: count: age_total }}
          </div>
        {%- endif -%}
        {%- if show_column_count_switcher -%}
          <column-switcher
            class='shop__column-switcher--mobile column-switcher'
            data-default='{{ mobile_columns }}'
            data-column-switcher-css-variable='mobile-columns'
            data-section-id='{{ section.id }}'
          >
            {%- for column_switch in (1..2) -%}
              {%- assign column_switch_string = column_switch | append: '' -%}
              <div
                class='column-switcher__item {% if mobile_columns == column_switch_string %}selected{% endif %}'
                data-column-switcher-item
                tabindex='0'
                data-value='{{ column_switch }}'
              >
                {%- for i in (1..column_switch) -%}
                  <span></span>
                {%- endfor -%}
              </div>
            {%- endfor -%}
          </column-switcher>
        {%- endif -%}
        {%- if show_column_count_switcher -%}
          <column-switcher
            class='shop__column-switcher--desktop column-switcher'
            data-default='{{ desktop_columns }}'
            data-column-switcher-css-variable='desktop-columns'
            data-section-id='{{ section.id }}'
          >
            {%- for column_switch in (2..4) -%}
              {%- assign column_switch_string = column_switch | append: '' -%}
              <div
                class='column-switcher__item {% if desktop_columns == column_switch_string %}selected{% endif %}'
                data-column-switcher-item
                tabindex='0'
                data-value='{{ column_switch }}'
              >
                {%- for i in (1..column_switch) -%}
                  <span></span>
                {%- endfor -%}
              </div>
            {%- endfor -%}
          </column-switcher>
        {%- endif -%}
      </div>
    </div>

    {%- if enable_filtering -%}
      {% render 'active-filters',
        results: collection,
        has_price_filtering: has_price_filtering,
        active_filter_count: active_filter_count,
        color_container_background: color_container_background,
        add_desktop_side_paddings: add_desktop_side_paddings,
        add_mobile_side_paddings: add_mobile_side_paddings
      %}
    {%- endif -%}

    <div
      class='shop__content {% if enable_content_slide_in %}scroll-trigger animate--slide-in{% endif %}'
      {% if enable_content_slide_in %}
        style='--gsc-animation-order: 2;'
        data-remove-animation-class
      {% endif %}
    >
      {%- if enable_filtering -%}
        {% if filter_style contains 'embed' %}
          {% render 'desktop-filters',
            active_filter_count: active_filter_count,
            show_divider: show_divider,
            show_result_count: show_result_count,
            filter_style: filter_style,
            categories_style: categories_style,
            filters_position: filters_position,
            show_color_swatches: show_color_swatches,
            option_style: option_style,
            enable_uppercase_title: enable_uppercase_title,
            initial_visible_option_count: initial_visible_option_count,
            results: collection
          %}
        {% endif %}

        {% render 'mobile-filters',
          active_filter_count: active_filter_count,
          show_divider: show_divider,
          show_result_count: show_result_count,
          filter_style: filter_style,
          categories_style: categories_style,
          filters_position: filters_position,
          show_color_swatches: show_color_swatches,
          option_style: option_style,
          enable_uppercase_title: enable_uppercase_title,
          initial_visible_option_count: initial_visible_option_count,
          results: collection
        %}
      {%- endif -%}

      <div class='shop__products' id='ShopProducts'>
        {%- paginate collection.products by product_per_page -%}
          {%- liquid
            comment
              Apply the toggle exclusion to this page of products.

              Liquid cannot build an array of objects, so the exclusion is
              evaluated per product inside the loop below. Here we only count
              how many survive, so the empty state and the grid agree.

              Pagination runs over the unfiltered collection, so a page can
              come back partly or fully empty while later pages still hold
              matches. `paginate.pages` keeps the pager correct, and the
              "no results" copy only shows when nothing matched anywhere.
            endcomment
            assign visible_count = 0
            for product in collection.products
              assign skip_product = false
              if apply_liquid_exclusion
                for product_tag in product.tags
                  assign product_tag_downcase = product_tag | downcase | strip
                  if excluded_tag_list contains product_tag_downcase
                    assign skip_product = true
                    break
                  endif
                endfor
              endif
              unless skip_product
                assign visible_count = visible_count | plus: 1
              endunless
            endfor
          -%}
          {%- if visible_count > 0 -%}
            <div class='shop__products-grid-wrap'>
              <div class='shop__products-grid' id='ShopProductsGrid'>
                {%- comment -%}
                  Two passes so the selected age group leads the grid:
                  pass 1 renders the products carrying the active tag, pass 2
                  the untagged ones shown under every option. Products tagged
                  with a non-selected option are skipped in both passes.
                {%- endcomment -%}
                {%- assign grid_position = 0 -%}
                {%- for render_pass in (1..2) -%}
                  {%- for product in collection.products -%}
                    {%- liquid
                      assign skip_product = false
                      assign has_active_tag = false

                      for product_tag in product.tags
                        assign product_tag_downcase = product_tag | downcase | strip
                        if apply_liquid_exclusion and excluded_tag_list contains product_tag_downcase
                          assign skip_product = true
                          break
                        endif
                        if product_tag_downcase == active_age_downcase
                          assign has_active_tag = true
                        endif
                      endfor

                      comment
                        Pass 1 takes the tagged products, pass 2 the rest.
                      endcomment
                      if skip_product == false
                        if render_pass == 1 and has_active_tag == false
                          assign skip_product = true
                        endif
                        if render_pass == 2 and has_active_tag
                          assign skip_product = true
                        endif
                      endif
                    -%}
                    {%- if skip_product -%}{%- continue -%}{%- endif -%}
                    {%- assign grid_position = grid_position | plus: 1 -%}
                    <div
                      class='shop__grid-item {% if enable_content_slide_in %}scroll-trigger animate--slide-in{% endif %}'
                      {% if enable_content_slide_in %}
                        style='--gsc-animation-order: {{ grid_position }};'
                      {% endif %}
                    >
                      {% render 'product-card',
                        with_bottom_spacing: true,
                        product: product,
                        img_ratio: img_ratio,
                        show_mobile_carousel: true,
                        product_card_align: product_card_align,
                        add_side_paddings: add_side_paddings,
                        primary_custom_colors_and_patterns: primary_custom_colors_and_patterns,
                        section_background_color: section_background_color
                      %}
                    </div>
                  {%- endfor -%}
                {%- endfor -%}
              </div>
              {% render 'loading-overlay', class: 'shop__loading-overlay', id: 'ShopProductsOverlay' %}
            </div>
          {%- else -%}
            {%- if active_filter_count > 0 or apply_liquid_exclusion -%}
              <div
                class='shop__products-stub {% if enable_content_slide_in %}scroll-trigger animate--slide-in{% endif %}'
                {% if enable_content_slide_in %}
                  style='--gsc-animation-order: 1;'
                {% endif %}
              >
                <span>{{ 'shop.store_front.text_for_no_results_found_in_stub' | t }}</span>
                <span>
                  {{- 'shop.store_front.text_for_use_another_filters' | t }}
                  <filter-remove-btn class='shop__filters-reset' data-url='{{ collection.url }}'>
                    {{- 'shop.store_front.text_for_clear_all_in_stub' | t -}}
                  </filter-remove-btn></span
                >
                {% render 'loading-overlay', class: 'shop__loading-overlay', id: 'ShopProductsOverlay' %}
              </div>
            {%- else -%}
              <div
                class='shop__products-stub {% if enable_content_slide_in %}scroll-trigger animate--slide-in{% endif %}'
                {% if enable_content_slide_in %}
                  style='--gsc-animation-order: 1;'
                {% endif %}
              >
                <span>{{ 'shop.store_front.text_for_change_query' | t }}</span>
                {% render 'loading-overlay', class: 'shop__loading-overlay', id: 'ShopProductsOverlay' %}
              </div>
            {%- endif -%}
          {%- endif -%}

          {%- liquid
            if paginate.pages > 1
              case pagination_type
                when 'load-button-pagination'
                  render 'load-button-pagination', class: 'shop__load-button-pagination', paginate: paginate, target: 'shop__grid-item', container_id: 'ShopProductsGrid', all_count: collection.products_count, current_size: paginate.page_size
                when 'classic-pagination'
                  render 'classic-pagination', class: 'shop__classic-pagination', paginate: paginate, overlay_id: 'ShopProductsOverlay', container_id: 'ShopProductsGrid'
                when 'infinite-scroll'
                  render 'infinite-scroll-pagination', class: '', paginate: paginate, target: 'shop__grid-item', container_id: 'ShopProductsGrid'
              endcase
            endif
          -%}
        {%- endpaginate -%}
      </div>
    </div>
  </div>

  {%- if enable_filtering and filter_style contains 'drawer' -%}
    {% render 'desktop-filters',
      active_filter_count: active_filter_count,
      show_divider: show_divider,
      show_result_count: show_result_count,
      filter_style: filter_style,
      categories_style: categories_style,
      filters_position: filters_position,
      show_color_swatches: show_color_swatches,
      option_style: option_style,
      enable_uppercase_title: enable_uppercase_title,
      initial_visible_option_count: initial_visible_option_count,
      results: collection
    %}
  {%- endif -%}
</shop-component>

