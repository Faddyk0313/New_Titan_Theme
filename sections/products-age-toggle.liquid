{%- liquid
  assign initial_visible_option_count = 6

  assign options = section.settings

  assign color_scheme = settings.default_color_scheme
  if options.color_scheme_variant == 'own'
    assign color_scheme = options.color_scheme
  endif
  assign round_level = options.round_level

  assign img_ratio = options.img_ratio
  assign img_ratio_resize = options.img_ratio_resize
  if img_ratio != 'default' and img_ratio_resize == 'fit'
    assign img_ratio = img_ratio_resize | append: '-' | append: options.img_ratio
  endif

  assign add_desktop_side_paddings = options.add_desktop_side_paddings
  assign add_mobile_side_paddings = options.add_mobile_side_paddings
  assign section_spacing_top = options.section_spacing_top
  assign section_spacing_bottom = options.section_spacing_bottom
  assign desktop_columns = options.desktop_columns
  assign mobile_columns = options.mobile_columns
  assign enable_filtering = options.enable_filtering
  assign enable_uppercase_title = options.enable_uppercase_title
  assign space_between_cards = options.space_between_cards
  assign space_between_cards_mobile = options.space_between_cards_mobile
  assign option_style = options.option_style
  assign product_per_page = options.product_per_page | times: 1.0
  assign show_product_count = options.show_product_count
  assign show_column_count_switcher = options.show_column_count_switcher
  assign enable_sorting = options.enable_sorting
  assign show_divider = options.show_divider
  assign show_result_count = options.show_result_count
  assign show_color_swatches = options.show_color_swatches
  assign filter_style = options.filter_style
  assign filters_position = options.filters_position
  assign categories_style = options.categories_style
  assign active_filter_count = 0
  assign container_size = options.container_size
  assign pagination_type = options.pagination_type

  comment
    Age group links.

    Each block is one collection the section links to. These are plain
    navigation links, not filters: every collection already holds a single
    age group, so no filtering or exclusion happens here. The block whose
    collection is the one being viewed renders as the active link.
  endcomment

  assign heading = options.heading
  assign toggle_blocks = section.blocks | where: 'type', 'age_option'

  assign product_card_align = options.product_card_align

  for filter in collection.filters
    assign active_filter_count = active_filter_count | plus: filter.active_values.size
  endfor

  for filter in collection.filters
    if filter.type == 'price_range'
      assign max_price = filter.range_max
      assign max_value = filter.max_value.value
      assign min_value = filter.min_value.value
      if max_value < max_price or min_value > 0
        assign has_price_filtering = true
        break
      endif
    endif
  endfor

  if has_price_filtering
    assign active_filter_count = active_filter_count | plus: 1
  endif

  if collection.filters.size == 0
    assign enable_filtering = false
  endif

  assign enable_content_slide_in = settings.enable_content_slide_in
-%}

{% liquid
  assign swatch_patterns = settings.primary_custom_colors_and_patterns
  assign primary_custom_colors_and_patterns = swatch_patterns | newline_to_br | split: '<br />'
%}

{%- liquid
  assign show_background = section.settings.show_background
  assign color_container_background = false

  if show_background == false and settings.default_color_scheme.settings.background != color_scheme.settings.background
    assign color_container_background = true
  endif
-%}

{% capture section_background_color %}
  {% render 'get-section-background-color', section: section %}
{% endcapture %}

{% capture css %}
    {% style %}

    .section-{{ section.id }}{
      --gsc-mobile-columns: {{ mobile_columns }};
      --gsc-desktop-columns: {{ desktop_columns }};
      --gsc-space-between-cards: var(--gsc-gap-{{ space_between_cards_mobile }});  
      --gsc-section-spacing-top: var(--gsc-padding-block-{{ section_spacing_top }});
      --gsc-section-spacing-bottom: var(--gsc-padding-block-{{ section_spacing_bottom }});
      --gsc-age-accent: {{ options.toggle_active_background }};
      --gsc-age-accent-text: {{ options.toggle_active_text }};
      --gsc-age-border: {{ options.toggle_border_color }};
    }

    .section-{{ section.id }} .shop-age__bar{
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 24px;
    }

    .section-{{ section.id }} .shop-age__heading{
      margin: 0;
      flex: 0 0 auto;
    }

    .section-{{ section.id }} .shop-age__heading-spacer{
      flex: 0 0 auto;
    }

    .section-{{ section.id }} .shop-age__toggle{
      display: flex;
      align-items: center;
      gap: {{ options.toggle_gap }}px;
      flex: 1 1 auto;
      justify-content: flex-start;
      flex-wrap: wrap;
    }

    /*
     * Align the links with the product grid, in CSS only.
     *
     * The filter sidebar is a sibling of this bar inside .shop__content, so
     * the bar cannot share that flex layout. Instead the bar is a grid whose
     * first column mirrors the sidebar's own width.
     *
     * The theme gives the static sidebar 38.4rem and, while closed, pulls it
     * off-canvas with a negative margin so the grid reclaims the full width.
     * `:has()` reads that state straight off the sidebar, so the offset
     * tracks it without any measuring.
     *
     * The open sidebar has no width of its own - `38.4rem` in the theme's
     * CSS is only its *closed* width, used with a matching negative margin to
     * pull it off-canvas. Open, it is a flex item sized by its content, which
     * measures 380px on the live page, and the product grid starts exactly at
     * its trailing edge. 38rem matches that, and `--gsc-age-grid-offset` lets
     * it be overridden per theme without editing this file.
     *
     * Closed, the grid reclaims the full width and starts level with the
     * heading, so the two cannot both sit at the row's start. The first
     * column then sizes to the heading and a gap separates the links, which
     * is what the closed state should look like.
     */
    @media (min-width: 1024px){
      .section-{{ section.id }} .shop-age__bar{
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        column-gap: {{ options.toggle_gap }}px;
      }

      .section-{{ section.id }}:has(.sidebar-filters--static.is-opened) .shop-age__bar{
        grid-template-columns: var(--gsc-age-grid-offset, 38rem) 1fr auto;
        column-gap: 0;
      }

      .section-{{ section.id }} .shop-age__heading,
      .section-{{ section.id }} .shop-age__heading-spacer{
        grid-column: 1;
        justify-self: start;
        /* Never let a long heading push the links out of their column. */
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .section-{{ section.id }} .shop-age__toggle{
        grid-column: 2;
        justify-content: flex-start;
      }

      .section-{{ section.id }} .shop-age__sort{
        grid-column: 3;
        margin-left: 0;
      }
    }

    .section-{{ section.id }} .shop-age__option{
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: {{ options.toggle_min_width }}px;
      padding: {{ options.toggle_padding_block }}px {{ options.toggle_padding_inline }}px;
      border: 1px solid var(--gsc-age-border);
      background: transparent;
      color: currentColor;
      font-size: {{ options.toggle_font_size }}px;
      letter-spacing: 0.04em;
      line-height: 1.1;
      text-align: center;
      text-decoration: none;
      text-transform: uppercase;
      cursor: pointer;
      transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }

    .section-{{ section.id }} .shop-age__option:hover{
      border-color: var(--gsc-age-accent);
    }

    .section-{{ section.id }} .shop-age__option.is-active{
      background: var(--gsc-age-accent);
      border-color: var(--gsc-age-accent);
      color: var(--gsc-age-accent-text);
    }

    .section-{{ section.id }} .shop-age__option.is-loading{
      opacity: 0.6;
      pointer-events: none;
    }

    @media (max-width: 767px){
      .section-{{ section.id }} .shop-age__bar{
        gap: 12px;
      }

      .section-{{ section.id }} .shop-age__toggle{
        order: 3;
        width: 100%;
        flex: 1 0 100%;
        justify-content: stretch;
      }

      .section-{{ section.id }} .shop-age__option{
        flex: 1 1 0;
        min-width: 0;
      }
    }

    /* ---------------------------------------------------------------
       Filter sidebar.

       The sidebar markup comes from the shared desktop-filters /
       mobile-filters snippets, which the stock products section also
       uses, so nothing there is edited. Everything below is scoped to
       this section and keyed off classes a small script adds, tagging
       each filter group by its label.

       Base option style is set to a pill (button-outline) so every
       filter renders .pill elements; the groups that should stay
       checkboxes are converted back here.
       --------------------------------------------------------------- */

    .section-{{ section.id }} .filters,
    /*
     * Define the tokens on the sidebar itself. The theme renders no
     * `.filters` element - the form is `.filters__form` - so hanging these
     * off `.filters` left every var() unresolved and collapsed the borders.
     */
    .shop-sidebar-{{ section.id }}{
      --gsc-f-accent: {{ options.filter_accent_color }};
      --gsc-f-muted: {{ options.filter_muted_color }};
      --gsc-f-pill-gap: {{ options.filter_pill_gap }}px;
    }

    /* Group headings: smaller and tighter than the theme default. */
    .shop-sidebar-{{ section.id }} .filters__label{
      color: {{ options.filter_heading_color }};
      font-size: {{ options.filter_heading_font_size }}px;
      letter-spacing: 0.06em;
    }

    .shop-sidebar-{{ section.id }} .filters__chevron{
      color: {{ options.filter_heading_color }};
    }

    /* Non-pill option text, e.g. Technology and Protection. */
    .shop-sidebar-{{ section.id }} .filters__item--checks .checkbox{
      color: var(--gsc-f-muted);
      font-size: {{ options.filter_option_font_size }}px;
      letter-spacing: 0.02em;
    }

    .shop-sidebar-{{ section.id }} .filters__item--checks .checkbox__span{
      width: 1.8rem;
      height: 1.8rem;
    }

    /* ---- Pill groups ----
       These render as checkbox markup (label > input + span + text).
       The tick box is hidden and the label itself becomes the pill, so the
       underlying input keeps driving the theme's own filter form. */
    .shop-sidebar-{{ section.id }} .filters__item--pills .filters__options{
      flex-flow: row wrap;
      row-gap: var(--gsc-f-pill-gap);
      column-gap: var(--gsc-f-pill-gap);
    }

    .shop-sidebar-{{ section.id }} .filters__item--pills .checkbox__span{
      display: none;
    }

    .shop-sidebar-{{ section.id }} .filters__item--pills .checkbox{
      display: inline-flex;
      align-items: center;
      gap: 0;
      margin: 0;
      padding: {{ options.filter_pill_padding_block }}px {{ options.filter_pill_padding_inline }}px;
      border: 1px solid var(--gsc-f-muted);
      color: var(--gsc-f-muted);
      background: transparent;
      font-size: {{ options.filter_pill_font_size }}px;
      letter-spacing: 0.02em;
      line-height: 1.1;
      text-transform: uppercase;
      white-space: nowrap;
      cursor: pointer;
      transition: color 0.2s ease, border-color 0.2s ease;
    }

    .shop-sidebar-{{ section.id }} .filters__item--pills .checkbox:hover{
      border-color: var(--gsc-f-accent);
      color: var(--gsc-f-accent);
    }

    /* Selected pill: green text + green border, never filled. */
    .shop-sidebar-{{ section.id }} .filters__item--pills .checkbox:has(.checkbox__input:checked){
      border-color: var(--gsc-f-accent);
      color: var(--gsc-f-accent);
    }

    .shop-sidebar-{{ section.id }} .filters__item--pills .checkbox--disabled{
      opacity: 0.35;
      cursor: not-allowed;
    }

    /* ---- Size: YOUTH / SENIOR sub-groups ---- */
    .shop-sidebar-{{ section.id }} .filters__subhead{
      display: flex;
      align-items: center;
      gap: 6px;
      width: 100%;
      margin: 4px 0 2px;
      color: var(--gsc-f-muted);
      font-size: {{ options.filter_subhead_font_size }}px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .shop-sidebar-{{ section.id }} .filters__subhead + .checkbox{
      margin-left: 0;
    }

    /* ---- Checkbox groups: green tick + green text when selected ---- */
    .shop-sidebar-{{ section.id }} .filters__item--checks .checkbox__span--outline{
      border-color: var(--gsc-f-muted);
    }

    .shop-sidebar-{{ section.id }} .filters__item--checks .checkbox__input:checked + .checkbox__span{
      background: transparent;
      border-color: var(--gsc-f-accent);
    }

    .shop-sidebar-{{ section.id }} .filters__item--checks .checkbox__input:checked + .checkbox__span::before{
      border-color: var(--gsc-f-accent);
    }

    .shop-sidebar-{{ section.id }} .filters__item--checks .checkbox:has(.checkbox__input:checked){
      color: var(--gsc-f-accent);
    }

    /* TBG custom code
       Compact panel to match the design: tighter heading/group spacing,
       smaller muted chevrons, visible but soft dividers, slimmer pills and
       tick boxes. Nothing in the panel is hard white. */
    .shop-sidebar-{{ section.id }} .filters__label{
      padding-bottom: 12px;
      font-weight: 600;
    }

    .shop-sidebar-{{ section.id }} .filters__label--top-spacing{
      padding-top: 16px;
    }

    .shop-sidebar-{{ section.id }} .filters__chevron{
      width: 16px;
      height: 16px;
      color: var(--gsc-f-muted);
    }

    /* Open groups get the theme's 32px bottom padding; trim it. The in-stock
       row has no content, so its heading padding alone spaces it. */
    .shop-sidebar-{{ section.id }} .filters__accordeon[data-aria-expanded='true']{
      padding-bottom: 18px;
    }

    .shop-sidebar-{{ section.id }} .filters__item--instock .filters__accordeon{
      padding-bottom: 6px;
    }

    .shop-sidebar-{{ section.id }} .filters__item--bordered + .filters__item--bordered{
      border-top-color: color-mix(in srgb, var(--gsc-f-muted) 30%, transparent);
    }

    .shop-sidebar-{{ section.id }} .filters__options{
      padding-top: 0;
    }

    .shop-sidebar-{{ section.id }} .filters__item--checks .filters__options{
      row-gap: 10px;
    }

    .shop-sidebar-{{ section.id }} .filters__item--checks .checkbox{
      align-items: center;
      column-gap: 10px;
    }

    .shop-sidebar-{{ section.id }} .filters__item--checks .checkbox__span{
      width: 16px;
      height: 16px;
    }

    .shop-sidebar-{{ section.id }} .filters__item--checks .checkbox__span::before{
      top: 1px;
      left: 5px;
      width: 5px;
      height: 9px;
    }

    .shop-sidebar-{{ section.id }} .filters__item--checks .checkbox__span--outline{
      border-color: color-mix(in srgb, var(--gsc-f-muted) 60%, transparent);
    }

    .shop-sidebar-{{ section.id }} .filters__item--pills .checkbox{
      line-height: 1;
      border-color: color-mix(in srgb, var(--gsc-f-muted) 60%, transparent);
    }

    .shop-sidebar-{{ section.id }} .filters__item--pills .checkbox:has(.checkbox__input:checked),
    .shop-sidebar-{{ section.id }} .filters__item--checks .checkbox:has(.checkbox__input:checked){
      font-weight: 600;
    }

    .shop-sidebar-{{ section.id }} .filters__subhead{
      margin: 2px 0 0;
      color: {{ options.filter_heading_color }};
      font-weight: 600;
    }

    .shop-sidebar-{{ section.id }} .filters__subhead::before{
      content: '';
      border-block: 3px solid transparent;
      border-left: 4px solid currentColor;
    }

    /* ---- In stock only: single on/off switch ----
       One row: the group heading on the left, a switch on the right, no
       accordion. The switch drives the filter's "in stock" checkbox (value
       "1"), so only one state can ever be selected. The options list is
       hidden; it stays in the DOM because the theme's form reads it.
       Square, outlined and accent-on to match the pills, not the theme's
       rounded default. */
    /* TBG custom code
       The switch lives inside the heading row, so it centres on the heading
       text's line box. Centred against the whole row it sat low, because the
       heading carries the theme's bottom padding. The heading itself no longer
       toggles anything, so only the switch takes clicks. */
    .shop-sidebar-{{ section.id }} .filters__item--instock .accordeon__btn{
      align-items: center;
      gap: 16px;
      pointer-events: none;
    }

    .shop-sidebar-{{ section.id }} .filters__item--instock .filters__chevron,
    .shop-sidebar-{{ section.id }} .filters__item--instock .accordeon__content-wrap{
      display: none !important;
    }

    /* TBG custom code */
    .shop-sidebar-{{ section.id }} .filters__instock-switch{
      position: relative;
      flex: 0 0 auto;
      margin-left: auto;
      pointer-events: auto;
      width: 44px;
      height: 22px;
      padding: 0;
      border: 1px solid var(--gsc-f-muted);
      background: transparent;
      cursor: pointer;
      transition: border-color 0.2s ease;
    }

    .shop-sidebar-{{ section.id }} .filters__instock-switch::after{
      content: '';
      position: absolute;
      top: 3px;
      left: 3px;
      width: 14px;
      height: 14px;
      background: var(--gsc-f-muted);
      transition: left 0.2s ease, background-color 0.2s ease;
    }

    .shop-sidebar-{{ section.id }} .filters__instock-switch[aria-checked='true']{
      border-color: var(--gsc-f-accent);
    }

    .shop-sidebar-{{ section.id }} .filters__instock-switch[aria-checked='true']::after{
      left: calc(100% - 17px);
      background: var(--gsc-f-accent);
    }

    .shop-sidebar-{{ section.id }} .filters__instock-switch:focus-visible{
      outline: 1px solid var(--gsc-f-accent);
      outline-offset: 2px;
    }

    /* "Availability" label: the theme renders its own switch; restyle it the
       same way instead of adding a second one. */
    .shop-sidebar-{{ section.id }} .filters__item--instock .slider-switch__container{
      width: 44px;
      height: 22px;
      border: 1px solid var(--gsc-f-muted);
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }

    .shop-sidebar-{{ section.id }} .filters__item--instock .slider-switch__toggle{
      top: 3px;
      left: 3px;
      width: 14px;
      height: 14px;
      border: 0;
      border-radius: 0;
      background: var(--gsc-f-muted);
      box-shadow: none;
    }

    .shop-sidebar-{{ section.id }} .filters__item--instock .slider-switch__checkbox:checked + .slider-switch__container{
      border-color: var(--gsc-f-accent);
      background: transparent;
    }

    .shop-sidebar-{{ section.id }} .filters__item--instock .slider-switch__checkbox:checked + .slider-switch__container .slider-switch__toggle{
      left: calc(100% - 17px);
      background: var(--gsc-f-accent);
    }

    /* ---------------------------------------------------------------
       Battlegear product card.

       The product image is already transparent, so the card is a flat
       panel with the image sitting directly on it.
       --------------------------------------------------------------- */

    .section-{{ section.id }} .bg-card{
      --gsc-bg-card-accent: {{ options.card_accent_color }};
      --gsc-bg-card-muted: {{ options.card_muted_color }};
      height: 100%;
      background: {{ options.card_background }};
    }

    .section-{{ section.id }} .bg-card{
      display: flex;
      flex-direction: column;
    }

    .section-{{ section.id }} .bg-card__content{
      color: {{ options.card_text_color }};
      text-decoration: none;
    }

    .section-{{ section.id }} .bg-card__media-wrap{
      position: relative;
      overflow: hidden;
    }

    .section-{{ section.id }} .bg-card__media-link{
      display: block;
    }

    .section-{{ section.id }} .bg-card__media{
      position: relative;
      aspect-ratio: 1 / 1;
    }

    .section-{{ section.id }} .bg-card__image{
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    /* Zoom on hover, matching the theme's own img_hover setting. */
    .section-{{ section.id }} .bg-card--zoom .bg-card__image{
      transition: transform 0.4s ease;
    }

    .section-{{ section.id }} .bg-card--zoom:hover .bg-card__image{
      transform: scale(1.06);
    }

    .section-{{ section.id }} .bg-card--sold-out .bg-card__media{
      opacity: 0.5;
    }

    /*
     * Quick view is deliberately unstyled here: the card reuses the theme's
     * own `product-card__btn` markup so the theme's stylesheet positions and
     * reveals it. Restyling it was never part of this redesign.
     */

    /* ---- Corner badges ---- */
    /*
     * Badge text and colour come from the product's own metafields
     * (`theme.label`, `theme.label_color`, `custom.product_label_text_color`),
     * applied inline by the card. The rules here only set the shape, so an
     * inline colour always wins; the colours below are the fallbacks used
     * when a product sets no colour of its own.
     *
     * `theme.label` is a list, so the stack handles a product with several.
     */
    .section-{{ section.id }} .bg-card__badges{
      position: absolute;
      top: 0;
      left: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }

    .section-{{ section.id }} .bg-card__badge{
      padding: 4px 10px;
      color: #000;
      background: var(--gsc-bg-card-accent);
      font-size: {{ options.card_badge_font_size }}px;
      font-weight: 700;
      letter-spacing: 0.04em;
      line-height: 1.2;
      text-transform: uppercase;
      white-space: nowrap;
    }

    /* Labels are outlined: coloured border + text, never a fill. */
    .section-{{ section.id }} .bg-card__badge--label{
      border: 1px solid {{ options.card_badge_new_color }};
      color: {{ options.card_badge_label_text_color }};
      background: transparent;
    }

    .section-{{ section.id }} .bg-card__badge--sale{
      color: #000;
      background: var(--gsc-bg-card-accent);
    }

    .section-{{ section.id }} .bg-card__badge--sold-out{
      color: #fff;
      background: {{ options.card_muted_color }};
    }

    /* ---- Content ---- */
    .section-{{ section.id }} .bg-card__content{
      display: flex;
      flex-direction: column;
      gap: {{ options.card_content_gap }}px;
      padding: {{ options.card_content_padding }}px;
    }

    /* Attribute pill: long segment + short generation chip. */
    .section-{{ section.id }} .bg-card__pill{
      display: flex;
      align-items: stretch;
      gap: 2px;
      width: fit-content;
      max-width: 100%;
    }

    .section-{{ section.id }} .bg-card__pill-main,
    .section-{{ section.id }} .bg-card__pill-gen{
      padding: 2px 7px;
      border: 1px solid {{ options.card_pill_main_color }};
      font-size: {{ options.card_pill_font_size }}px;
      font-weight: 600;
      letter-spacing: 0.04em;
      line-height: 1.3;
      text-transform: uppercase;
      white-space: nowrap;
    }

    /* TBG custom code: one pill colour = attribute fill + both borders + gen text; attribute text separate. */
    .section-{{ section.id }} .bg-card__pill-main{
      color: {{ options.card_pill_text_color }};
      background: {{ options.card_pill_main_color }};
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .section-{{ section.id }} .bg-card__pill-gen{
      color: {{ options.card_pill_main_color }};
      background: transparent;
    }

    .section-{{ section.id }} .bg-card__title{
      margin: 0;
      font-size: {{ options.card_title_font_size }}px;
      font-weight: 700;
      letter-spacing: 0.01em;
      line-height: 1.05;
      text-transform: uppercase;
    }

    .section-{{ section.id }} .bg-card__color{
      color: var(--gsc-bg-card-muted);
      font-size: {{ options.card_color_font_size }}px;
      letter-spacing: 0.02em;
      line-height: 1.2;
      text-transform: uppercase;
    }

    /* ---- Price: muted by default, accent when discounted ---- */
    .section-{{ section.id }} .bg-card__price{
      display: flex;
      align-items: baseline;
      gap: 8px;
      margin-top: 2px;
      font-size: {{ options.card_price_font_size }}px;
      font-weight: 700;
    }

    .section-{{ section.id }} .bg-card__price-current{
      color: {{ options.card_price_color }};
    }

    .section-{{ section.id }} .bg-card__price--on-sale .bg-card__price-current{
      color: var(--gsc-bg-card-accent);
    }

    .section-{{ section.id }} .bg-card__price-compare{
      color: var(--gsc-bg-card-muted);
      font-weight: 400;
      text-decoration: line-through;
    }


    @media {% render 'media-queries', screen: 'md' %} {
        .section-{{ section.id }}{
          --gsc-space-between-cards: var(--gsc-gap-{{ space_between_cards }});  
        }
    }

    {% endstyle %}
{% endcapture %}

{% render 'inline-css-minifier', css: css %}

{% if enable_filtering %}
  <sidebar-filters-sticky-mobile-button class='shop-mobile-filters-button'>
    <button
      data-sidebar-button
      class='unstyled-button shop-mobile-filters-button__btn'
      aria-label='{{ 'shop.screen_reader.label_for_filters_toggler' | t }}'
      data-sidebar-id='SidebarFiltersMobile'
    >
      {% render 'icon', icon_name: 'filter-toggle' %}
      <span class='shop-mobile-filters-button__btn-label'>
        {{ 'shop.store_front.label_for_filters_toggler' | t }}
      </span>
    </button>
  </sidebar-filters-sticky-mobile-button>
{% endif %}

<shop-component
  class='shop {% if round_level != 'default' %}round-level-{{round_level}}{% endif %} section section-{{ section.id }} color-{{ color_scheme }} spacing-block {% if add_mobile_side_paddings %}spacing-inline-mobile{% endif %} {% if add_desktop_side_paddings %}spacing-inline-desktop{% endif %} {% if color_container_background == false %}section-background{% endif %}'
  data-section-id='{{ section.id }}'
  data-column-switcher-target
>
  <div class='shop__container container container--{{ container_size }} {% if color_container_background %}container-background{% endif %}'>
    {%- if heading != blank or toggle_blocks.size > 0 -%}
      <div class='{% if color_container_background == false and add_desktop_side_paddings == false or add_mobile_side_paddings == false  %}spacing-inline-header{% endif %} shop-age__bar'>
        {%- if heading != blank -%}
          <h2 class='shop-age__heading {{ options.heading_size }}'>{{ heading }}</h2>
        {%- else -%}
          <span class='shop-age__heading-spacer'></span>
        {%- endif -%}

        {%- if toggle_blocks.size > 0 -%}
          <div class='shop-age__toggle' role='group' aria-label='{{ options.toggle_aria_label | escape }}'>
            {%- for block in toggle_blocks -%}
              {%- liquid
                comment
                  A `collection` setting resolves to the collection object
                  itself, so use it directly rather than looking it up.
                endcomment
                assign block_collection = block.settings.collection
                assign block_url = block_collection.url

                comment
                  The link for the collection currently being viewed is the
                  active one. Compare handles rather than URLs so a tag or
                  filter in the address does not break the match.
                endcomment
                assign is_active = false
                if block_collection != blank and block_collection.handle == collection.handle
                  assign is_active = true
                endif

                assign block_label = block.settings.label | default: block_collection.title
              -%}
              {%- if block_url != blank -%}
                <a
                  class='shop-age__option{% if is_active %} is-active{% endif %}'
                  href='{{ block_url }}'
                  {% if is_active %}aria-current='page'{% endif %}
                >
                  {{- block_label -}}
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if enable_sorting -%}
          <div class='shop-age__sort'>
            {% render 'sort-list', results: collection %}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class='{% if color_container_background == false and add_desktop_side_paddings == false or add_mobile_side_paddings == false  %}spacing-inline-header{% endif %} shop__header {% if filters_position == 'right' %} shop__header--reverse {% endif %}'>
      <div
        class='shop__header-left-panel {% if filters_position == 'right' %} shop__header-left-panel--reverse {% endif %} {% if enable_content_slide_in %}scroll-trigger animate--slide-in{% endif %}'
        {% if enable_content_slide_in %}
          style='--gsc-animation-order: 1;'
          data-remove-animation-class
        {% endif %}
      >
        {%- if enable_filtering or enable_sorting -%}
          {%- if enable_filtering -%}
            <sidebar-button class='shop__filters-btn-wrapper shop__filters-btn-wrapper--desktop'>
              <button
                data-sidebar-button
                class='unstyled-button shop__icon-btn shop__filters-btn {% if filter_style == 'open-embed' %} is-opened {% endif %}'
                aria-label='{{ 'shop.screen_reader.label_for_filters_toggler' | t }}'
                data-sidebar-id='SidebarFiltersDesktop'
              >
                {% render 'icon', icon_name: 'filter-toggle' %}
                <span class='shop__filters-btn-label'>
                  {{ 'shop.store_front.label_for_filters_toggler' | t }}
                </span>
              </button>
            </sidebar-button>

            <sidebar-button class='shop__filters-btn-wrapper shop__filters-btn-wrapper--mobile'>
              <button
                data-sidebar-button
                class='unstyled-button shop__icon-btn shop__filters-btn '
                aria-label='{{ 'shop.screen_reader.label_for_filters_toggler' | t }}'
                data-sidebar-id='SidebarFiltersMobile'
              >
                {% render 'icon', icon_name: 'filter-toggle' %}
                <span class='shop__filters-btn-label'>
                  {{ 'shop.store_front.label_for_filters_toggler' | t }}
                </span>
              </button>
            </sidebar-button>
          {%- endif -%}

          {%- comment -%}
            Sorting renders in the age bar above; only fall back to the
            original slot when that bar is not rendered.
          {%- endcomment -%}
          {%- if enable_sorting and heading == blank and toggle_blocks.size == 0 -%}
