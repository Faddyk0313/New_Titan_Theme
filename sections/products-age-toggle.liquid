                data-column-switcher-item
                tabindex='0'
                data-value='{{ column_switch }}'
              >
                {%- for i in (1..column_switch) -%}
                  <span></span>
                {%- endfor -%}
              </div>
            {%- endfor -%}
          </column-switcher>
        {%- endif -%}
