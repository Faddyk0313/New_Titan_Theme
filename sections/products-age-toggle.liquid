</script>

<script>
  /*
   * Age toggle.
   *
   * Routes clicks through the existing <shop-component>, the same path the
   * sidebar filters use, so the grid, the result count, the sort list and the
   * filters all re-render in place instead of reloading the page. The anchors
   * carry real hrefs, so this is progressive enhancement: without JS, or
   * before it boots, clicking still works as a normal navigation.
   */
  ;(() => {
    if (window.customElements.get('age-toggle')) return

    class AgeToggle extends HTMLElement {
      connectedCallback() {
        this.addEventListener('click', this.handleClick)
      }

      disconnectedCallback() {
        this.removeEventListener('click', this.handleClick)
      }

      /*
       * The toggle and the sidebar both render the same tag filter, which
       * would let them disagree. Hide that one filter group in the sidebar
       * by matching its label, and re-hide it after every filter re-render.
       */

      handleClick = (event) => {
        const option = event.target.closest('[data-age-option]')
        if (!option || option.classList.contains('is-active')) {
          // A click on the already-active option does nothing.
          if (option) event.preventDefault()
          return
        }

        const shop = document.querySelector('shop-component')
        // No shop component (or it has not upgraded yet): fall back to a
        // normal link navigation rather than swallowing the click.
        if (!shop || typeof shop.updateShop !== 'function') return

        const href = option.getAttribute('href') || ''
        if (!href) return

        event.preventDefault()
        this.setActive(option)

        /*
         * The selection lives in the URL *path* (a collection tag route),
         * not the query string, so shop.updateBySearchParams cannot be used:
         * it rebuilds the URL from window.location.pathname and would drop
         * the tag, re-rendering the very same products.
         *
         * Drive the same pipeline with the full href, and push that URL so
         * refresh, back/forward and sharing all keep the selection.
         */
        const queryIndex = href.indexOf('?')
        const searchParams = queryIndex === -1 ? '' : href.slice(queryIndex + 1)

        history.pushState({ searchParams }, '', href)
        shop.updateShop(href)
        if (typeof shop.updateFilters === 'function') shop.updateFilters(href)
      }

      setActive(activeOption) {
        this.querySelectorAll('[data-age-option]').forEach((item) => {
          const isActive = item === activeOption
          item.classList.toggle('is-active', isActive)
          item.setAttribute('aria-pressed', String(isActive))
        })
      }
    }

    window.customElements.define('age-toggle', AgeToggle)
  })()
</script>

<script>
  /*
   * Filter sidebar enhancements.
   *
   * The sidebar markup is produced by the shared desktop-filters /
   * mobile-filters snippets, which the stock products section also renders,
   * so those files are left untouched. This script only tags and lightly
   * restructures the markup inside THIS section's sidebars:
   *
   *   1. Tags each filter group with a class derived from its label, so the
   *      scoped CSS can style groups individually. The snippets emit no
   *      per-filter identifier, so the label is the only usable hook.
   *   2. Splits the Size options into YOUTH / SENIOR sub-groups by prefix.
   *   3. Replaces the In-stock toggle switch with Yes / No pills.
   *
   * Filters are re-rendered wholesale on every update, so this runs again
   * whenever the shop component reports new filter markup.
   */
  ;(() => {
    const SECTION_ID = '{{ section.id }}'
    const PILL_LABELS = {{ options.filter_pill_groups | json }}
    const SIZE_LABEL = {{ options.filter_size_label | json }}
    const INSTOCK_LABEL = {{ options.filter_instock_label | json }}
    const SIZE_GROUPS = {{ options.filter_size_groups | json }}
    const YES_LABEL = {{ options.filter_instock_yes | json }}
    const NO_LABEL = {{ options.filter_instock_no | json }}

    const norm = (value) => (value || '').trim().toLowerCase()
    const pillLabels = PILL_LABELS.split(',').map(norm).filter(Boolean)

    // "YOUTH:YTH-, SENIOR:SR-" -> [{heading, prefix}]
    const sizeGroups = SIZE_GROUPS.split(',')
      .map((part) => {
        const pieces = part.split(':')
        if (pieces.length < 2) return null
        const heading = pieces[0].trim()
        const prefix = norm(pieces[1])
        if (!heading || !prefix) return null
        return { heading, prefix }
      })
      .filter(Boolean)

    function groupLabel(item) {
      const label = item.querySelector('.filters__label')
      if (!label) return ''
      // The label also holds the active-count, e.g. "Size (2)".
      return norm((label.textContent || '').replace(/\(\d+\)/g, ''))
    }

    function tagGroups(root) {
      root.querySelectorAll('.filters__item').forEach((item) => {
        const label = groupLabel(item)
        if (!label) return

        if (INSTOCK_LABEL && label.startsWith(norm(INSTOCK_LABEL))) {
          item.classList.add('filters__item--instock')
          buildInStockPills(item)
          return
        }

        const isPill = pillLabels.some((candidate) => label.startsWith(candidate))
        item.classList.add(isPill ? 'filters__item--pills' : 'filters__item--checks')

        if (SIZE_LABEL && label.startsWith(norm(SIZE_LABEL))) buildSizeSubgroups(item)
      })
    }

    function buildSizeSubgroups(item) {
      const list = item.querySelector('.filters__options')
      if (!list || !sizeGroups.length || list.dataset.subgrouped === 'true') return

      const options = Array.from(list.querySelectorAll('.checkbox'))
      if (!options.length) return

      const buckets = sizeGroups.map((group) => ({
        heading: group.heading,
        prefix: group.prefix,
        items: [],
      }))
      const ungrouped = []

      options.forEach((option) => {
        const text = norm(option.textContent)
        const bucket = buckets.find((candidate) => text.indexOf(candidate.prefix) === 0)
        if (bucket) bucket.items.push(option)
        else ungrouped.push(option)
      })

      // Nothing matched a prefix: leave the list exactly as it was.
      if (!buckets.some((bucket) => bucket.items.length)) return

      const fragment = document.createDocumentFragment()
      buckets.forEach((bucket) => {
        if (!bucket.items.length) return
        const heading = document.createElement('div')
        heading.className = 'filters__subhead'
        heading.textContent = bucket.heading
        fragment.appendChild(heading)
        bucket.items.forEach((option) => fragment.appendChild(option))
      })
      ungrouped.forEach((option) => fragment.appendChild(option))

      // Keep any show-more control last.
      const more = list.querySelector('.filters__more')
      list.insertBefore(fragment, more || null)
      list.dataset.subgrouped = 'true'
    }

    function buildInStockPills(item) {
      const input = item.querySelector('.slider-switch__checkbox')
      if (!input || item.querySelector('.filters__instock')) return

      const wrap = document.createElement('div')
      wrap.className = 'filters__instock'

      /*
       * "Yes" mirrors the underlying checkbox, "No" clears it. The theme's
       * filter form listens for a native change event, so dispatch one
       * rather than calling into its internals.
       */
      const makeOption = (text, checked) => {
        const option = document.createElement('button')
        option.type = 'button'
        option.className = 'filters__instock-option'
        option.textContent = text
        option.classList.toggle('is-active', input.checked === checked)
        option.addEventListener('click', () => {
          if (input.checked === checked) return
          input.checked = checked
          input.dispatchEvent(new Event('change', { bubbles: true }))
        })
        return option
      }

      wrap.appendChild(makeOption(YES_LABEL, true))
      wrap.appendChild(makeOption(NO_LABEL, false))

      const label = item.querySelector('.filters__label')
      if (label) label.insertAdjacentElement('afterend', wrap)
    }

    function enhance() {
      document
        .querySelectorAll('#SidebarFiltersDesktop, #SidebarFiltersMobile')
        .forEach((sidebar) => {
          sidebar.classList.add('shop-sidebar-' + SECTION_ID)
          tagGroups(sidebar)

          /*
           * The mobile sidebar keeps its markup in a <template>, which is
           * inert and invisible to the selectors above until the drawer is
           * opened and the content cloned. Process the template content too
           * so the first open already shows the right styling.
           */
          sidebar.querySelectorAll('template').forEach((tpl) => {
            if (tpl.content) tagGroups(tpl.content)
          })
        })
    }

    const run = () => {
      enhance()

      const shop = document.querySelector('shop-component')
      // Re-apply after every filter re-render.
      if (shop && typeof shop.on === 'function') shop.on('filtersUpdated', enhance)

      /*
       * The drawer clones its template on open, so the live nodes are new
       * every time. Re-run on any click that could open a filter sidebar.
       */
      document.addEventListener('click', (event) => {
        if (!event.target.closest('[data-sidebar-button]')) return
        requestAnimationFrame(enhance)
      })
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run, { once: true })
    } else {
      run()
    }
  })()
</script>


