<script>
  /*
   * Filter sidebar enhancements.
   *
   * The sidebar markup is produced by the shared desktop-filters /
   * mobile-filters snippets, which the stock products section also renders,
   * so those files are left untouched. This script only tags and lightly
   * restructures the markup inside THIS section's sidebars:
   *
   *   1. Tags each filter group with a class derived from its label, so the
   *      scoped CSS can style groups individually. The snippets emit no
   *      per-filter identifier, so the label is the only usable hook.
   *   2. Splits the Size options into YOUTH / SENIOR sub-groups by prefix.
   *   3. Replaces the In-stock toggle switch with Yes / No pills.
   *
   * Filters are re-rendered wholesale on every update, so this runs again
   * whenever the shop component reports new filter markup.
   */
  ;(() => {
    const SECTION_ID = '{{ section.id }}'
    const PILL_LABELS = {{ options.filter_pill_groups | json }}
    const SIZE_LABEL = {{ options.filter_size_label | json }}
    const INSTOCK_LABEL = {{ options.filter_instock_label | json }}
    const SIZE_GROUPS = {{ options.filter_size_groups | json }}

    const norm = (value) => (value || '').trim().toLowerCase()
    const pillLabels = PILL_LABELS.split(',').map(norm).filter(Boolean)

    // "YOUTH:YTH-, SENIOR:SR-" -> [{heading, prefix}]
    const sizeGroups = SIZE_GROUPS.split(',')
      .map((part) => {
        const pieces = part.split(':')
        if (pieces.length < 2) return null
        const heading = pieces[0].trim()
        const prefix = norm(pieces[1])
        if (!heading || !prefix) return null
        return { heading, prefix }
      })
      .filter(Boolean)

    function groupLabel(item) {
      const label = item.querySelector('.filters__label')
      if (!label) return ''
      // The label also holds the active-count, e.g. "Size (2)".
      return norm((label.textContent || '').replace(/\(\d+\)/g, ''))
    }

    function tagGroups(root) {
      root.querySelectorAll('.filters__item').forEach((item) => {
        const label = groupLabel(item)
        if (!label) return

        if (INSTOCK_LABEL && label.startsWith(norm(INSTOCK_LABEL))) {
          item.classList.add('filters__item--instock')
          buildInStockSwitch(item)
          return
        }

        const isPill = pillLabels.some((candidate) => label.startsWith(candidate))
        item.classList.add(isPill ? 'filters__item--pills' : 'filters__item--checks')

        if (SIZE_LABEL && label.startsWith(norm(SIZE_LABEL))) buildSizeSubgroups(item)
      })
    }

    function buildSizeSubgroups(item) {
      const list = item.querySelector('.filters__options')
      if (!list || !sizeGroups.length || list.dataset.subgrouped === 'true') return

      const options = Array.from(list.querySelectorAll('.checkbox'))
      if (!options.length) return

      const buckets = sizeGroups.map((group) => ({
        heading: group.heading,
        prefix: group.prefix,
        items: [],
      }))
      const ungrouped = []

      options.forEach((option) => {
        const text = norm(option.textContent)
        const bucket = buckets.find((candidate) => text.indexOf(candidate.prefix) === 0)
        if (bucket) bucket.items.push(option)
        else ungrouped.push(option)
      })

      // Nothing matched a prefix: leave the list exactly as it was.
      if (!buckets.some((bucket) => bucket.items.length)) return

      const fragment = document.createDocumentFragment()
      buckets.forEach((bucket) => {
        if (!bucket.items.length) return
        const heading = document.createElement('div')
        heading.className = 'filters__subhead'
        heading.textContent = bucket.heading
        fragment.appendChild(heading)
        bucket.items.forEach((option) => fragment.appendChild(option))
      })
      ungrouped.forEach((option) => fragment.appendChild(option))

      // Keep any show-more control last.
      const more = list.querySelector('.filters__more')
      list.insertBefore(fragment, more || null)
      list.dataset.subgrouped = 'true'
    }

    // TBG custom code
    function buildInStockSwitch(item) {
      /*
       * One on/off switch instead of Yes / No checkboxes, so the filter can
       * never be multi-selected.
       *
       * Labelled "Availability" exactly, the theme already renders a slider
       * switch (desktop-filters.liquid); the CSS restyles that and there is
       * nothing to build. Any other label, including "In stock only", is a
       * metafield filter rendered as two checkboxes: value "1" = in stock,
       * "0" = out of stock. The switch drives the "1" box only.
       */
      if (item.querySelector('.slider-switch__checkbox')) return
      if (item.querySelector('.filters__instock-switch')) return

      const inputs = Array.from(item.querySelectorAll('.checkbox__input'))
      const yes = inputs.find((input) => ['1', 'true'].includes((input.value || '').trim()))
      const header = item.querySelector('.accordeon__btn, .filters__label')
      if (!yes || !header) return

      // The heading is no longer a toggle: keep it out of the tab order.
      header.setAttribute('tabindex', '-1')

      const toggle = document.createElement('button')
      toggle.type = 'button'
      toggle.className = 'filters__instock-switch'
      toggle.setAttribute('role', 'switch')
      toggle.setAttribute('aria-checked', String(yes.checked))
      toggle.setAttribute('aria-label', (header.textContent || '').trim())

      // TBG custom code
      // The switch sits inside the theme's accordion heading: keep its clicks
      // and keys from reaching the accordion, which would otherwise toggle
      // (and swallow Space).
      toggle.addEventListener('keydown', (event) => event.stopPropagation())
      toggle.addEventListener('click', (event) => {
        event.stopPropagation()
        // An old URL may still carry the out-of-stock value; clear it so the
        // switch is the only state submitted.
        inputs.forEach((input) => {
          if (input !== yes) input.checked = false
        })
        // click() toggles the real checkbox and fires the native input and
        // change events the theme's filter form listens for.
        yes.click()
        toggle.setAttribute('aria-checked', String(yes.checked))
      })

      // TBG custom code: inside the heading row, so it centres on the text.
      header.appendChild(toggle)
    }

    function enhance() {
      document
        .querySelectorAll('#SidebarFiltersDesktop, #SidebarFiltersMobile')
        .forEach((sidebar) => {
          sidebar.classList.add('shop-sidebar-' + SECTION_ID)
          tagGroups(sidebar)

          /*
           * The mobile sidebar keeps its markup in a <template>, which is
           * inert and invisible to the selectors above until the drawer is
           * opened and the content cloned. Process the template content too
           * so the first open already shows the right styling.
           */
          sidebar.querySelectorAll('template').forEach((tpl) => {
            if (tpl.content) tagGroups(tpl.content)
          })
        })
    }

    const run = () => {
      enhance()

      const shop = document.querySelector('shop-component')
      // Re-apply after every filter re-render.
      if (shop && typeof shop.on === 'function') {
        shop.on('filtersUpdated', enhance)
      }

      /*
       * Unless the filter style is 'open-embed', each sidebar keeps its
       * markup in a <template> and clones it when opened, so the live nodes
       * are brand new every time and appear asynchronously. A click handler
       * with requestAnimationFrame fires too early to catch them, so watch
       * each sidebar for inserted nodes instead and re-tag when they land.
       */
      const observer = new MutationObserver((records) => {
        const addedElement = records.some((record) =>
          Array.from(record.addedNodes).some((node) => node.nodeType === 1)
        )
        if (addedElement) enhance()
      })

      document
        .querySelectorAll('#SidebarFiltersDesktop, #SidebarFiltersMobile')
        .forEach((sidebar) => observer.observe(sidebar, { childList: true, subtree: true }))
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run, { once: true })
    } else {
      run()
    }
  })()
</script>


{% render 'save-section-data-in-global-scope', section: section %}

{% schema %}
{
  "name": "Products with age toggle",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Heading & age toggle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Battlegear",
      "info": "Shown at the top left of the section. Leave empty to hide."
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h3",
      "label": "Heading size"
    },
    {
      "type": "text",
      "id": "toggle_aria_label",
      "label": "Toggle accessibility label",
      "default": "Age group",
      "info": "Describes the link group to screen readers."
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "checkbox",
      "id": "use_battlegear_card",
      "default": true,
      "label": "Use the Battlegear card",
      "info": "Off falls back to the theme's standard product card. Both cards use the same hover behaviour and quick-view button, so this only changes the card's layout."
    },
    {
      "type": "text",
      "id": "card_namespace",
      "label": "Metafield namespace",
      "default": "custom",
      "info": "Namespace holding card_attributes, card_generation and card_color. Each falls back to data derived from the product, so the card works before they exist."
    },
    {
      "type": "text",
      "id": "card_descriptor",
      "label": "Attribute pill descriptor",
      "default": "CUT-RESISTANT",
      "info": "Appended after the age group in the pill, e.g. 'SENIOR | CUT-RESISTANT'. Only used until the card_attributes metafield is set."
    },
    {
      "type": "header",
      "content": "Product card appearance"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
