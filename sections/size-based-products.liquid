{%- liquid
  assign options = section.settings
  assign add_side_paddings = options.add_side_paddings
  assign section_spacing_top = options.section_spacing_top
  assign section_spacing_bottom = options.section_spacing_bottom
  assign color_scheme = options.color_scheme
  assign container_size = options.container_size
  assign heading = options.heading
  assign subheading = options.subheading
  assign button_text = options.buttonText
  assign preselected_size = options.preselected_size
  assign carousel_heading = options.carousel_heading
  assign carousel_heading_template = options.carousel_heading_template
  assign img_ratio = options.img_ratio
  assign product_card_align = options.product_card_align
  assign heading_size = options.heading_size
  assign alignment = options.alignment
  assign desktop_columns = options.desktop_columns
  assign mobile_columns = options.mobile_columns
  assign desktop_layout = options.desktop_layout
  assign mobile_layout = options.mobile_layout
  
  comment
    For laptops and tablets, reduce columns from desktop setting
  endcomment
  assign laptop_columns = desktop_columns | minus: 1
  if laptop_columns < 2
    assign laptop_columns = 2
  endif
  
  assign tablet_columns = desktop_columns | minus: 2
  if tablet_columns < 2
    assign tablet_columns = 2
  endif

  assign desktop_space_between_cards = options.desktop_space_between_cards | times: 0.1
  assign mobile_space_between_cards = options.mobile_space_between_cards | times: 0.1

  assign show_navigation_on_hover = options.show_navigation_on_hover
  assign autoplay_mode = options.autoplay_mode
  assign autoplay_interval = options.autoplay_interval

  assign product_card_with_bottom_spacing = false
  if settings.round_level != '0'
    assign product_card_with_bottom_spacing = true
  endif

  assign show_mobile_carousel = false
  if mobile_layout == 'carousel'
    assign show_mobile_carousel = false
  else
    assign show_mobile_carousel = true
  endif

  assign enable_content_slide_in = settings.enable_content_slide_in

  assign swatch_patterns = settings.primary_custom_colors_and_patterns
  assign primary_custom_colors_and_patterns = swatch_patterns | newline_to_br | split: '<br />'
-%}

{% capture section_background_color %}
  {% render 'get-section-background-color', section: section %}
{% endcapture %}

{% capture css %}
  {% style %}
    .section-{{section.id}} .container__header {
        --gsc-space-between-cards: {{mobile_space_between_cards}}rem;
        --gsc-columns: {{mobile_columns}};
        --gsc-slide-width: calc((100% - (({{mobile_columns}} - 1) * {{mobile_space_between_cards}}rem)) / {{mobile_columns}});
        --gsc-section-spacing-top: {{ section_spacing_top }}px;
        --gsc-section-spacing-bottom: {{ section_spacing_bottom }}px;
    }

    @media screen and (min-width: 768px) {
        .section-{{section.id}} {
            --gsc-space-between-cards: {{desktop_space_between_cards}}rem;
            --gsc-columns: {{desktop_columns}};
            --gsc-slide-width: calc((100% - (({{desktop_columns}} - 1) * {{desktop_space_between_cards}}rem)) / {{desktop_columns}});
        }
    }

    @media screen and (min-width: 768px) and (max-width: 880px) {
      .section-{{ section.id }} {
        --gsc-columns: {{tablet_columns}};
        --gsc-slide-width: calc((100% - (({{tablet_columns}} - 1) * {{desktop_space_between_cards}}rem)) / {{tablet_columns}});
      }
    }

    @media screen and (min-width: 880px) and (max-width: 1016px) {
      .section-{{ section.id }} {
        --gsc-columns: {{laptop_columns}};
        --gsc-slide-width: calc((100% - (({{laptop_columns}} - 1) * {{desktop_space_between_cards}}rem)) / {{laptop_columns}});
      }
    }

    .section-{{section.id}} .container__header {
      margin-bottom: 16px;
    }

    .section-template--19430489129138__size_based_products_y9PAj4 .container.first {
      display: flex !important;
      flex-direction: column !important;
    }

    .size-selector-{{section.id}} {
      margin: 20px 0;
      display: inline-block;
      align-self: center;
    }
    
    .size-selector-wrapper-{{section.id}} {
      position: relative;
      display: inline-block;
      width: 100%;
      max-width: 250px;
    }
    
    .size-selector-{{section.id}} select {
      width: 100%;
      padding: 10px 40px 10px 16px;
      font-size: 15px;
      font-weight: 500;
      border: 2px solid #333;
      background-color: #fff;
      cursor: pointer;
      appearance: none;
      -webkit-appearance: none;
      -moz-appearance: none;
      transition: all 0.3s ease;
      color: #333;
    }
    
    .size-selector-{{section.id}} select:hover {
      border-color: #000;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }
    
    .size-selector-{{section.id}} select:focus {
      outline: none;
      border-color: #000;
      box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.1);
    }
    
    .select-arrow-{{section.id}} {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      pointer-events: none;
      width: 0;
      height: 0;
      border-left: 6px solid transparent;
      border-right: 6px solid transparent;
      border-top: 8px solid #333;
      transition: all 0.3s ease;
    }
    
    .size-selector-wrapper-{{section.id}}:hover .select-arrow-{{section.id}} {
      border-top-color: #000;
    }
    
    @media (max-width: 767px) {
      .size-selector-wrapper-{{section.id}} {
        max-width: 100%;
      }
    }
    
    .products-carousel-wrapper-{{section.id}} {
      display: none;
    }

    .products-carousel-wrapper-{{section.id}}.active {
      display: block;
    }

    .all-products-storage-{{section.id}} {
      position: absolute !important;
      width: 1px !important;
      height: 1px !important;
      padding: 0 !important;
      margin: -1px !important;
      overflow: hidden !important;
      clip: rect(0, 0, 0, 0) !important;
      white-space: nowrap !important;
      border: 0 !important;
    }

    .no-products-message-{{section.id}} {
      padding: 40px 20px;
      text-align: center;
      color: #666;
      font-size: 16px;
      display: none;
    }
    
    .no-products-message-{{section.id}}.visible {
      display: block;
    }

    
  {% endstyle %}
{% endcapture %}

{% render 'inline-css-minifier', css: css %}

<div class='collection section section-{{ section.id }} color-{{ color_scheme }}'>
  <div class='collection__container container first container--{{ container_size }} section-spacing {% if add_side_paddings == true %}container--with-aside-paddings{% endif %}'>
    
    {%- if heading != blank -%}
      <div class='container__header collection__header {% if alignment == 'center' %} collection__header--center {% elsif alignment == 'right' %} collection__header--right {% endif %} {% if enable_content_slide_in %}scroll-trigger animate--slide-in{% endif %}'
        {% if enable_content_slide_in %}
          style='--gsc-animation-order: 1;'
        {% endif %}
      >
        <h2 class='collection__title {{ heading_size }}'>{{ heading }}</h2>
      </div>
    {%- endif -%}
    
    {% if subheading != blank %}
      <p class="section-subheading" style="text-align: {{ alignment }}; margin-top: 10px;">{{ subheading }}</p>
    {% endif %}
    
    <div class="size-selector-{{section.id}}" style="text-align: {{ alignment }};">
      <div class="size-selector-wrapper-{{section.id}}">
        <select id="size-selector-{{section.id}}" aria-label="Select size">
          <option value="" {% if preselected_size == blank %}selected{% endif %}>{{ button_text }}</option>
          <option value="YTH-XS" {% if preselected_size == "YTH-XS" %}selected{% endif %}>YTH-XS</option>
          <option value="YTH-SM" {% if preselected_size == "YTH-SM" %}selected{% endif %}>YTH-SM</option>
          <option value="YTH-MD" {% if preselected_size == "YTH-MD" %}selected{% endif %}>YTH-MD</option>
          <option value="YTH-LG" {% if preselected_size == "YTH-LG" %}selected{% endif %}>YTH-LG</option>
          <option value="YTH-XL" {% if preselected_size == "YTH-XL" %}selected{% endif %}>YTH-XL</option>
          <option value="SR-MD" {% if preselected_size == "SR-MD" %}selected{% endif %}>SR-MD</option>
          <option value="SR-LG" {% if preselected_size == "SR-LG" %}selected{% endif %}>SR-LG</option>
          <option value="SR-XL" {% if preselected_size == "SR-XL" %}selected{% endif %}>SR-XL</option>
          <option value="SR-2XL" {% if preselected_size == "SR-2XL" %}selected{% endif %}>SR-2XL</option>
          <option value="SR-3XL" {% if preselected_size == "SR-3XL" %}selected{% endif %}>SR-3XL</option>
        </select>
        <span class="select-arrow-{{section.id}}"></span>
      </div>
    </div>
    
    {%- comment -%} Hidden storage for all products {%- endcomment -%}
    <div class="all-products-storage-{{section.id}}" id="all-products-storage-{{section.id}}">
      {% for product in collections.all.products limit: 250 %}
        {% liquid
          assign available_sizes = ""
          assign size_count = 0

          for variant in product.variants
            assign inventory_qty = variant.inventory_quantity | default: 0
            if variant.available and inventory_qty > 0
              assign option_values = ""
              if variant.option1 != blank
                assign option_values = option_values | append: variant.option1 | append: ","
              endif
              if variant.option2 != blank
                assign option_values = option_values | append: variant.option2 | append: ","
              endif
              if variant.option3 != blank
                assign option_values = option_values | append: variant.option3 | append: ","
              endif

              assign sizes_array = "YTH-XS,YTH-SM,YTH-MD,YTH-LG,YTH-XL,SR-MD,SR-LG,SR-XL,SR-2XL,SR-3XL" | split: ","

              for size in sizes_array
                if option_values contains size
                  unless available_sizes contains size
                    if size_count > 0
                      assign available_sizes = available_sizes | append: ","
                    endif
                    assign available_sizes = available_sizes | append: size
                    assign size_count = size_count | plus: 1
                  endunless
                endif
              endfor
            endif
          endfor
        %}

        {% if available_sizes != blank %}
          <div
            class='product-card-storage-item-{{section.id}}'
            data-available-sizes="{{ available_sizes }}"
            data-product-id="{{ product.id }}"
          >
            {%- render 'product-card',
              product: product,
              img_ratio: img_ratio,
              product_card_align: product_card_align,
              add_side_paddings: false,
              with_bottom_spacing: product_card_with_bottom_spacing,
              primary_custom_colors_and_patterns: primary_custom_colors_and_patterns,
              section_background_color: section_background_color,
              show_mobile_carousel: show_mobile_carousel
            -%}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="products-carousel-wrapper-{{section.id}}" id="products-carousel-wrapper-{{section.id}}">
      <div class='container__header collection__header {% if alignment == 'center' %} collection__header--center {% elsif alignment == 'right' %} collection__header--right {% endif %}' style="margin-top: 30px;">
        <h3 class='collection__title {{ heading_size }}' id="carousel-heading-{{section.id}}">
          {{ carousel_heading }}
        </h3>
      </div>

      <div class="no-products-message-{{section.id}}" id="no-products-{{section.id}}">
        No products available in this size.
      </div>

      <slider-grid
        class='slider-grid {% if show_navigation_on_hover %}card-carousel--navigation-on-hover{% endif %}'
        {% if autoplay_mode != 'disabled' %}
          autoplay-mode='{{autoplay_mode}}'
          autoplay-interval='{{autoplay_interval}}'
        {% endif %}
        {% if desktop_layout == 'grid' %}
          desktop-disabled
        {% endif %}
        {% if mobile_layout == 'grid' %}
          mobile-disabled
        {% endif %}
      >
        <div
          slider-grid-track
          class='slider-grid-track slider-grid__d-{% if desktop_layout == 'grid' %}grid{% else %}carousel{% endif %} slider-grid__m-{% if mobile_layout == 'grid' %}one-column{% else %}carousel{% endif %}'
          id='slider-grid-track-{{section.id}}'
        >
          {%- comment -%} Products will be dynamically inserted here by JavaScript {%- endcomment -%}
        </div>

        {% if desktop_layout == 'carousel' %}
          <div class='card-carousel__position-btn-wrap card-carousel__position-btn-wrap--prev {% if img_ratio == 'nature' %} card-carousel__position-btn-wrap--nature-img-ratio {% endif %}'>
            <div class='shape shape--{{ img_ratio }}'>
              <button
                type='button'
                class='carousel-btn card-carousel__carousel-btn card-carousel__carousel-btn--prev'
                data-direction='prev'
                tabindex='0'
                disabled
              >
                {% render 'icon', icon_name: 'chevron', class: 'carousel-btn__icon x-flip' %}
              </button>
            </div>
          </div>

          <div class='card-carousel__position-btn-wrap card-carousel__position-btn-wrap--next {% if img_ratio == 'nature' %} card-carousel__position-btn-wrap--nature-img-ratio {% endif %}'>
            <div class='shape shape--{{ img_ratio }}'>
              <button
                type='button'
                class='carousel-btn card-carousel__carousel-btn card-carousel__carousel-btn--next'
                data-direction='next'
                tabindex='0'
                disabled
              >
                {%- render 'icon', icon_name: 'chevron', class: 'carousel-btn__icon' -%}
              </button>
            </div>
          </div>

          <div
            class='progress-bar progress-bar--with-background card-carousel__progress-bar {% if mobile_layout == 'grid' %}progress-bar--desktop-only{% endif %}'
            data-target='scroll'
          >
            <div class='slider-grid__progress-bar-indicator' slider-grid-progress></div>
          </div>
        {% endif %}
      </slider-grid>
    </div>
    
  </div>
</div>

<script>
(function() {
  const sectionId = '{{ section.id }}';
  const selector = document.getElementById('size-selector-' + sectionId);
  const productStorage = document.getElementById('all-products-storage-' + sectionId);

  const defaultHeading = '{{ carousel_heading }}';
  const headingTemplate = '{{ carousel_heading_template }}';
  const enableSlideIn = {{ enable_content_slide_in | json }};
  const alignment = '{{ alignment }}';
  const headingSize = '{{ heading_size }}';
  const showNavigationOnHover = {{ show_navigation_on_hover | json }};
  const autoplayMode = '{{ autoplay_mode }}';
  const autoplayInterval = '{{ autoplay_interval }}';
  const desktopLayout = '{{ desktop_layout }}';
  const mobileLayout = '{{ mobile_layout }}';
  const imgRatio = '{{ img_ratio }}';
  const preselectedSize = '{{ preselected_size }}';

  // Get icon SVGs upfront (Liquid rendering)
  const chevronIconLeft = `{% render 'icon', icon_name: 'chevron', class: 'carousel-btn__icon x-flip' %}`;
  const chevronIconRight = `{% render 'icon', icon_name: 'chevron', class: 'carousel-btn__icon' %}`;

  // Wait for DOM to be fully loaded
  function initSizeFilter() {
    if (!productStorage) {
      console.warn('Product storage container not found');
      return;
    }

    selector.addEventListener('change', function() {
      const selectedSize = this.value;
      const oldCarouselWrapper = document.getElementById('products-carousel-wrapper-' + sectionId);

      if (!selectedSize) {
        if (oldCarouselWrapper) {
          oldCarouselWrapper.classList.remove('active');
        }
        return;
      }

      // Remove the entire carousel wrapper if it exists
      const carouselParent = oldCarouselWrapper ? oldCarouselWrapper.parentElement : document.querySelector('.section-' + sectionId + ' .container.first');
      if (oldCarouselWrapper) {
        oldCarouselWrapper.remove();
      }

      // Create a new carousel wrapper with fresh HTML
      const newCarouselWrapper = document.createElement('div');
      newCarouselWrapper.className = 'products-carousel-wrapper-' + sectionId + ' active';
      newCarouselWrapper.id = 'products-carousel-wrapper-' + sectionId;

      // Determine alignment classes
      let alignmentClass = '';
      if (alignment === 'center') {
        alignmentClass = 'collection__header--center';
      } else if (alignment === 'right') {
        alignmentClass = 'collection__header--right';
      }

      // Build heading text
      let headingText = defaultHeading;
      if (headingTemplate && headingTemplate.trim() !== '') {
        headingText = headingTemplate.replace('{size}', selectedSize);
      }

      // Build the carousel HTML
      let carouselHTML = `
        <div class='container__header collection__header ${alignmentClass}' style="margin-top: 30px;">
          <h3 class='collection__title ${headingSize}' id="carousel-heading-${sectionId}">${headingText}</h3>
        </div>

        <div class="no-products-message-${sectionId}" id="no-products-${sectionId}">
          No products available in this size.
        </div>

        <slider-grid
          class='slider-grid${showNavigationOnHover ? ' card-carousel--navigation-on-hover' : ''}'
          ${autoplayMode !== 'disabled' ? `autoplay-mode='${autoplayMode}' autoplay-interval='${autoplayInterval}'` : ''}
          ${desktopLayout === 'grid' ? 'desktop-disabled' : ''}
          ${mobileLayout === 'grid' ? 'mobile-disabled' : ''}
        >
          <div
            slider-grid-track
            class='slider-grid-track slider-grid__d-${desktopLayout === 'grid' ? 'grid' : 'carousel'} slider-grid__m-${mobileLayout === 'grid' ? 'one-column' : 'carousel'}'
            id='slider-grid-track-${sectionId}'
          >`;

      // Get all products from storage
      const allStoredProducts = productStorage.querySelectorAll('.product-card-storage-item-' + sectionId);
      let visibleCount = 0;
      let animationOrder = 1;

      // Build product cards HTML
      let productsHTML = '';
      allStoredProducts.forEach(storageItem => {
        const availableSizes = storageItem.getAttribute('data-available-sizes');
        if (availableSizes && availableSizes.split(',').includes(selectedSize)) {
          let slideClasses = 'slider-grid__slide cus';
          let slideStyle = '';

          if (enableSlideIn) {
            slideClasses += ' scroll-trigger animate--slide-in';
            slideStyle = ` style='--gsc-animation-order: ${animationOrder}'`;
          }

          productsHTML += `<div class='${slideClasses}'${slideStyle} slider-grid-slide data-available-sizes="${availableSizes}">`;
          productsHTML += storageItem.innerHTML;
          productsHTML += '</div>';
          visibleCount++;
          animationOrder++;
        }
      });

      carouselHTML += productsHTML;
      carouselHTML += `</div>`;

      // Add navigation buttons for carousel layout
      if (desktopLayout === 'carousel') {
        const natureClass = imgRatio === 'nature' ? ' card-carousel__position-btn-wrap--nature-img-ratio' : '';

        carouselHTML += `
          <div class='card-carousel__position-btn-wrap card-carousel__position-btn-wrap--prev${natureClass}'>
            <div class='shape shape--${imgRatio}'>
              <button
                type='button'
                class='carousel-btn card-carousel__carousel-btn card-carousel__carousel-btn--prev'
                data-direction='prev'
                tabindex='0'
              >
                ${chevronIconLeft}
              </button>
            </div>
          </div>

          <div class='card-carousel__position-btn-wrap card-carousel__position-btn-wrap--next${natureClass}'>
            <div class='shape shape--${imgRatio}'>
              <button
                type='button'
                class='carousel-btn card-carousel__carousel-btn card-carousel__carousel-btn--next'
                data-direction='next'
                tabindex='0'
              >
                ${chevronIconRight}
              </button>
            </div>
          </div>

          <div
            class='progress-bar progress-bar--with-background card-carousel__progress-bar${mobileLayout === 'grid' ? ' progress-bar--desktop-only' : ''}'
            data-target='scroll'
          >
            <div class='slider-grid__progress-bar-indicator' slider-grid-progress></div>
          </div>`;
      }

      carouselHTML += `</slider-grid>`;

      newCarouselWrapper.innerHTML = carouselHTML;
      carouselParent.appendChild(newCarouselWrapper);

      // Show/hide no products message
      const newNoProductsMsg = document.getElementById('no-products-' + sectionId);
      if (visibleCount === 0) {
        newNoProductsMsg.classList.add('visible');
      } else {
        newNoProductsMsg.classList.remove('visible');
      }
    });

    // Trigger change event if there's a preselected size
    if (preselectedSize && preselectedSize.trim() !== '') {
      // Small delay to ensure everything is initialized
      setTimeout(() => {
        selector.dispatchEvent(new Event('change'));
      }, 100);
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSizeFilter);
  } else {
    initSizeFilter();
  }
})();
</script>

{% render 'save-section-data-in-global-scope', section: section %}

