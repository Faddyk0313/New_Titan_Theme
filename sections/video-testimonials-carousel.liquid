{%- liquid
  assign options = section.settings
  assign color_scheme = options.color_scheme
  assign container_size = options.container_size
  assign desktop_columns = options.desktop_columns
  assign desktop_space_between_cards = options.desktop_space_between_cards | times: 0.1
  assign mobile_space_between_cards = options.mobile_space_between_cards | times: 0.1

  assign laptop_columns = desktop_columns | minus: 1
  if laptop_columns < 2
    assign laptop_columns = 2
  endif

  assign tablet_columns = desktop_columns | minus: 2
  if tablet_columns < 2
    assign tablet_columns = 2
  endif

  assign enable_content_slide_in = settings.enable_content_slide_in

  assign overlay_alpha = options.overlay_opacity | divided_by: 100.0
  assign overlay_alpha_mid = overlay_alpha | times: 0.6
-%}

{% capture css %}
  {% style %}
    .section-{{ section.id }} {
      --gsc-space-between-cards: {{ mobile_space_between_cards }}rem;
      --gsc-columns: 1;
      --gsc-slide-width: calc(100% - {{ options.mobile_peek }}%);
      --gsc-section-spacing-top: {{ options.section_spacing_top }}px;
      --gsc-section-spacing-bottom: {{ options.section_spacing_bottom }}px;
      --vtc-text-color: {{ options.card_text_color }};
      --vtc-star-color: {{ options.star_color }};
      --vtc-play-size: {{ options.play_button_size_mobile }}px;
      --vtc-content-padding: {{ options.content_padding_mobile }}px;
      --vtc-stars-size: {{ options.stars_size_mobile }}px;
      --vtc-caption-size: {{ options.caption_size_mobile }}px;
      --vtc-author-size: {{ options.author_size_mobile }}px;
      --vtc-min-height: {{ options.card_min_height }}px;
      --vtc-max-height: {{ options.card_max_height }}px;
    }

    @media screen and (min-width: 768px) {
      .section-{{ section.id }} {
        --gsc-space-between-cards: {{ desktop_space_between_cards }}rem;
        --gsc-columns: {{ desktop_columns }};
        --gsc-slide-width: calc(100% / {{ desktop_columns }});
        --vtc-play-size: {{ options.play_button_size }}px;
        --vtc-content-padding: {{ options.content_padding }}px;
        --vtc-stars-size: {{ options.stars_size }}px;
        --vtc-caption-size: {{ options.caption_size }}px;
        --vtc-author-size: {{ options.author_size }}px;
      }
    }

    @media screen and (min-width: 768px) and (max-width: 880px) {
      .section-{{ section.id }} {
        --gsc-columns: {{ tablet_columns }};
        --gsc-slide-width: calc(100% / {{ tablet_columns }});
      }
    }

    @media screen and (min-width: 880px) and (max-width: 1016px) {
      .section-{{ section.id }} {
        --gsc-columns: {{ laptop_columns }};
        --gsc-slide-width: calc(100% / {{ laptop_columns }});
      }
    }

    .section-{{ section.id }} .container__header {
      margin-bottom: 2.4rem;
      text-align: {{ options.alignment }};
    }

    .section-{{ section.id }} .video-testimonials__heading {
      margin: 0;
      {% if options.heading_color != blank %}color: {{ options.heading_color }};{% endif %}
    }

    .section-{{ section.id }} .video-testimonials__subheading {
      margin: 8px 0 0;
      {% if options.subheading_color != blank %}color: {{ options.subheading_color }};{% endif %}
    }

    .section-{{ section.id }} .video-testimonial-card {
      position: relative;
      display: block;
      width: 100%;
      aspect-ratio: 9 / 16;
      overflow: hidden;
      background-color: #000;
      {% if options.card_corner_radius > 0 %}border-radius: {{ options.card_corner_radius }}px;{% endif %}
    }

    .section-{{ section.id }} .video-testimonial-card__media,
    .section-{{ section.id }} .video-testimonial-card__media video,
    .section-{{ section.id }} .video-testimonial-card__media iframe,
    .section-{{ section.id }} .video-testimonial-card__media img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      border: none;
      display: block;
    }

    .section-{{ section.id }} .video-testimonial-card__poster {
      position: absolute;
      inset: 0;
      z-index: 2;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      cursor: pointer;
      border: none;
      padding: 0;
      margin: 0;
      background: none;
      text-align: initial;
      color: var(--vtc-text-color);
      transition: opacity 0.35s ease, visibility 0.35s ease;
    }

    .section-{{ section.id }} .video-testimonial-card__poster-image {
      position: absolute;
      inset: 0;
      z-index: 1;
      overflow: hidden;
    }

    .section-{{ section.id }} .video-testimonial-card__poster-image img,
    .section-{{ section.id }} .video-testimonial-card__poster-image svg {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .section-{{ section.id }} .video-testimonial-card__shadow {
      position: absolute;
      inset-inline: 0;
      inset-block-end: 0;
      z-index: 2;
      height: {{ options.overlay_height }}%;
      background: linear-gradient(
        to top,
        {{ options.overlay_color | color_modify: 'alpha', overlay_alpha }} 0%,
        {{ options.overlay_color | color_modify: 'alpha', overlay_alpha_mid }} 45%,
        {{ options.overlay_color | color_modify: 'alpha', 0 }} 100%
      );
      pointer-events: none;
    }

    .section-{{ section.id }} .video-testimonial-card__play {
      position: absolute;
      inset-block-start: 45%;
      inset-inline-start: 50%;
      transform: translate(-50%, -50%);
      z-index: 4;
      width: var(--vtc-play-size);
      height: var(--vtc-play-size);
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
    }

    .section-{{ section.id }} .video-testimonial-card__play svg {
      width: 100%;
      height: 100%;
      display: block;
      overflow: visible;
    }

    .section-{{ section.id }} .video-testimonial-card__play-border {
      fill: {{ options.play_button_border_color }};
    }

    .section-{{ section.id }} .video-testimonial-card__play-arrow {
      fill: {{ options.play_button_arrow_color }};
    }

    .section-{{ section.id }} .video-testimonial-card__content {
      position: relative;
      z-index: 3;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      padding: var(--vtc-content-padding);
    }

    .section-{{ section.id }} .video-testimonial-card__stars {
      display: flex;
      gap: 0.2rem;
      color: var(--vtc-star-color);
      font-size: var(--vtc-stars-size);
      line-height: 1;
      letter-spacing: 0.1em;
    }

    .section-{{ section.id }} .video-testimonial-card__caption {
      font-size: var(--vtc-caption-size);
      line-height: 1.35;
      margin: 0;
      opacity: 0.9;
    }

    .section-{{ section.id }} .video-testimonial-card__author {
      font-size: var(--vtc-author-size);
      font-weight: 700;
      margin: 0;
      text-align: {{ options.author_alignment }};
    }

    @media screen and (min-width: 768px) {
      .section-{{ section.id }} .slider-grid-track {
        margin-inline-start: calc(var(--gsc-space-between-cards) * -1);
      }
    }

    .section-{{ section.id }} .slider-grid {
      position: relative;
    }

    .section-{{ section.id }} .card-carousel__position-btn-wrap {
      top: 0;
      bottom: auto;
      height: calc(var(--gsc-slide-width) * 16 / 9);
      display: flex;
      align-items: center;
      overflow: visible;
    }

    @media screen and (min-width: 768px) {
      .section-{{ section.id }} .card-carousel__position-btn-wrap {
        height: clamp(
          var(--vtc-min-height),
          calc(var(--gsc-slide-width) * 16 / 9),
          var(--vtc-max-height)
        );
      }
    }

    .section-{{ section.id }} .card-carousel__carousel-btn {
      top: 50%;
      transform: translateY(-50%);
    }

    .section-{{ section.id }} .card-carousel__position-btn-wrap .shape {
      height: 100%;
      padding: 0;
    }

    .section-{{ section.id }} .slider-grid__m-carousel .slider-grid__slide {
      scroll-snap-align: start;
    }

    .section-{{ section.id }} .slider-grid__slide,
    .section-{{ section.id }} .slider-grid__d-carousel .slider-grid__slide,
    .section-{{ section.id }} .slider-grid__m-carousel .slider-grid__slide {
      min-width: var(--gsc-slide-width);
      width: var(--gsc-slide-width);
    }

    @media screen and (min-width: 768px) {
      .section-{{ section.id }} .slider-grid__slide,
      .section-{{ section.id }} .slider-grid__d-carousel .slider-grid__slide {
        --vtc-min-width: calc(var(--vtc-min-height) * 9 / 16);
        --vtc-max-width: calc(var(--vtc-max-height) * 9 / 16);
        min-width: clamp(
          var(--vtc-min-width),
          var(--gsc-slide-width),
          var(--vtc-max-width)
        );
        width: clamp(
          var(--vtc-min-width),
          var(--gsc-slide-width),
          var(--vtc-max-width)
        );
      }
    }

    .section-{{ section.id }} .video-testimonial-card.is-playing .video-testimonial-card__poster {
      opacity: 0;
      pointer-events: none;
      visibility: hidden;
    }

    .section-{{ section.id }} .video-testimonial-card.is-playing .video-testimonial-card__media {
      cursor: pointer;
    }
  {% endstyle %}
{% endcapture %}

{% render 'inline-css-minifier', css: css %}

<div class='section section-{{ section.id }} color-{{ color_scheme }} spacing-block'>
  <div class='container container--{{ container_size }} container-background'>
    {%- if options.heading != blank or options.subheading != blank -%}
      <div
        class='container__header {% if enable_content_slide_in %}scroll-trigger animate--slide-in{% endif %}'
        {% if enable_content_slide_in %}
          style='--gsc-animation-order: 1;'
        {% endif %}
      >
        {%- if options.heading != blank -%}
          <{{ options.heading_tag }} class='video-testimonials__heading {{ options.heading_size }}'>
            {{- options.heading -}}
          </{{ options.heading_tag }}>
        {%- endif -%}
        {%- if options.subheading != blank -%}
          <p class='video-testimonials__subheading {{ options.subheading_size }}'>{{ options.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <slider-grid
      class='slider-grid {% if options.show_navigation_on_hover %}card-carousel--navigation-on-hover{% endif %}'
      {% if options.autoplay_mode != 'disabled' %}
        autoplay-mode='{{ options.autoplay_mode }}'
        autoplay-interval='{{ options.autoplay_interval }}'
      {% endif %}
    >
      <div
        slider-grid-track
        class='slider-grid-track slider-grid__d-carousel slider-grid__m-carousel'
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign video = block.settings.shopify_video
            assign external_video = block.settings.external_video
            assign poster = block.settings.cover_image | default: video.preview_image | default: external_video.preview_image
          -%}
          <div
            class='slider-grid__slide {% if enable_content_slide_in %}scroll-trigger animate--slide-in{% endif %}'
            slider-grid-slide
            {% if enable_content_slide_in %}
              style='--gsc-animation-order: {{ forloop.index }};'
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <div class='video-testimonial-card' data-video-testimonial-card>
              <div class='video-testimonial-card__media' data-video-testimonial-media>
                {%- if video != blank -%}
                  <template data-video-testimonial-template>
                    {% render 'video-with-alt',
                      class: 'video-testimonial-card__video',
                      video: video,
                      autoplay: false,
                      loop: options.enable_looping,
                      muted: options.mute_video,
                      controls: false,
                      is_eager_loading: true
                    %}
                  </template>
                {%- elsif external_video != blank -%}
                  {%- liquid
                    assign video_id = external_video.id
                    assign params = video_id | append: '?autoplay=1&playsinline=1'
                    if external_video.type == 'youtube'
                      assign params = params | append: '&enablejsapi=1&rel=0'
                    endif
                    if options.enable_looping
                      assign params = params | append: '&loop=1&playlist=' | append: video_id
                    endif
                    if options.mute_video
                      assign params = params | append: '&mute=1&muted=1'
                    endif
                    assign params = params | append: '&controls=0&modestbranding=1'

                    assign src = 'https://www.youtube.com/embed/' | append: params
                    if external_video.type != 'youtube'
                      assign src = 'https://player.vimeo.com/video/' | append: params
                    endif
                  -%}
                  <template data-video-testimonial-template>
                    <iframe
                      src='{{ src }}'
                      allow='autoplay; fullscreen; picture-in-picture'
                      allowfullscreen
                      frameborder='0'
                      title='{{ block.settings.caption | strip_html | escape }}'
                    ></iframe>
                  </template>
                {%- endif -%}
              </div>

              <button
                type='button'
                class='video-testimonial-card__poster'
                data-video-testimonial-poster
                aria-label='{{ 'icons.screen_reader.play-without-round' | t }}'
              >
                <div class='video-testimonial-card__poster-image'>
                  {%- if poster != blank -%}
                    <img
                      {% render 'image-attributes', image: poster, class: 'video-testimonial-card__image' %}
                    >
                  {%- else -%}
                    {{ 'hero-apparel-3' | placeholder_svg_tag: 'placeholder-image' }}
                  {%- endif -%}
                </div>

                <div class='video-testimonial-card__shadow'></div>

                {%- if video != blank or external_video != blank -%}
                  <span class='video-testimonial-card__play'>
                    <svg viewBox='0 0 198.99 198.99' aria-hidden='true' focusable='false'>
                      <g opacity='0.59'>
                        <rect x='1.5' y='1.5' width='195.99' height='195.99' rx='9.25' ry='9.25'></rect>
                      </g>
                      <path
                        class='video-testimonial-card__play-border'
                        d='M188.23,198.99H10.75c-5.93,0-10.75-4.82-10.75-10.75V10.75C0,4.82,4.82,0,10.75,0h177.48c5.93,0,10.75,4.82,10.75,10.75v177.48c0,5.93-4.82,10.75-10.75,10.75ZM10.75,3c-4.27,0-7.75,3.48-7.75,7.75v177.48c0,4.27,3.48,7.75,7.75,7.75h177.48c4.27,0,7.75-3.48,7.75-7.75V10.75c0-4.27-3.48-7.75-7.75-7.75H10.75Z'
                      ></path>
                      <path
                        class='video-testimonial-card__play-arrow'
                        d='M152.14,99.49c0,1.13-.61,2.17-1.59,2.73l-94.07,53.3c-.48.27-1.01.41-1.55.41s-1.09-.14-1.58-.42c-.97-.56-1.56-1.6-1.56-2.71V46.19c0-1.12.59-2.15,1.56-2.71.97-.56,2.15-.56,3.13-.02l94.07,53.3c.98.56,1.59,1.6,1.59,2.73Z'
                      ></path>
                    </svg>
                  </span>
                {%- endif -%}

                <div class='video-testimonial-card__content'>
                  {%- if block.settings.stars > 0 -%}
                    <div class='video-testimonial-card__stars' aria-hidden='true'>
                      {%- for i in (1..block.settings.stars) -%}★{%- endfor -%}
                    </div>
                  {%- endif -%}
                  {%- if block.settings.caption != blank -%}
                    <p class='video-testimonial-card__caption'>{{ block.settings.caption }}</p>
                  {%- endif -%}
                  {%- if block.settings.author != blank -%}
                    <p class='video-testimonial-card__author'>{{ block.settings.author }}</p>
                  {%- endif -%}
                </div>
              </button>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class='card-carousel__position-btn-wrap card-carousel__position-btn-wrap--prev shape--adapt'>
        <div class='shape shape--adapt'>
          <button
            type='button'
            class='carousel-btn card-carousel__carousel-btn card-carousel__carousel-btn--prev'
            data-direction='prev'
            aria-label='{{ 'accessibility.prev_slide' | t }}'
            tabindex='0'
            disabled
          >
            {% render 'icon', icon_name: 'chevron', class: 'carousel-btn__icon x-flip' %}
          </button>
        </div>
      </div>

      <div class='card-carousel__position-btn-wrap card-carousel__position-btn-wrap--next shape--adapt'>
        <div class='shape shape--adapt'>
          <button
            type='button'
            class='carousel-btn card-carousel__carousel-btn card-carousel__carousel-btn--next'
            data-direction='next'
            aria-label='{{ 'accessibility.next_slide' | t }}'
            tabindex='0'
            disabled
          >
            {% render 'icon', icon_name: 'chevron', class: 'carousel-btn__icon' %}
          </button>
        </div>
      </div>

      {%- if options.show_progress_bar -%}
        <div
          class='progress-bar progress-bar--with-background card-carousel__progress-bar'
          data-target='scroll'
        >
          <div class='slider-grid__progress-bar-indicator' slider-grid-progress></div>
        </div>
      {%- endif -%}
    </slider-grid>
  </div>
</div>

<script>
  (() => {
    const section = document.querySelector('.section-{{ section.id }}');
    if (!section) return;

    const cards = section.querySelectorAll('[data-video-testimonial-card]');

    const stopCard = (card) => {
      const media = card.querySelector('[data-video-testimonial-media]');
      if (!media) return;
      const video = media.querySelector('video');
      if (video) video.pause();
      media.querySelectorAll('iframe, lazy-video, video-element, video').forEach((el) => el.remove());
      card.classList.remove('is-playing');
    };

    cards.forEach((card) => {
      const poster = card.querySelector('[data-video-testimonial-poster]');
      const media = card.querySelector('[data-video-testimonial-media]');
      const template = card.querySelector('[data-video-testimonial-template]');
      if (!poster || !media || !template) return;

      poster.addEventListener('click', () => {
        if (card.classList.contains('is-playing')) return;

        {%- if options.pause_others %}
          cards.forEach((other) => {
            if (other !== card) stopCard(other);
          });
        {%- endif %}

        media.appendChild(template.content.cloneNode(true));
        card.classList.add('is-playing');

        const video = media.querySelector('video');
        if (video) {
          video.setAttribute('playsinline', '');
          video.controls = false;
          {%- if options.mute_video %}
            video.muted = true;
          {%- endif %}
          const played = video.play();
          if (played && played.catch) played.catch(() => {});
          video.addEventListener('ended', () => stopCard(card));
        }
      });

      media.addEventListener('click', () => {
        if (card.classList.contains('is-playing')) stopCard(card);
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Video Testimonials",
  "tag": "section",
  "class": "shopify-section-video-testimonials",
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE HIGHEST RATED NECK PROTECTION"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "div", "label": "Div" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "display1", "label": "Display 1" },
        { "value": "display2", "label": "Display 2" },
        { "value": "display3", "label": "Display 3" },
        { "value": "h1", "label": "Heading 1" },
        { "value": "h2", "label": "Heading 2" },
        { "value": "h3", "label": "Heading 3" },
        { "value": "h4", "label": "Heading 4" },
        { "value": "h5", "label": "Heading 5" },
        { "value": "h6", "label": "Heading 6" }
      ],
      "default": "display3"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "SEE WHAT HOCKEY FAMILIES ARE SAYING"
    },
    {
      "type": "select",
      "id": "subheading_size",
      "label": "Subheading size",
      "options": [
        { "value": "body0", "label": "Body 0" },
        { "value": "body1", "label": "Body 1" },
        { "value": "body2", "label": "Body 2" },
        { "value": "body3", "label": "Body 3" },
        { "value": "body4", "label": "Body 4" },
        { "value": "body5", "label": "Body 5" },
        { "value": "body6", "label": "Body 6" }
      ],
      "default": "body3"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Layout",
      "info": "Cards are always 9:16 and scroll horizontally when space runs out."
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Cards per row on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "mobile_peek",
      "label": "Next card peek on mobile",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "%",
      "default": 15,
      "info": "One full card shows, with this much of the next card visible."
    },
    {
      "type": "range",
      "id": "desktop_space_between_cards",
      "label": "Space between cards on desktop",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_space_between_cards",
      "label": "Space between cards on mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_min_height",
      "label": "Minimum card height",
      "min": 200,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 380,
      "info": "Cards shrink with the screen until they hit this height, then the carousel scrolls."
    },
    {
      "type": "range",
      "id": "card_max_height",
      "label": "Maximum card height",
      "min": 300,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 720,
      "info": "Cards grow to fill leftover space up to this height."
