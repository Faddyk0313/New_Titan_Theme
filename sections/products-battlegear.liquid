{%- liquid
  assign options = section.settings

  assign color_scheme = settings.default_color_scheme
  if options.color_scheme_variant == 'own'
    assign color_scheme = options.color_scheme
  endif

  assign desktop_columns = options.desktop_columns
  assign mobile_columns = options.mobile_columns
  assign space_between_cards = options.space_between_cards
  assign space_between_cards_mobile = options.space_between_cards_mobile
  assign product_per_page = options.product_per_page | times: 1.0
  assign pagination_type = options.pagination_type
  assign container_size = options.container_size

  assign enable_filtering = options.enable_filtering
  assign enable_sorting = options.enable_sorting
  assign show_product_count = options.show_product_count
  assign show_divider = options.show_divider
  assign show_result_count = options.show_result_count
  assign show_color_swatches = options.show_color_swatches
  assign enable_uppercase_title = options.enable_uppercase_title

  assign add_desktop_side_paddings = options.add_desktop_side_paddings
  assign add_mobile_side_paddings = options.add_mobile_side_paddings
  assign section_spacing_top = options.section_spacing_top
  assign section_spacing_bottom = options.section_spacing_bottom

  assign accent_color = options.accent_color
  assign card_background = options.card_background
  assign muted_color = options.muted_color

  assign active_filter_count = 0
  for filter in collection.filters
    assign active_filter_count = active_filter_count | plus: filter.active_values.size
  endfor

  if collection.filters.size == 0
    assign enable_filtering = false
  endif

  assign toggle_blocks = section.blocks | where: 'type', 'toggle'

  comment
    The toggle group drives one real filter (the Youth/Senior tag filter by
    default). Find it by label so the buttons can read its values and URLs.
  endcomment
  assign toggle_filter_label_downcase = options.toggle_filter_label | downcase | strip
  for filter in collection.filters
    assign filter_label_downcase = filter.label | downcase | strip
    if filter_label_downcase == toggle_filter_label_downcase
      assign toggle_filter = filter
      break
    endif
  endfor

  comment
    The toggle already shows that filter, so keep it out of the sidebar. Only
    hide it when the toggle can actually render it.
  endcomment
  assign hidden_filter_labels = options.hidden_filter_labels
  if toggle_filter != blank and toggle_blocks.size > 0
    assign hidden_filter_labels = options.hidden_filter_labels | append: ',' | append: options.toggle_filter_label
  endif
-%}

{%- comment -%} re-export so the value is visible to the render calls below {%- endcomment -%}
{%- assign sidebar_hidden_filter_labels = hidden_filter_labels -%}

{% capture css %}
  {% style %}
    .section-{{ section.id }} {
      --bg-accent: {{ accent_color }};
      --bg-card-bg: {{ card_background }};
      --bg-muted: {{ muted_color }};
      --bg-hairline: {{ muted_color }}40;
      --bg-desktop-columns: {{ desktop_columns }};
      --bg-mobile-columns: {{ mobile_columns }};
      --bg-gap: var(--gsc-gap-{{ space_between_cards_mobile }});
      --gsc-section-spacing-top: var(--gsc-padding-block-{{ section_spacing_top }});
      --gsc-section-spacing-bottom: var(--gsc-padding-block-{{ section_spacing_bottom }});
    }

    @media {% render 'media-queries', screen: 'md' %} {
      .section-{{ section.id }} {
        --bg-gap: var(--gsc-gap-{{ space_between_cards }});
      }
    }

    /* ---------- layout ---------- */

    .section-{{ section.id }} .bg-shop__container {
      display: block;
    }

    .section-{{ section.id }} .bg-shop__layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: 32px;
    }

    @media {% render 'media-queries', screen: 'md' %} {
      .section-{{ section.id }} .bg-shop__layout {
        grid-template-columns: 280px minmax(0, 1fr);
        gap: 48px;
        align-items: start;
      }
    }

    /* ---------- sidebar ---------- */

    .section-{{ section.id }} .bg-shop__sidebar {
      display: none;
    }

    @media {% render 'media-queries', screen: 'md' %} {
      .section-{{ section.id }} .bg-shop__sidebar {
        display: block;
        position: sticky;
        top: 24px;
      }

      /* beats .sidebar-filters--desktop { display: none } */
      .section-{{ section.id }} .bg-shop__sidebar .bg-shop__filters.sidebar-filters--desktop {
        display: block;
      }
    }

    .section-{{ section.id }} .bg-shop__heading {
      margin: 0 0 36px;
      line-height: 1;
      text-transform: uppercase;
    }

    /* The stock sidebar-filters rules size and pad the drawer. Inside this
       section the desktop sidebar is just a grid column, so undo them. */
    .section-{{ section.id }} .bg-shop__filters,
    .section-{{ section.id }} .bg-shop__filters .sidebar-filters__body {
      width: 100%;
      height: auto;
      padding: 0;
      background: transparent;
    }

    .section-{{ section.id }} .bg-shop__filters .bg-filters__form {
      width: 100%;
      padding: 0;
      overflow-y: visible;
    }

    .section-{{ section.id }} .bg-filters__item--bordered + .bg-filters__item--bordered {
      border-top: 1px solid var(--bg-hairline);
    }

    .section-{{ section.id }} .bg-filters__item {
      padding: 20px 0;
    }

    .section-{{ section.id }} .bg-filters__label {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      width: 100%;
      color: var(--bg-muted);
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.08em;
      cursor: pointer;
    }

    .section-{{ section.id }} .bg-filters__label--uppercase {
      text-transform: uppercase;
    }

    .section-{{ section.id }} .bg-filters__chevron {
      flex-shrink: 0;
      width: 14px;
      height: 14px;
      transform: rotate(180deg);
      transition: transform 0.2s ease;
    }

    .section-{{ section.id }} .bg-filters__accordeon[data-aria-expanded='false'] .bg-filters__chevron {
      transform: rotate(0deg);
    }

    .section-{{ section.id }} .bg-filters__active-count {
      margin-inline-start: auto;
      color: var(--bg-accent);
    }

    .section-{{ section.id }} .accordeon__content {
      padding-top: 16px;
    }

    .section-{{ section.id }} .bg-filters__options {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .section-{{ section.id }} .bg-filters__options--checks {
      flex-direction: column;
      gap: 12px;
    }

    .section-{{ section.id }} .bg-filters__subgroup + .bg-filters__subgroup {
      margin-top: 18px;
    }

    .section-{{ section.id }} .bg-filters__subgroup-label {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 10px;
      color: var(--bg-muted);
      font-size: 13px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .section-{{ section.id }} .bg-filters__subgroup-caret {
      width: 10px;
      height: 10px;
      transform: rotate(-90deg);
    }

    /* ---------- pill options ---------- */

    .section-{{ section.id }} .bg-filters__pill {
      position: relative;
      display: inline-flex;
      align-items: center;
      padding: 6px 12px;
      border: 1px solid var(--bg-hairline);
      color: var(--bg-muted);
      font-size: 13px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      white-space: nowrap;
      cursor: pointer;
      transition: color 0.15s ease, border-color 0.15s ease;
    }

    .section-{{ section.id }} .bg-filters__pill .checkbox__input {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
      pointer-events: none;
    }

    .section-{{ section.id }} .bg-filters__pill:hover {
      color: rgb(var(--color-foreground));
      border-color: var(--bg-muted);
    }

    .section-{{ section.id }} .bg-filters__pill--selected,
    .section-{{ section.id }} .bg-filters__pill--selected:hover {
      color: var(--bg-accent);
      border-color: var(--bg-accent);
    }

    .section-{{ section.id }} .bg-filters__pill--disabled {
      opacity: 0.35;
      pointer-events: none;
    }

    /* ---------- checkbox options ---------- */

    .section-{{ section.id }} .bg-filters__check {
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--bg-muted);
      font-size: 14px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      cursor: pointer;
      transition: color 0.15s ease;
    }

    .section-{{ section.id }} .bg-filters__check .checkbox__input {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
      pointer-events: none;
    }

    .section-{{ section.id }} .bg-filters__check-box {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      width: 18px;
      height: 18px;
      border: 1px solid var(--bg-hairline);
      transition: border-color 0.15s ease;
    }

    .section-{{ section.id }} .bg-filters__check-icon {
      width: 12px;
      height: 12px;
      opacity: 0;
      color: var(--bg-accent);
    }

    .section-{{ section.id }} .bg-filters__check:has(.checkbox__input:checked) {
      color: var(--bg-accent);
    }

    .section-{{ section.id }} .bg-filters__check:has(.checkbox__input:checked) .bg-filters__check-box {
      border-color: var(--bg-accent);
    }

    .section-{{ section.id }} .bg-filters__check:has(.checkbox__input:checked) .bg-filters__check-icon {
      opacity: 1;
    }

    .section-{{ section.id }} .bg-filters__check--disabled {
      opacity: 0.35;
      pointer-events: none;
    }

    .section-{{ section.id }} .bg-filters__option-count {
      margin-inline-start: 4px;
      opacity: 0.6;
    }

    /* ---------- toolbar ---------- */

    .section-{{ section.id }} .bg-shop__toolbar {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 28px;
    }

    .section-{{ section.id }} .bg-shop__toggles {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .section-{{ section.id }} .bg-shop__toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 190px;
      padding: 13px 24px;
      border: 1px solid rgb(var(--color-foreground));
      color: rgb(var(--color-foreground));
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-decoration: none;
      cursor: pointer;
      -webkit-user-select: none;
      user-select: none;
      transition: background-color 0.15s ease, color 0.15s ease;
    }

    .section-{{ section.id }} .bg-shop__toggle:hover,
    .section-{{ section.id }} .bg-shop__toggle--active {
      background-color: rgb(var(--color-foreground));
      color: rgb(var(--color-background));
    }

    .section-{{ section.id }} .bg-shop__toolbar-end {
      display: flex;
      align-items: center;
      gap: 20px;
      margin-inline-start: auto;
    }

    .section-{{ section.id }} .bg-shop__count {
      color: var(--bg-muted);
      font-size: 14px;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }

    /* ---------- grid ---------- */

    .section-{{ section.id }} .bg-shop__grid {
      display: grid;
      grid-template-columns: repeat(var(--bg-mobile-columns), minmax(0, 1fr));
      gap: var(--bg-gap);
    }

    @media {% render 'media-queries', screen: 'md' %} {
      .section-{{ section.id }} .bg-shop__grid {
        grid-template-columns: repeat(var(--bg-desktop-columns), minmax(0, 1fr));
      }
    }

    .section-{{ section.id }} .bg-shop__products-wrap {
      position: relative;
    }

    .section-{{ section.id }} .bg-shop__stub {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 60px 0;
      text-align: center;
    }

    /* ---------- card ---------- */

    .section-{{ section.id }} .bg-card__link {
      display: flex;
      flex-direction: column;
      height: 100%;
      color: inherit;
      text-decoration: none;
    }

    .section-{{ section.id }} .bg-card__media-wrap {
      position: relative;
      background-color: var(--bg-card-bg);
    }

    .section-{{ section.id }} .bg-card__media {
      position: relative;
      aspect-ratio: 1 / 1;
    }

    .section-{{ section.id }} .bg-card__image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .section-{{ section.id }} .bg-card__image--hover {
      opacity: 0;
      transition: opacity 0.25s ease;
    }

    .section-{{ section.id }} .bg-card__link:hover .bg-card__image--hover {
      opacity: 1;
    }

    .section-{{ section.id }} .bg-card--sold-out .bg-card__media {
      opacity: 0.55;
    }

    .section-{{ section.id }} .bg-card__tab {
      position: absolute;
      top: 0;
      inset-inline-start: 0;
      z-index: 2;
      padding: 4px 9px;
      background-color: var(--bg-accent);
      color: #000;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .section-{{ section.id }} .bg-card__tab--new {
      background-color: {{ options.tab_new_color }};
      color: #000;
    }

    .section-{{ section.id }} .bg-card__tab--last {
      background-color: {{ options.tab_last_chance_color }};
      color: #000;
    }

    .section-{{ section.id }} .bg-card__tab--sold-out {
      background-color: var(--bg-muted);
      color: #000;
    }

    .section-{{ section.id }} .bg-card__content {
      padding: 14px 0 0;
      background-color: transparent;
    }

    .section-{{ section.id }} .bg-card__pill {
      display: inline-flex;
      align-items: stretch;
      margin-bottom: 10px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .section-{{ section.id }} .bg-card__pill-main {
      padding: 4px 9px;
      background-color: {{ options.pill_main_color }};
      color: #fff;
    }

    .section-{{ section.id }} .bg-card__pill-gen {
      padding: 4px 9px;
      background-color: {{ options.pill_gen_color }};
      color: #fff;
    }

    .section-{{ section.id }} .bg-card__title {
      margin: 0;
      font-size: 20px;
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: 0.01em;
      text-transform: uppercase;
    }

    .section-{{ section.id }} .bg-card__color {
      margin-top: 4px;
      color: var(--bg-muted);
      font-size: 17px;
      font-weight: 300;
      font-stretch: condensed;
      line-height: 1.2;
      letter-spacing: 0.02em;
      text-transform: uppercase;
    }

    .section-{{ section.id }} .bg-card__price {
      display: flex;
      align-items: baseline;
      gap: 8px;
      margin-top: 10px;
      font-size: 16px;
      font-weight: 700;
    }

    .section-{{ section.id }} .bg-card__price--on-sale .bg-card__price-current {
      color: var(--bg-accent);
    }

    .section-{{ section.id }} .bg-card__price-compare {
      color: var(--bg-muted);
      font-size: 14px;
      font-weight: 400;
      text-decoration: line-through;
    }

    /* ---------- mobile filter trigger ---------- */

    .section-{{ section.id }} .bg-shop__mobile-filters-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      border: 1px solid var(--bg-hairline);
      color: var(--bg-muted);
      font-size: 14px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    @media {% render 'media-queries', screen: 'md' %} {
      .section-{{ section.id }} .bg-shop__mobile-filters-btn {
        display: none;
      }
    }
  {% endstyle %}
{% endcapture %}

{% render 'inline-css-minifier', css: css %}

<shop-component
  class='bg-shop section section-{{ section.id }} color-{{ color_scheme }} spacing-block {% if add_mobile_side_paddings %}spacing-inline-mobile{% endif %} {% if add_desktop_side_paddings %}spacing-inline-desktop{% endif %}'
  data-section-id='{{ section.id }}'
>
  <div class='bg-shop__container container container--{{ container_size }}'>
    <div class='bg-shop__layout'>
      <aside class='bg-shop__sidebar'>
        {%- if options.heading != blank -%}
          <h2 class='bg-shop__heading {{ options.heading_size }}'>{{ options.heading }}</h2>
        {%- endif -%}

        {%- if enable_filtering -%}
          {%- comment -%}
            The element tag and the id are both required: the theme's shop
            component looks up #SidebarFiltersDesktop by name and calls
            methods that only sidebar-filters-desktop defines.
          {%- endcomment -%}
          <sidebar-filters-desktop
            id='SidebarFiltersDesktop'
            class='bg-shop__filters sidebar-filters sidebar-filters--desktop sidebar-filters--static sidebar-filters--static-left is-opened'
            data-section-id='{{ section.id }}'
            tabindex='-1'
            is-open-on-init
            data-sidebar-section
            is-embed-filters
          >
            <div class='sidebar-filters__body' id='FiltersDesktop' data-sidebar-body>
              {%- render 'loading-overlay',
                class: 'filters__form-loading-overlay',
                id: 'SidebarFiltersDesktop-loadingOverlay',
                attrs: 'data-filters-loading-overlay'
              -%}

              {%- comment -%}
                Kept in the DOM but hidden: updateHeaderByElement replaces its
                children on every filter change and throws without it.
              {%- endcomment -%}
              <div class='visually-hidden' data-filters-header></div>

              {% render 'battlegear-filters',
                results: collection,
                show_divider: show_divider,
                enable_uppercase_title: enable_uppercase_title,
                show_result_count: show_result_count,
                show_color_swatches: show_color_swatches,
                id_prefix: 'BgFilterDesktop',
                size_filter_label: options.size_filter_label,
                size_group_prefixes: options.size_group_prefixes,
                checkbox_filter_labels: options.checkbox_filter_labels,
                hidden_filter_labels: sidebar_hidden_filter_labels
              %}
            </div>
          </sidebar-filters-desktop>
        {%- endif -%}
      </aside>

      <div class='bg-shop__main'>
        <div class='bg-shop__toolbar'>
          {%- if toggle_blocks.size > 0 and toggle_filter != blank -%}
            <div class='bg-shop__toggles' role='group' aria-label='{{ toggle_filter.label | escape }}'>
              {%- for block in toggle_blocks -%}
                {%- liquid
                  comment
                    Each toggle maps to one value of the toggle filter. Clicking
                    it swaps to that value's URL, which filter-remove-btn applies
                    through the shop component — the same AJAX path the sidebar
                    filters use, so the grid updates without a page load.
                  endcomment
                  assign toggle_value = blank
                  assign wanted = block.settings.filter_value | downcase | strip

                  for value in toggle_filter.values
                    assign value_label_downcase = value.label | downcase | strip
                    assign value_value_downcase = value.value | downcase | strip
                    if value_label_downcase == wanted or value_value_downcase == wanted
                      assign toggle_value = value
                      break
                    endif
                  endfor
                -%}

                {%- if toggle_value != blank -%}
                  {%- liquid
                    comment
                      Active when the value is already applied, or — when nothing
                      is applied yet — when this collection is the one the block
                      names, so /collections/senior-battlegear opens with SENIOR
                      preselected.
                    endcomment
                    assign is_active = false
                    if toggle_value.active
                      assign is_active = true
                    elsif toggle_filter.active_values.size == 0 and block.settings.collection != blank and block.settings.collection.handle == collection.handle
                      assign is_active = true
                    endif

                    if toggle_value.active
                      assign toggle_url = toggle_value.url_to_remove
                    else
                      assign toggle_url = toggle_value.url_to_add
                    endif
                  -%}

                  <filter-remove-btn
                    class='bg-shop__toggle{% if is_active %} bg-shop__toggle--active{% endif %}'
                    data-url='{{ toggle_url }}'
                    data-filter-remove-btn
                    role='button'
                    tabindex='0'
                    aria-pressed='{{ is_active }}'
                    {{ block.shopify_attributes }}
                  >
                    {{- block.settings.label -}}
                  </filter-remove-btn>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if enable_filtering -%}
            <sidebar-button>
              <button
                type='button'
                data-sidebar-button
                data-sidebar-id='SidebarFiltersMobile'
                class='unstyled-button bg-shop__mobile-filters-btn'
                aria-label='{{ 'shop.screen_reader.label_for_filters_toggler' | t }}'
              >
                {% render 'icon', icon_name: 'filter-toggle' %}
                {{ 'shop.store_front.label_for_filters_toggler' | t }}
              </button>
            </sidebar-button>
          {%- endif -%}

          <div class='bg-shop__toolbar-end'>
            {%- if show_product_count -%}
              <div class='bg-shop__count' id='ShopProductCount'>
                {{ 'shop.store_front.results_count' | t: count: collection.products_count }}
              </div>
            {%- endif -%}

            {%- if enable_sorting -%}
              {% render 'sort-list', results: collection %}
            {%- endif -%}
          </div>
        </div>

        {%- if enable_filtering -%}
          {% render 'active-filters',
            results: collection,
            active_filter_count: active_filter_count,
            color_container_background: false,
            add_desktop_side_paddings: add_desktop_side_paddings,
            add_mobile_side_paddings: add_mobile_side_paddings
          %}
        {%- endif -%}

        <div class='bg-shop__products' id='ShopProducts'>
          {%- paginate collection.products by product_per_page -%}
            {%- if collection.products.size > 0 -%}
              <div class='bg-shop__products-wrap'>
                <div class='bg-shop__grid' id='ShopProductsGrid'>
                  {%- for product in collection.products -%}
                    <div class='bg-shop__grid-item'>
                      {% render 'product-card-battlegear', product: product %}
                    </div>
                  {%- endfor -%}
                </div>
                {% render 'loading-overlay', class: 'shop__loading-overlay', id: 'ShopProductsOverlay' %}
              </div>
            {%- else -%}
              <div class='bg-shop__stub'>
                {%- if active_filter_count > 0 -%}
                  <span>{{ 'shop.store_front.text_for_no_results_found_in_stub' | t }}</span>
                  <span>
                    {{- 'shop.store_front.text_for_use_another_filters' | t }}
                    <filter-remove-btn class='shop__filters-reset' data-url='{{ collection.url }}'>
                      {{- 'shop.store_front.text_for_clear_all_in_stub' | t -}}
                    </filter-remove-btn>
                  </span>
                {%- else -%}
                  <span>{{ 'shop.store_front.text_for_change_query' | t }}</span>
                {%- endif -%}
                {% render 'loading-overlay', class: 'shop__loading-overlay', id: 'ShopProductsOverlay' %}
              </div>
            {%- endif -%}

            {%- liquid
              if paginate.pages > 1
                case pagination_type
                  when 'load-button-pagination'
                    render 'load-button-pagination', class: 'shop__load-button-pagination', paginate: paginate, target: 'bg-shop__grid-item', container_id: 'ShopProductsGrid', all_count: collection.products_count, current_size: paginate.page_size
                  when 'classic-pagination'
                    render 'classic-pagination', class: 'shop__classic-pagination', paginate: paginate, overlay_id: 'ShopProductsOverlay', container_id: 'ShopProductsGrid'
                  when 'infinite-scroll'
                    render 'infinite-scroll-pagination', class: '', paginate: paginate, target: 'bg-shop__grid-item', container_id: 'ShopProductsGrid'
                endcase
              endif
            -%}
          {%- endpaginate -%}
        </div>
      </div>
    </div>
  </div>

  {%- if enable_filtering -%}
    <sidebar-filters-mobile
      id='SidebarFiltersMobile'
      class='sidebar sidebar-filters sidebar-filters--mobile sidebar-filters--drawer sidebar-filters--drawer-left color-{{ color_scheme }}'
      data-section-id='{{ section.id }}'
      data-with-close-on-outside
      data-with-close-on-escape
      data-open-direction='left'
      data-with-overlay
      data-overlay-important
      tabindex='-1'
    >
      <template data-sidebar-template='SidebarFiltersMobile'>
        <div class='sidebar__body sidebar-filters__body' data-sidebar-body>
          {%- render 'loading-overlay',
            class: 'filters__form-loading-overlay',
            id: 'SidebarFiltersMobile-loadingOverlay',
            attrs: 'data-filters-loading-overlay'
          -%}

          <div class='sidebar-filters__header' data-filters-header>
            <div class='sidebar-filters__header-label'>
              {{- 'general.filters.store_front.header' | t -}}
            </div>
            <sidebar-button>
              <button
                type='button'
                data-sidebar-button
                data-sidebar-id='SidebarFiltersMobile'
                class='unstyled-button close-button-with-scale-hover'
                aria-label='{{ 'general.filters.screen_reader.hide_filters' | t }}'
              ></button>
            </sidebar-button>
          </div>

          {% render 'battlegear-filters',
            results: collection,
            show_divider: show_divider,
            enable_uppercase_title: enable_uppercase_title,
            show_result_count: show_result_count,
            show_color_swatches: show_color_swatches,
            id_prefix: 'BgFilterMobile',
            size_filter_label: options.size_filter_label,
            size_group_prefixes: options.size_group_prefixes,
            checkbox_filter_labels: options.checkbox_filter_labels,
            hidden_filter_labels: sidebar_hidden_filter_labels
          %}
        </div>
      </template>
    </sidebar-filters-mobile>
  {%- endif -%}
</shop-component>

{% render 'save-section-data-in-global-scope', section: section %}

{% schema %}
{
  "name": "Products (Battlegear)",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Sidebar"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Shop Battlegear",
      "label": "Sidebar heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" }
      ],
      "default": "h3",
      "label": "Heading size"
    },
    {
      "type": "header",
      "content": "Filters"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filtering"
    },
    {
      "type": "text",
      "id": "size_filter_label",
      "default": "Size",
      "label": "Size filter label",
      "info": "The filter with this label is split into the sub-groups below."
    },
    {
      "type": "textarea",
      "id": "size_group_prefixes",
      "default": "YOUTH:YTH-, SENIOR:SR-",
      "label": "Size sub-groups",
      "info": "Comma separated NAME:PREFIX pairs. Values matching no prefix are listed last."
    },
    {
      "type": "textarea",
      "id": "checkbox_filter_labels",
      "default": "Technology, Protection",
      "label": "Checkbox-style filters",
      "info": "Comma separated filter labels rendered as check + label rows. Everything else renders as pills."
    },
    {
      "type": "checkbox",
      "id": "show_color_swatches",
      "default": true,
      "label": "Show color swatches"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "default": true,
      "label": "Show dividers between filter groups"
    },
    {
      "type": "checkbox",
      "id": "enable_uppercase_title",
      "default": true,
      "label": "Uppercase filter group titles"
    },
    {
      "type": "checkbox",
      "id": "show_result_count",
      "default": false,
      "label": "Show result count per option"
    },
    {
      "type": "textarea",
      "id": "hidden_filter_labels",
      "label": "Filters to hide from the sidebar",
      "info": "Comma separated filter labels. The toggle's own filter is hidden automatically."
    },
    {
      "type": "header",
      "content": "Toolbar"
    },
    {
      "type": "text",
      "id": "toggle_filter_label",
      "default": "Age Group",
      "label": "Toggle filter label",
      "info": "The Search & Discovery filter the toggle buttons switch between. Each block below picks one of its values."
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "default": true,
      "label": "Show results count"
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "product_per_page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4",
      "label": "Desktop columns"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2",
      "label": "Mobile columns"
    },
    {
      "type": "select",
      "id": "space_between_cards",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "xxs", "label": "XXS" },
        { "value": "xs", "label": "XS" },
        { "value": "s", "label": "S" },
        { "value": "m", "label": "M" },
        { "value": "l", "label": "L" },
        { "value": "xl", "label": "XL" }
      ],
      "default": "s",
      "label": "Gap between cards (desktop)"
    },
    {
      "type": "select",
      "id": "space_between_cards_mobile",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "xxs", "label": "XXS" },
        { "value": "xs", "label": "XS" },
        { "value": "s", "label": "S" },
        { "value": "m", "label": "M" },
        { "value": "l", "label": "L" },
        { "value": "xl", "label": "XL" }
      ],
      "default": "s",
      "label": "Gap between cards (mobile)"
    },
    {
      "type": "select",
      "id": "pagination_type",
      "options": [
        { "value": "classic-pagination", "label": "Classic" },
        { "value": "load-button-pagination", "label": "Load more button" },
        { "value": "infinite-scroll", "label": "Infinite scroll" }
      ],
      "default": "infinite-scroll",
      "label": "Pagination"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "accent_color",
      "default": "#d4ff32",
      "label": "Accent (selected filters, sale price, sale tab)"
    },
    {
      "type": "color",
      "id": "muted_color",
      "default": "#8b949e",
      "label": "Muted (filter labels, colorway, compare-at price)"
    },
    {
      "type": "color",
      "id": "card_background",
      "default": "#1f232a",
      "label": "Card image background"
    },
    {
      "type": "color",
      "id": "pill_main_color",
      "default": "#5a6470",
      "label": "Card pill — long segment"
    },
    {
      "type": "color",
      "id": "pill_gen_color",
      "default": "#3b434d",
      "label": "Card pill — short segment"
    },
    {
      "type": "color",
      "id": "tab_new_color",
      "default": "#2ec5f6",
      "label": "Corner tab — New in stock"
    },
    {
      "type": "color",
      "id": "tab_last_chance_color",
      "default": "#d4ff32",
      "label": "Corner tab — Last chance"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "container_size",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-screen", "label": "Full screen" }
      ],
      "default": "page-width",
      "label": "Container width"
    },
    {
      "type": "select",
      "id": "color_scheme_variant",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "own", "label": "Custom" }
      ],
      "default": "own",
      "label": "Color scheme variant"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "checkbox",
      "id": "add_desktop_side_paddings",
      "default": true,
      "label": "Add desktop side paddings"
    },
    {
      "type": "checkbox",
      "id": "add_mobile_side_paddings",
      "default": true,
      "label": "Add mobile side paddings"
    },
    {
      "type": "select",
      "id": "section_spacing_top",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "xs", "label": "XS" },
        { "value": "s", "label": "S" },
        { "value": "m", "label": "M" },
        { "value": "l", "label": "L" },
        { "value": "xl", "label": "XL" }
      ],
      "default": "s",
      "label": "Top spacing"
    },
    {
      "type": "select",
      "id": "section_spacing_bottom",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "xs", "label": "XS" },
        { "value": "s", "label": "S" },
        { "value": "m", "label": "M" },
        { "value": "l", "label": "L" },
        { "value": "xl", "label": "XL" }
      ],
      "default": "l",
      "label": "Bottom spacing"
    }
  ],
  "blocks": [
    {
      "type": "toggle",
      "name": "Collection toggle",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "Youth Battlegear",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "filter_value",
          "default": "Youth",
          "label": "Filter value",
          "info": "A value of the toggle filter, e.g. Youth or Senior. Must match the value in Search & Discovery."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Preselect on this collection",
          "info": "Optional. When no filter is applied yet and this collection is the one being viewed, this toggle starts selected."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Products (Battlegear)",
      "blocks": [
        { "type": "toggle", "settings": { "label": "Youth Battlegear", "filter_value": "Youth" } },
        { "type": "toggle", "settings": { "label": "Senior Battlegear", "filter_value": "Senior" } }
      ]
    }
  ]
}
{% endschema %}
