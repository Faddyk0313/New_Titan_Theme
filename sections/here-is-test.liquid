      "default": "default"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "1",
      "visible_if": "{{ section.settings.color_scheme_variant == 'own' }}"
    },
    {
      "type": "checkbox",
      "id": "show_background",
      "label": "Show section background",
      "default": true
    },
    { "type": "header", "content": "Section" },
    {
      "type": "select",
      "id": "container_size",
      "label": "Container size",
      "options": [
        { "value": "xsmall", "label": "Extra small" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
