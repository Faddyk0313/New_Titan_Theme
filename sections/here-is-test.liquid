      "default": "<p>Here's the test</p>"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Heading line height (desktop)",
      "min": 80,
      "max": 160,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "heading_line_height_desktop",
      "label": "Heading line height",
      "min": 80,
      "max": 160,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text",
      "default": "<p>ANSI measures real blade cut resistance.</p>"
    },
    {
      "type": "select",
      "id": "body_size",
      "label": "Text size",
      "options": [
        { "value": "body5", "label": "Body 5" },
        { "value": "body4", "label": "Body 4" },
        { "value": "body3", "label": "Body 3" },
        { "value": "body2", "label": "Body 2" },
        { "value": "body1", "label": "Body 1" }
      ],
      "default": "body3"
    },
    {
      "type": "range",
      "id": "header_gap",
      "label": "Header elements gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    { "type": "header", "content": "Main image" },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Image",
      "info": "Overrides the image URL below."
    },
    {
      "type": "text",
      "id": "main_image_url",
      "label": "Image URL",
      "default": "https://cdn.shopify.com/s/files/1/0635/2401/2210/files/ansi_bar_chart_1.svg?v=1787574091"
    },
    {
      "type": "text",
      "id": "main_image_alt",
      "label": "Image alt text",
      "default": "ANSI cut resistance chart"
    },
    {
      "type": "range",
      "id": "text_column_width",
      "label": "Text column width",
      "min": 20,
      "max": 60,
      "step": 1,
      "unit": "%",
      "default": 30
    },
    { "type": "header", "content": "Columns" },
    {
      "type": "range",
      "id": "columns_desktop",
