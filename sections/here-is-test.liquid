    {
      "type": "select",
      "id": "section_spacing_top",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "xxxs", "label": "XXXS" },
        { "value": "xxs", "label": "XXS" },
        { "value": "xs", "label": "XS" },
        { "value": "s", "label": "S" },
        { "value": "m", "label": "M" },
        { "value": "l", "label": "L" },
        { "value": "xl", "label": "XL" },
        { "value": "xxl", "label": "XXL" },
        { "value": "xxxl", "label": "XXXL" }
      ],
      "default": "l"
    },
    {
      "type": "select",
      "id": "section_spacing_bottom",
      "label": "Bottom spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "xxxs", "label": "XXXS" },
        { "value": "xxs", "label": "XXS" },
        { "value": "xs", "label": "XS" },
        { "value": "s", "label": "S" },
        { "value": "m", "label": "M" },
        { "value": "l", "label": "L" },
        { "value": "xl", "label": "XL" },
        { "value": "xxl", "label": "XXL" },
        { "value": "xxxl", "label": "XXXL" }
      ],
      "default": "l"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Column",
      "settings": [
