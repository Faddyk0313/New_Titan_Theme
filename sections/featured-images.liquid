{%- liquid
  assign options = section.settings
  assign color_scheme = settings.default_color_scheme
  if options.color_scheme_variant == 'own'
    assign color_scheme = options.color_scheme
  endif
  assign round_level = options.round_level
  assign alignment = options.alignment
  assign add_desktop_side_paddings = options.add_desktop_side_paddings
  assign add_mobile_side_paddings = options.add_mobile_side_paddings
  assign section_spacing_top = options.section_spacing_top
  assign section_spacing_bottom = options.section_spacing_bottom
  assign container_size = options.container_size
  assign heading_size = options.heading_size

  assign product_limit = options.cards_to_show
  assign title = options.title | default: ' '

  assign img_ratio = options.img_ratio
  assign img_ratio_resize = options.img_ratio_resize
  if img_ratio != 'default' and img_ratio_resize == 'fit'
    assign img_ratio = img_ratio_resize | append: '-' | append: options.img_ratio
  endif

  assign desktop_columns = options.desktop_columns
  assign laptop_columns = desktop_columns | minus: 1 | at_least: 2
  assign tablet_columns = desktop_columns | minus: 2 | at_least: 2
  assign small_tablet_columns = desktop_columns | minus: 3 | at_least: 2
  assign desktop_carousel_percent_width = 100.0
  assign laptop_carousel_percent_width = 100.0
  assign tablet_carousel_percent_width = 100.0
  assign small_tablet_carousel_percent_width = 90.0

  assign desktop_layout = options.desktop_layout
  assign mobile_layout = options.mobile_layout

  if desktop_layout == 'carousel-overflow'
    assign half_desktop_slide_width = desktop_carousel_percent_width | divided_by: desktop_columns | times: 0.33
    assign half_laptop_slide_width = laptop_carousel_percent_width | divided_by: laptop_columns | times: 0.33
    assign half_tablet_slide_width = tablet_carousel_percent_width | divided_by: tablet_columns | times: 0.33
    assign half_small_tablet_slide_width = small_tablet_carousel_percent_width | divided_by: small_tablet_columns | times: 0.33

    assign desktop_carousel_percent_width = desktop_carousel_percent_width | minus: half_desktop_slide_width
    assign laptop_carousel_percent_width = laptop_carousel_percent_width | minus: half_laptop_slide_width
    assign tablet_carousel_percent_width = tablet_carousel_percent_width | minus: half_tablet_slide_width
    assign small_tablet_carousel_percent_width = small_tablet_carousel_percent_width | minus: half_small_tablet_slide_width
  endif

  assign show_navigation_on_hover = options.show_navigation_on_hover
  assign autoplay_mode = options.autoplay_mode
  assign autoplay_interval = options.autoplay_interval

  if section.blocks.size == 0
    assign prepared_collection_placeholder = (1..product_limit)
  endif

  assign enable_content_slide_in = settings.enable_content_slide_in
  assign title_color = color_scheme.settings.text
-%}

{%- liquid
  assign show_background = section.settings.show_background
  assign color_container_background = false

  if show_background == false and settings.default_color_scheme.settings.background != color_scheme.settings.background
    assign color_container_background = true
  endif
-%}

{% if section.settings.collection_card_content_position contains 'on-image' %}
  {%- liquid
    assign cards_color_scheme_variant = section.settings.cards_color_scheme_variant
    assign cards_current_color_scheme = section.settings.color_scheme

    if cards_color_scheme_variant == 'own'
      assign cards_current_color_scheme = section.settings.cards_color_scheme
    endif

    assign overlay_color = cards_current_color_scheme.settings.background.rgb | replace: ' ', ', '
    assign title_color = cards_current_color_scheme.settings.text

    if cards_color_scheme_variant == 'custom'
      assign overlay_color = section.settings.cards_overlay_color.rgb | replace: ' ', ', '
      assign title_color = section.settings.cards_title_color
    endif

    assign cards_enable_overlay = true
  -%}
{% endif %}

{% capture css %}
  {% style %}
    .section-{{section.id}}{
        --gsc-space-between-cards: var(--gsc-gap-{{ section.settings.space_between_cards_mobile }});
        --gsc-slide-width: {{ desktop_carousel_percent_width | times: 1.00 | divided_by: desktop_columns }}%;
        --gsc-columns: 1;
        --gsc-section-spacing-top: var(--gsc-padding-block-{{ section_spacing_top }});
        --gsc-section-spacing-bottom: var(--gsc-padding-block-{{ section_spacing_bottom }});
        --gsc-featured-image-text-size: {{ section.settings.text_font_size_mobile }}px;

        --gsc-collection-card-title-color: {{ title_color }};

        {% if cards_enable_overlay %}
          --gsc-collection-card-overlay-color: {{ overlay_color  }};
          --gsc-collection-card-overlay-opacity: {{ section.settings.cards_overlay_opacity |  divided_by: 100.00 }};
        {% endif %}
    }

    .section-{{ section.id }}[class*='round-level-'] .collection-card__media {
      z-index: 0;
      overflow: hidden;
      border-radius: var(--gsc-base-radii, 0);
    }

    .section-{{ section.id }}[class*='round-level-'] .collection-card--with-background {
      z-index: 0;
      overflow: hidden;
      border-radius: var(--gsc-base-radii, 0);
    }

    .section-{{ section.id }}[class*='round-level-'] .collection-card--with-background .collection-card__media {
      border-radius: var(--gsc-base-radii, 0) var(--gsc-base-radii, 0) 0 0;
    }

    .section-{{ section.id }} .featured-image-card__content {
      gap: 0.6rem;
    }

    .section-{{ section.id }} .featured-image-card__content.collection-card__content--on-image {
      padding: 1.2rem 1.2rem 1.4rem;
      row-gap: 0.6rem;
    }

    .section-{{ section.id }} .featured-image-card__icon-wrap {
      display: flex;
      align-items: center;
      margin-bottom: 0.1rem;
    }

    .section-{{ section.id }} .featured-image-card__icon {
      width: var(--gsc-featured-image-icon-size, 58px);
      height: auto;
      max-width: 100%;
    }

    .section-{{ section.id }} .featured-image-card__heading {
      margin: 0;
      line-height: 0.9;
      letter-spacing: -0.01em;
      text-transform: uppercase;
    }

    .section-{{ section.id }} .featured-image-card__heading > * {
      line-height: inherit;
      letter-spacing: inherit;
      text-transform: inherit;
    }

    .section-{{ section.id }} .featured-image-card__heading p {
      margin: 0;
    }

    .section-{{ section.id }} .featured-image-card__heading p + p {
      margin-top: -0.05em;
    }

    .section-{{ section.id }} .featured-image-card__heading > *:first-child,
    .section-{{ section.id }} .featured-image-card__description > *:first-child {
      margin-top: 0;
    }

    .section-{{ section.id }} .featured-image-card__heading > *:last-child,
    .section-{{ section.id }} .featured-image-card__description > *:last-child {
      margin-bottom: 0;
    }

    .section-{{ section.id }} .featured-image-card__description {
      max-width: 28rem;
      font-size: var(--gsc-featured-image-text-size);
      line-height: 1.28;
    }

    .section-{{ section.id }} .featured-image-card__description p {
      margin: 0;
      font-size: inherit;
      line-height: inherit;
    }

    .section-{{ section.id }} .featured-image-card__description p + p {
      margin-top: 0.45rem;
    }

    .section-{{ section.id }} .featured-image-card__description br + br {
      content: '';
      display: block;
      margin-top: 0.45rem;
    }

    .section-{{ section.id }} .featured-image-card__description strong,
    .section-{{ section.id }} .featured-image-card__description b {
      font-weight: 700;
    }

    @media screen and (min-width: 768px) {
      .section-{{ section.id }} .featured-image-card__content.collection-card__content--on-image {
        padding: 1.6rem 1.6rem 1.8rem;
        row-gap: 0.75rem;
      }

      .section-{{ section.id }} .featured-image-card__description {
        max-width: 34rem;
      }
    }

    @media screen and (min-width: 768px) {
      .section-{{ section.id }} {
        --gsc-featured-image-text-size: {{ section.settings.text_font_size_desktop }}px;
      }
    }

    @media screen and (min-width: 768px) {
      .section-{{section.id}}{
        --gsc-space-between-cards: var(--gsc-gap-{{ section.settings.space_between_cards }});
        --gsc-slide-width: {{ small_tablet_carousel_percent_width | times: 1.00 | divided_by: small_tablet_columns }}%;
        --gsc-columns: {{ small_tablet_columns }};
      }
    }
    @media screen and (min-width: 968px) {
      .section-{{section.id}}{
        --gsc-space-between-cards: var(--gsc-gap-{{ section.settings.space_between_cards }});
        --gsc-slide-width: {{ tablet_carousel_percent_width | times: 1.00 | divided_by: tablet_columns }}%;
        --gsc-columns: {{ tablet_columns }};
      }
    }

    @media screen and (min-width: 1190px) {
      .section-{{ section.id }}{
        --gsc-slide-width: {{ laptop_carousel_percent_width | times: 1.00 | divided_by: laptop_columns }}%;
        --gsc-columns: {{ laptop_columns }};
      }
    }

    @media screen and (min-width: 1400px) {
      .section-{{ section.id }}{
        --gsc-slide-width: {{ desktop_carousel_percent_width | times: 1.00 | divided_by: desktop_columns }}%;
        --gsc-columns: {{ desktop_columns }};
      }
    }
  {% endstyle %}
{% endcapture %}

{% render 'inline-css-minifier', css: css %}

{% capture section_header %}
  {%- if title != blank -%}
    <div class='collection__header {% if color_container_background == false and add_desktop_side_paddings == false or add_mobile_side_paddings == false  %}spacing-inline-header{% endif %} {% if alignment == 'center' %} collection__header--center {% elsif alignment == 'right' %} collection__header--right {% endif %} {% if enable_content_slide_in %}scroll-trigger animate--slide-in{% endif %}'
      {% if enable_content_slide_in %}
        style='--gsc-animation-order: 1;'
      {% endif %}
    >
      <h2 class='collection__title {{ heading_size }}'>{{ title }}</h2>
    </div>
  {%- endif -%}
{% endcapture %}

<div class='collection {% if round_level != 'default' %}round-level-{{round_level}}{% endif %} section section-{{ section.id }} color-{{ color_scheme }} spacing-block {% if add_mobile_side_paddings %}spacing-inline-mobile{% endif %} {% if add_desktop_side_paddings %}spacing-inline-desktop{% endif %} {% if color_container_background == false %}section-background{% endif %}'>
  <div class='collection__container container container--{{ container_size }} {% if color_container_background %}container-background{% endif %}'>
    {{ section_header }}

    {% render 'featured-images-carousel',
      section: section,
      desktop_layout: desktop_layout,
      mobile_layout: mobile_layout,
      prepared_collection_placeholder: prepared_collection_placeholder,
      autoplay_mode: autoplay_mode,
      autoplay_interval: autoplay_interval,
      img_ratio: img_ratio,
      product_limit: product_limit,
      show_navigation_on_hover: show_navigation_on_hover,
      collection_card_content_position: section.settings.collection_card_content_position,
      collection_card_content_align: section.settings.collection_card_content_align,
      collection_card_heading_size: section.settings.collection_card_heading_size,
      collection_card_enable_overlay: cards_enable_overlay,
      collection_card_color_scheme: cards_current_color_scheme
    %}
  </div>
</div>

{% render 'save-section-data-in-global-scope', section: section %}

