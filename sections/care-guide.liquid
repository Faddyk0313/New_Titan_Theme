{%- comment -%}TBG custom Code{%- endcomment -%}
{%- liquid
  assign options = section.settings

  assign heading = options.heading
  assign heading_size = options.heading_size
  assign body = options.body
  assign body_size = options.body_size
  assign content_alignment = options.content_alignment

  assign container_size = options.container_size
  assign round_level = options.round_level
  assign add_desktop_side_paddings = options.add_desktop_side_paddings
  assign add_mobile_side_paddings = options.add_mobile_side_paddings
  assign section_spacing_top = options.section_spacing_top
  assign section_spacing_bottom = options.section_spacing_bottom

  assign cards_gap = options.cards_gap
  assign card_header_padding_block = options.card_header_padding_block
  assign card_header_padding_inline = options.card_header_padding_inline
  assign card_body_padding_block = options.card_body_padding_block
  assign card_body_padding_inline = options.card_body_padding_inline
  assign items_gap = options.items_gap
  assign item_icon_gap = options.item_icon_gap
  assign item_text_indent = options.item_text_indent

  assign header_icon_size = options.header_icon_size
  assign item_icon_size = options.item_icon_size

  assign card_title_size_desktop = options.card_title_size_desktop
  assign card_title_size_mobile = options.card_title_size_mobile
  assign item_title_size_desktop = options.item_title_size_desktop
  assign item_title_size_mobile = options.item_title_size_mobile
  assign item_text_size_desktop = options.item_text_size_desktop
  assign item_text_size_mobile = options.item_text_size_mobile

  assign color_scheme = settings.default_color_scheme
  if options.color_scheme_variant == 'own'
    assign color_scheme = options.color_scheme
  endif

  assign enable_content_slide_in = settings.enable_content_slide_in
-%}

{%- liquid
  assign show_background = section.settings.show_background
  assign color_container_background = false

  if show_background == false and settings.default_color_scheme.settings.background != color_scheme.settings.background
    assign color_container_background = true
  endif
-%}

{% capture css %}
  {% style %}
    .section-{{ section.id }} {
      --gsc-section-spacing-top: var(--gsc-padding-block-{{ section_spacing_top }});
      --gsc-section-spacing-bottom: var(--gsc-padding-block-{{ section_spacing_bottom }});
      --care-guide-cards-gap: {{ cards_gap }}px;
      --care-guide-items-gap: {{ items_gap }}px;
      --care-guide-item-icon-gap: {{ item_icon_gap }}px;
      --care-guide-item-text-indent: {{ item_text_indent }}px;
      --care-guide-header-icon-size: {{ header_icon_size }}px;
      --care-guide-item-icon-size: {{ item_icon_size }}px;
    }

    .section-{{ section.id }} .care-guide {
      display: flex;
      flex-direction: column;
      gap: var(--care-guide-cards-gap);
    }

    .section-{{ section.id }} .care-guide__intro {
      display: flex;
      flex-direction: column;
      gap: 1.6rem;
    }

    .section-{{ section.id }} .care-guide__intro--align-center {
      text-align: center;
      align-items: center;
    }

    .section-{{ section.id }} .care-guide__intro--align-right {
      text-align: right;
      align-items: flex-end;
    }

    .section-{{ section.id }} .care-guide__cards {
      display: flex;
      flex-direction: column;
      gap: var(--care-guide-cards-gap);
    }

    .section-{{ section.id }} .care-guide__card {
      overflow: hidden;
      border-radius: var(--gsc-base-radii, 0);
      background-color: var(--care-guide-card-background);
      color: var(--care-guide-card-text-color);
    }

    .section-{{ section.id }} .care-guide__card-header {
      display: flex;
      align-items: center;
      gap: var(--care-guide-item-icon-gap);
      padding: {{ card_header_padding_block }}px {{ card_header_padding_inline }}px;
      background-color: var(--care-guide-header-background);
      color: var(--care-guide-header-text-color);
    }

    .section-{{ section.id }} .care-guide__card-title {
      margin: 0;
      color: inherit;
      font-size: {{ card_title_size_mobile }}px;
      line-height: 1.15;
      letter-spacing: {{ options.card_title_letter_spacing }}px;
      {% if options.card_title_uppercase %}text-transform: uppercase;{% endif %}
    }

    .section-{{ section.id }} .care-guide__card-body {
      display: flex;
      flex-direction: column;
      gap: var(--care-guide-items-gap);
      padding: {{ card_body_padding_block }}px {{ card_body_padding_inline }}px;
    }

    .section-{{ section.id }} .care-guide__item {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .section-{{ section.id }} .care-guide__item-head {
      display: flex;
      align-items: center;
      gap: var(--care-guide-item-icon-gap);
    }

    .section-{{ section.id }} .care-guide__item-title {
      margin: 0;
      color: inherit;
      font-size: {{ item_title_size_mobile }}px;
      font-weight: {{ options.item_title_weight }};
      line-height: 1.3;
    }

    .section-{{ section.id }} .care-guide__item-text {
      margin: 0;
      margin-inline-start: var(--care-guide-item-text-indent);
      color: inherit;
      font-size: {{ item_text_size_mobile }}px;
      line-height: 1.45;
    }

    .section-{{ section.id }} .care-guide__item-text > * {
      margin: 0;
    }

    .section-{{ section.id }} .care-guide__icon {
      flex: 0 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .section-{{ section.id }} .care-guide__icon--header {
      width: var(--care-guide-header-icon-size);
      height: var(--care-guide-header-icon-size);
    }

    .section-{{ section.id }} .care-guide__icon--item {
      width: var(--care-guide-item-icon-size);
      height: var(--care-guide-item-icon-size);
    }

    .section-{{ section.id }} .care-guide__icon img,
    .section-{{ section.id }} .care-guide__icon svg {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    {%- comment -%}
      Icons drawn with currentColor render white; icons that carry their own
      fill (care-cross) are left alone.
    {%- endcomment -%}
    .section-{{ section.id }} .care-guide__icon--recolor svg {
      color: #FFFFFF;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }} .care-guide__card-title {
        font-size: {{ card_title_size_desktop }}px;
      }

      .section-{{ section.id }} .care-guide__item-title {
        font-size: {{ item_title_size_desktop }}px;
      }

      .section-{{ section.id }} .care-guide__item-text {
        font-size: {{ item_text_size_desktop }}px;
      }
    }

    {% for block in section.blocks %}
      .section-{{ section.id }} .block-{{ block.id }} {
        --care-guide-card-background: {{ block.settings.card_background }};
        --care-guide-card-text-color: {{ block.settings.card_text_color }};
        --care-guide-header-background: {{ block.settings.header_background }};
        --care-guide-header-text-color: {{ block.settings.header_text_color }};
        {% if block.settings.header_icon_size > 0 %}
          --care-guide-header-icon-size: {{ block.settings.header_icon_size }}px;
        {% endif %}
        {% if block.settings.item_icon_size > 0 %}
          --care-guide-item-icon-size: {{ block.settings.item_icon_size }}px;
        {% endif %}
        {% if block.settings.item_text_indent >= 0 %}
          --care-guide-item-text-indent: {{ block.settings.item_text_indent }}px;
        {% endif %}
      }
    {% endfor %}
  {% endstyle %}
{% endcapture %}

{% render 'inline-css-minifier', css: css %}

<div class='section-{{ section.id }} {% if round_level != 'default' %}round-level-{{ round_level }}{% endif %} section color-{{ color_scheme }} spacing-block {% if add_mobile_side_paddings %}spacing-inline-mobile{% endif %} {% if add_desktop_side_paddings %}spacing-inline-desktop{% endif %} {% if color_container_background == false %}section-background{% endif %}'>
  <div class='container container--{{ container_size }} {% if color_container_background %}container-background{% endif %}'>
    <div class='care-guide'>
      {%- if heading != blank or body != blank -%}
        <div class='care-guide__intro care-guide__intro--align-{{ content_alignment }}'>
          {%- if heading != blank -%}
            <h2
              class='{{ heading_size }} {% if enable_content_slide_in %}scroll-trigger animate--slide-in{% endif %}'
              style='--gsc-animation-order: 1;'
            >
              {{ heading }}
            </h2>
          {%- endif -%}

          {%- if body != blank -%}
            <div
              class='rte {{ body_size }} body-color body-font-weight-from-global-settings {% if enable_content_slide_in %}scroll-trigger animate--slide-in{% endif %}'
              style='--gsc-animation-order: 2;'
            >
              {{ body }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class='care-guide__cards'>
        {%- for block in section.blocks -%}
          <div
            class='care-guide__card block-{{ block.id }} {% if enable_content_slide_in %}scroll-trigger animate--slide-in{% endif %}'
            style='--gsc-animation-order: {{ forloop.index | plus: 2 }};'
            {{ block.shopify_attributes }}
          >
            {%- liquid
              assign card_title = block.settings.title
              assign card_title_alt = card_title | strip_html | escape
              assign show_header = block.settings.show_header
            -%}

            {%- if show_header and card_title != blank or show_header and block.settings.header_icon_image != blank or show_header and block.settings.header_icon != 'none' -%}
              <div class='care-guide__card-header'>
                {%- if block.settings.header_icon_image != blank -%}
                  <span class='care-guide__icon care-guide__icon--header'>
                    {{
                      block.settings.header_icon_image
                      | image_url: width: 200
                      | image_tag: loading: 'lazy', widths: '48, 96, 144, 200', alt: card_title_alt
                    }}
                  </span>
                {%- elsif block.settings.header_icon != 'none' -%}
                  <span class='care-guide__icon care-guide__icon--header{% unless block.settings.header_icon == 'care-cross' %} care-guide__icon--recolor{% endunless %}'>
                    {% render 'icon', icon_name: block.settings.header_icon %}
                  </span>
                {%- endif -%}

                {%- if card_title != blank -%}
                  <h3 class='care-guide__card-title {{ block.settings.title_size }}'>{{ card_title }}</h3>
                {%- endif -%}
              </div>
            {%- endif -%}

            <div class='care-guide__card-body'>
              {%- for i in (1..6) -%}
                {%- liquid
                  assign title_key = 'item_' | append: i | append: '_title'
                  assign text_key = 'item_' | append: i | append: '_text'
                  assign item_title = block.settings[title_key]
                  assign item_text = block.settings[text_key]
                -%}

                {%- if item_title != blank or item_text != blank -%}
                  <div class='care-guide__item'>
                    {%- if item_title != blank -%}
                      <div class='care-guide__item-head'>
                        {%- if block.settings.item_icon != 'none' -%}
                          <span class='care-guide__icon care-guide__icon--item{% unless block.settings.item_icon == 'care-cross' %} care-guide__icon--recolor{% endunless %}'>
                            {% render 'icon', icon_name: block.settings.item_icon %}
                          </span>
                        {%- endif -%}

                        <div
                          class='care-guide__item-title {{ block.settings.item_title_size }}'
                          role='heading'
                          aria-level='4'
                        >
                          {{ item_title }}
                        </div>
                      </div>
                    {%- endif -%}

                    {%- if item_text != blank -%}
                      <div class='care-guide__item-text rte body-font-weight-from-global-settings'>
                        {{ item_text }}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
